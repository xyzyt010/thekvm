// TheKVM Android controller — adaptive, single-window Slint UI.
//
// Layout rules:
//  - the Window has NO fixed size; the Android backend sizes it to the
//    native display, so it fits any phone, tablet or foldable;
//  - every dimension scales from `root.scale`, derived from the window
//    width, so text and touch targets stay readable on small and large screens;
//  - system bars / cutouts are respected through safe-area-insets;
//  - pages that can overflow are Flickables;
//  - the software keyboard is accounted for with virtual-keyboard-size.
// No std-widgets: everything is hand-drawn for a minimal, cohesive look.

struct DeviceItem {
    name: string,
    address: string,
    fingerprint: string,
    known: bool,
    connected: bool,
}

struct KnownItem {
    name: string,
    fingerprint: string,
    connected: bool,
}

/// One machine in the multi-node grid. col/row = -1 means not placed yet.
struct GridNode {
    name: string,
    fingerprint: string,
    col: int,
    row: int,
}

/// Single source of truth for both themes. Dark is the default and uses a
/// soft #121212 grey rather than pure black; light is white with black
/// text and blue highlights. Every colour in the app resolves through here.
export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #121212 : #ffffff;
    out property <color> surface: dark ? #1e1e1e : #f3f5f9;
    out property <color> surface-2: dark ? #262626 : #e8edf5;
    out property <color> surface-3: dark ? #141414 : #ffffff;
    out property <color> border: dark ? #333333 : #d3dae5;
    out property <color> border-strong: dark ? #3a3a3a : #b9c4d4;
    out property <color> text: dark ? #f3f4f6 : #121212;
    out property <color> text-2: dark ? #e5e7eb : #1f2937;
    out property <color> muted: dark ? #8b949e : #5b6675;
    out property <color> faint: dark ? #7c8698 : #6b7685;
    out property <color> hint: dark ? #474747 : #c2cbd8;

    out property <color> accent: dark ? #34d399 : #2563eb;
    out property <color> accent-strong: dark ? #22c55e : #1d4ed8;
    out property <color> accent-bg: dark ? #14291d : #e8f0ff;
    out property <color> accent-panel: dark ? #14532d : #dbeafe;
    out property <color> accent-border: dark ? #1f5136 : #93b4f7;
    out property <color> accent-text: dark ? #dcfce7 : #1e3a8a;
    out property <color> danger-bg: dark ? #3a1d1d : #fee2e2;
    out property <color> danger-text: dark ? #fca5a5 : #b91c1c;

    out property <color> screen: dark ? #1e40af : #3b82f6;
    out property <color> screen-glow: dark ? #172554 : #dbeafe;
    out property <color> bezel: dark ? #0f0f0f : #cbd5e1;
}

// Chevron that turns a smooth 180 degrees. Path coordinates are recomputed
// from an animated angle: Slint's software renderer ignores transform-rotation.
component Chevron inherits Rectangle {
    in property <float> scale: 1;
    in property <bool> open: false;
    in property <color> glyph-color: Theme.faint;
    in property <length> size: 14px;
    width: root.size;
    height: root.size;
    in-out property <angle> sweep: root.open ? 180deg : 0deg;
    animate sweep { duration: 180ms; easing: ease-in-out; }
    property <float> co: cos(root.sweep);
    property <float> si: sin(root.sweep);
    property <float> ax: 6 - 3.5 * root.co + 1.5 * root.si;
    property <float> ay: 6 - 3.5 * root.si - 1.5 * root.co;
    property <float> bx: 6 - 2 * root.si;
    property <float> by: 6 + 2 * root.co;
    property <float> cx: 6 + 3.5 * root.co + 1.5 * root.si;
    property <float> cy: 6 + 3.5 * root.si - 1.5 * root.co;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 12; viewbox-height: 12;
        stroke: root.glyph-color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M " + (round(root.ax * 100) / 100) + " " + (round(root.ay * 100) / 100)
            + " L " + (round(root.bx * 100) / 100) + " " + (round(root.by * 100) / 100)
            + " L " + (round(root.cx * 100) / 100) + " " + (round(root.cy * 100) / 100);
    }
}

component PillButton inherits Rectangle {
    in property <float> scale: 1;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    height: 44px * root.scale;
    border-radius: 10px * root.scale;
    background: !root.enabled ? Theme.surface-3 : (root.primary ? Theme.accent-panel : (area.has-hover ? Theme.surface-2 : Theme.surface));
    border-width: 1px;
    border-color: root.primary ? Theme.accent-strong : Theme.border;
    opacity: root.enabled ? 1 : 0.5;
    area := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    callback clicked();
    Text {
        text: root.label;
        color: root.primary ? Theme.accent-text : Theme.text-2;
        font-size: 14px * root.scale;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component DeviceDropdown inherits Rectangle {
    in property <float> scale: 1;
    in property <[DeviceItem]> devices: [];
    in-out property <int> selected: -1;
    width: 100%;
    height: 56px * root.scale;
    border-radius: 11px * root.scale;
    background: popup.is-open ? Theme.surface-2 : Theme.surface;
    border-width: 1px;
    border-color: Theme.border-strong;
    TouchArea {
        clicked => { if (popup.is-open) { popup.close(); } else { popup.show(); } }
    }
    Text {
        x: 14px * root.scale;
        width: parent.width - 52px * root.scale;
        text: root.selected >= 0 && root.selected < root.devices.length
            ? root.devices[root.selected].name : "Choose a computer…";
        color: Theme.text;
        font-size: 14px * root.scale;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 14px * root.scale;
        y: 32px * root.scale;
        width: parent.width - 52px * root.scale;
        text: root.selected >= 0 && root.selected < root.devices.length
            ? root.devices[root.selected].address : "Nearby Windows / Linux computers";
        color: Theme.faint;
        font-size: 10px * root.scale;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - 30px * root.scale;
        y: (parent.height - 14px * root.scale) / 2;
        width: 14px * root.scale;
        height: 14px * root.scale;
        Chevron { scale: root.scale; open: popup.is-open; glyph-color: Theme.faint; size: 14px * root.scale; }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        height: min(360px * root.scale, 54px * root.scale + root.devices.length * 52px * root.scale);
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%; height: 100%;
            background: Theme.surface;
            border-radius: 11px * root.scale;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            VerticalLayout {
                padding: 5px * root.scale;
                spacing: 2px;
                alignment: start;
                if root.devices.length == 0 : Text {
                    text: "Scanning…";
                    color: Theme.faint;
                    font-size: 14px * root.scale;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                for device[i] in root.devices : Rectangle {
                    height: 52px * root.scale;
                    border-radius: 8px * root.scale;
                    background: row.has-hover ? Theme.surface-2 : (i == root.selected ? Theme.accent-bg : transparent);
                    row := TouchArea {
                        clicked => { root.selected = i; popup.close(); }
                    }
                    Text {
                        x: 12px * root.scale; y: 6px * root.scale;
                        width: parent.width - 24px * root.scale;
                        text: (device.connected ? "● " : "") + device.name;
                        color: device.connected ? Theme.accent : Theme.text-2;
                        font-size: 13px * root.scale;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        x: 12px * root.scale; y: 27px * root.scale;
                        width: parent.width - 24px * root.scale;
                        text: device.address + (device.known ? "   · remembered" : "");
                        color: device.known ? Theme.accent : Theme.faint;
                        font-size: 10px * root.scale;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

export component App inherits Window {
    title: "TheKVM";
    background: Theme.bg;
    default-font-family: "Roboto, Noto Sans, Sans-Serif";

    // Fill the screen; scale everything from its width. 400 logical px is the
    // reference phone; clamped so tiny and very large screens stay sensible.
    out property <float> scale: min(max(root.width / 400px, 0.8), 1.7);

    in property <string> phase: "devices"; // devices | control | settings
    in property <[DeviceItem]> devices: [];
    in-out property <int> selected: -1;
    in property <string> status: "Scanning…";
    in property <string> connected-name: "";
    in property <string> touch-debug: "";
    // True while the active session is down and auto-reconnecting: the
    // trackpad stays on screen (never yanked to Devices) and shows it.
    in property <bool> reconnecting: false;
    in property <[KnownItem]> remembered: [];
    in property <bool> paste-mode: false;
    in-out property <bool> horizontal-mode: false;
    in-out property <string> draft: "";
    in-out property <length> text-offset: 0px;

    // Multi-node configuration (5x3 grid, up to 15 machines).
    in-out property <bool> multi-node: false;
    in-out property <string> mesh-mode: "bidirectional";
    in-out property <[GridNode]> grid-nodes: [];
    in-out property <bool> grid-open: false;
    in-out property <bool> mesh-applying: false;
    in-out property <bool> dark-mode: true;

    callback toggle-theme();
    callback toggle-multi-node();
    callback set-mesh-mode(string);
    callback open-mesh-grid();
    callback close-mesh-grid();
    callback grid-device-tap(string);
    callback grid-cell-down(int, int);
    callback grid-cell-move(int, int);
    callback grid-cell-up(int, int);
    callback apply-mesh();
    callback remove-grid-node(string);

    callback connect-selected();
    callback disconnect();
    callback switch-device(string);
    callback stop-device(string);
    callback open-devices();
    callback open-settings();
    callback back();
    callback forget(string);
    callback toggle-paste();
    callback send-text(string);
    // kind: 0=down 1=up 2=move 3=cancel; x/y are trackpad-local; id=finger
    callback trackpad-event(int, length, length, int);
    callback toggle-horizontal();
    // Two-finger gesture: centre movement = scroll, scale = pinch zoom.
    callback gesture-start(length, length);
    callback gesture-update(length, length, float);
    callback gesture-end();

    // Approximate wrapped line count so the bar grows 1 → 5 lines.
    property <int> chars-per-line: max(1, floor((root.width - 48px * root.scale) / (8.2px * root.scale)));
    out property <int> bar-lines: max(1, min(5, floor(root.draft.character-count / root.chars-per-line) + 1));

    // ---------- Devices (first page) ----------
    if root.phase == "devices" : Flickable {
        viewport-height: max(root.height, (root.multi-node ? 610px : 400px) * root.scale + root.devices.length * 46px * root.scale);
        VerticalLayout {
            width: root.width;
            padding-left: 18px * root.scale + root.safe-area-insets.left;
            padding-right: 18px * root.scale + root.safe-area-insets.right;
            padding-top: 18px * root.scale + root.safe-area-insets.top;
            padding-bottom: 18px * root.scale + root.safe-area-insets.bottom;
            spacing: 10px * root.scale;

            Text {
                text: "TheKVM";
                color: Theme.text;
                font-size: 27px * root.scale;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Control a Windows or Linux computer from your phone";
                color: Theme.muted;
                font-size: 11px * root.scale;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle { height: 6px * root.scale; }
            DeviceDropdown { scale: root.scale; devices <=> root.devices; selected <=> root.selected; }
            Text {
                text: root.status;
                color: Theme.faint;
                font-size: 11px * root.scale;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // Connected machines: compact cards instead of large boxes.
            if root.connected-name != "" : Rectangle {
                height: 22px * root.scale;
                Text {
                    text: "Live";
                    color: Theme.accent;
                    font-size: 10px * root.scale;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            for device in root.devices : Rectangle {
                if device.connected : Rectangle {
                    height: 46px * root.scale;
                    border-radius: 10px * root.scale;
                    background: Theme.accent-bg;
                    border-width: 1px;
                    border-color: Theme.accent-border;
                    Rectangle {
                        x: 11px * root.scale;
                        y: (parent.height - 8px * root.scale) / 2;
                        width: 8px * root.scale;
                        height: 8px * root.scale;
                        border-radius: 4px * root.scale;
                        background: Theme.accent;
                    }
                    Text {
                        x: 26px * root.scale;
                        width: parent.width - 150px * root.scale;
                        text: device.name;
                        color: Theme.text-2;
                        font-size: 13px * root.scale;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        x: parent.width - 168px * root.scale;
                        y: 7px * root.scale;
                        width: 84px * root.scale;
                        height: 32px * root.scale;
                        border-radius: 8px * root.scale;
                        background: Theme.accent-panel;
                        TouchArea { clicked => { root.switch-device(device.fingerprint); } }
                        Text {
                            text: "Control";
                            color: Theme.accent-text;
                            font-size: 11px * root.scale;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        x: parent.width - 80px * root.scale;
                        y: 7px * root.scale;
                        width: 72px * root.scale;
                        height: 32px * root.scale;
                        border-radius: 8px * root.scale;
                        background: Theme.danger-bg;
                        TouchArea { clicked => { root.stop-device(device.fingerprint); } }
                        Text {
                            text: "Disconnect";
                            color: Theme.danger-text;
                            font-size: 11px * root.scale;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Multi-node grid configuration. The two-device UI above stays
            // untouched; this section only appears when the user opts in.
            Rectangle {
                height: 48px * root.scale;
                border-radius: 10px * root.scale;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    x: 12px * root.scale;
                    y: 5px * root.scale;
                    text: "Multi-node grid";
                    color: Theme.text-2;
                    font-size: 13px * root.scale;
                    font-weight: 600;
                }
                Text {
                    x: 12px * root.scale;
                    y: 25px * root.scale;
                    text: root.multi-node ? "Up to 15 computers · arrange on a 5 × 3 grid"
                        : "Two-device mode";
                    color: Theme.faint;
                    font-size: 10px * root.scale;
                }
                Rectangle {
                    x: parent.width - 56px * root.scale;
                    y: 9px * root.scale;
                    width: 44px * root.scale;
                    height: 25px * root.scale;
                    border-radius: 13px * root.scale;
                    background: root.multi-node ? Theme.accent-strong : Theme.border-strong;
                    TouchArea { clicked => { root.toggle-multi-node(); } }
                    Rectangle {
                        x: root.multi-node ? 23px * root.scale : 3px * root.scale;
                        y: 3px * root.scale;
                        width: 19px * root.scale;
                        height: 19px * root.scale;
                        border-radius: 10px * root.scale;
                        background: #ffffff;
                        animate x { duration: 150ms; easing: ease-in-out; }
                    }
                }
            }
            if root.multi-node : Rectangle {
                height: 34px * root.scale;
                Rectangle {
                    width: parent.width / 3;
                    height: 28px * root.scale;
                    border-radius: 8px * root.scale;
                    background: root.mesh-mode == "bidirectional" ? Theme.accent-panel : Theme.surface-2;
                    TouchArea { clicked => { root.set-mesh-mode("bidirectional"); } }
                    Text { text: "Both ways"; color: root.mesh-mode == "bidirectional" ? Theme.accent-text : Theme.muted; font-size: 11px * root.scale; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    x: parent.width / 3;
                    width: parent.width / 3;
                    height: 28px * root.scale;
                    border-radius: 8px * root.scale;
                    background: root.mesh-mode == "server_client" ? Theme.accent-panel : Theme.surface-2;
                    TouchArea { clicked => { root.set-mesh-mode("server_client"); } }
                    Text { text: "One server"; color: root.mesh-mode == "server_client" ? Theme.accent-text : Theme.muted; font-size: 11px * root.scale; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    x: parent.width * 2 / 3;
                    width: parent.width / 3;
                    height: 28px * root.scale;
                    border-radius: 8px * root.scale;
                    background: root.mesh-mode == "client_only" ? Theme.accent-panel : Theme.surface-2;
                    TouchArea { clicked => { root.set-mesh-mode("client_only"); } }
                    Text { text: "Clients"; color: root.mesh-mode == "client_only" ? Theme.accent-text : Theme.muted; font-size: 11px * root.scale; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            if root.multi-node : PillButton {
                scale: root.scale;
                label: "Configure grid";
                enabled: !root.mesh-applying;
                clicked => { root.open-mesh-grid(); }
            }

            Rectangle { vertical-stretch: 1; }
            PillButton {
                scale: root.scale;
                label: "Connect";
                primary: true;
                enabled: root.selected >= 0;
                clicked => { root.connect-selected(); }
            }
            PillButton {
                scale: root.scale;
                label: "Settings";
                clicked => { root.open-settings(); }
            }
        }
    }

    // ---------- Multi-node grid popup ----------
    in-out property <string> drag-fingerprint: "";
    in-out property <bool> drag-active: false;
    in-out property <string> pending-device: "";
    in-out property <int> hover-col: -1;
    in-out property <int> hover-row: -1;
    in-out property <length> grid-width: min(root.width - 34px * root.scale, 480px * root.scale);
    in-out property <length> cell-w: root.grid-width / 5;
    in-out property <length> cell-h: root.cell-w * 0.72;
    in-out property <angle> spin: 0deg;

    if root.grid-open : Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        Timer {
            interval: 90ms;
            running: root.mesh-applying;
            triggered => {
                root.spin += 30deg;
                if (root.spin >= 360deg) { root.spin -= 360deg; }
            }
        }
        Rectangle {
            width: 100%; height: 100%;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding-left: 14px * root.scale + root.safe-area-insets.left;
                padding-right: 14px * root.scale + root.safe-area-insets.right;
                padding-top: 14px * root.scale + root.safe-area-insets.top;
                padding-bottom: 14px * root.scale + root.safe-area-insets.bottom;
                spacing: 10px * root.scale;

                Rectangle {
                    height: 32px * root.scale;
                    Text {
                        text: "Arrange computers";
                        color: Theme.text;
                        font-size: 18px * root.scale;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: parent.width - 74px * root.scale;
                        y: 2px * root.scale;
                        width: 30px * root.scale;
                        height: 28px * root.scale;
                        border-radius: 8px * root.scale;
                        background: Theme.surface-2;
                        TouchArea { clicked => { root.close-mesh-grid(); } }
                        Text { text: "×"; color: Theme.text-2; font-size: 20px * root.scale; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.mesh-applying : Rectangle {
                        x: parent.width - 110px * root.scale;
                        y: 7px * root.scale;
                        width: 18px * root.scale;
                        height: 18px * root.scale;
                        for i in 3 : Rectangle {
                            x: 9px * root.scale + 6px * root.scale * cos(root.spin + i * 120deg);
                            y: 9px * root.scale + 6px * root.scale * sin(root.spin + i * 120deg);
                            width: 4px * root.scale; height: 4px * root.scale;
                            border-radius: 2px * root.scale;
                            background: Theme.accent-strong;
                            opacity: 0.4 + 0.6 * abs(cos(root.spin + i * 120deg));
                        }
                    }
                }
                Text {
                    text: "Drag a screen into a cell · rightmost wraps to the left · nearby cells cross into each other";
                    color: Theme.faint;
                    font-size: 10px * root.scale;
                    wrap: word-wrap;
                }

                // The 5x3 grid with visible grid lines.
                Rectangle {
                    width: root.grid-width;
                    height: root.cell-h * 3;
                    background: Theme.surface-3;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 10px * root.scale;
                    clip: true;
                    for c in 5 : Rectangle {
                        x: c * root.cell-w;
                        y: 0;
                        width: 1px;
                        height: 100%;
                        background: Theme.border;
                    }
                    for r in 3 : Rectangle {
                        x: 0;
                        y: r * root.cell-h;
                        width: 100%;
                        height: 1px;
                        background: Theme.border;
                    }
                    // Wrap cue on the right edge.
                    Text {
                        x: parent.width - 18px * root.scale;
                        y: parent.height / 2 - 8px * root.scale;
                        text: "↺";
                        color: Theme.accent;
                        font-size: 14px * root.scale;
                    }
                    if root.drag-active && root.hover-col >= 0 : Rectangle {
                        x: root.hover-col * root.cell-w;
                        y: root.hover-row * root.cell-h;
                        width: root.cell-w;
                        height: root.cell-h;
                        background: Theme.accent-bg;
                        border-width: 2px;
                        border-color: Theme.accent-strong;
                    }
                    for node in root.grid-nodes : Rectangle {
                        if node.col >= 0 && node.row >= 0 && !(root.drag-active && node.fingerprint == root.drag-fingerprint) : Rectangle {
                            x: node.col * root.cell-w + 5px * root.scale;
                            y: node.row * root.cell-h + 5px * root.scale;
                            width: root.cell-w - 10px * root.scale;
                            height: root.cell-h - 10px * root.scale;
                            // Monitor: bezel, glowing screen, stand, name.
                            Rectangle {
                                width: 100%;
                                height: 72%;
                                border-radius: 4px * root.scale;
                                background: Theme.bezel;
                                Rectangle {
                                    x: 3px * root.scale; y: 3px * root.scale;
                                    width: parent.width - 6px * root.scale;
                                    height: parent.height - 6px * root.scale;
                                    border-radius: 2px * root.scale;
                                    background: Theme.screen;
                                    Text {
                                        text: "▰ ▰ ▱";
                                        color: Theme.screen-glow;
                                        font-size: 8px * root.scale;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                x: parent.width * 0.4; y: parent.height * 0.72;
                                width: parent.width * 0.2; height: parent.height * 0.1;
                                background: Theme.bezel;
                            }
                            Rectangle {
                                x: parent.width * 0.24; y: parent.height * 0.82;
                                width: parent.width * 0.52; height: parent.height * 0.04;
                                border-radius: 2px * root.scale;
                                background: Theme.bezel;
                            }
                            Text {
                                y: parent.height * 0.87;
                                width: 100%;
                                text: node.name;
                                color: Theme.text-2;
                                font-size: 9px * root.scale;
                                font-weight: 600;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    // One touch surface owns the whole grid so dragging is
                    // computed from cell coordinates, never from a child.
                    TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.grid-cell-down(floor(self.mouse-x / root.cell-w), floor(self.mouse-y / root.cell-h));
                            } else if (event.kind == PointerEventKind.move) {
                                root.grid-cell-move(clamp(floor(self.mouse-x / root.cell-w), 0, 4), clamp(floor(self.mouse-y / root.cell-h), 0, 2));
                            } else if (event.kind == PointerEventKind.up) {
                                root.grid-cell-up(clamp(floor(self.mouse-x / root.cell-w), 0, 4), clamp(floor(self.mouse-y / root.cell-h), 0, 2));
                            } else {
                                root.grid-cell-up(-1, -1);
                            }
                        }
                    }
                }

                Text {
                    text: root.pending-device != "" ? "Tap a cell to place the selected computer" : "Unplaced computers · tap to select";
                    color: Theme.faint;
                    font-size: 10px * root.scale;
                }
                Flickable {
                    height: 54px * root.scale;
                    viewport-width: max(root.grid-width, root.grid-nodes.length * 80px * root.scale);
                    HorizontalLayout {
                        spacing: 6px * root.scale;
                        for node in root.grid-nodes : Rectangle {
                            if node.col < 0 : Rectangle {
                                width: 76px * root.scale;
                                height: 34px * root.scale;
                                border-radius: 8px * root.scale;
                                background: root.pending-device == node.fingerprint ? Theme.accent-panel : Theme.surface-2;
                                border-width: 1px;
                                border-color: root.pending-device == node.fingerprint ? Theme.accent-strong : Theme.border;
                                TouchArea { clicked => { root.grid-device-tap(node.fingerprint); } }
                                Text { text: node.name; color: Theme.text-2; font-size: 10px * root.scale; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                            }
                        }
                        if root.drag-fingerprint != "" : Rectangle {
                            width: 68px * root.scale;
                            height: 34px * root.scale;
                            border-radius: 8px * root.scale;
                            background: Theme.danger-bg;
                            TouchArea { clicked => { root.remove-grid-node(root.drag-fingerprint); } }
                            Text { text: "Remove"; color: Theme.danger-text; font-size: 10px * root.scale; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
                PillButton {
                    scale: root.scale;
                    label: root.mesh-applying ? "Applying…" : "Apply to all computers";
                    primary: true;
                    enabled: !root.mesh-applying;
                    clicked => { root.apply-mesh(); }
                }
            }
        }
    }

    // ---------- Control (after connecting) ----------
    if root.phase == "control" : VerticalLayout {
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;

        Rectangle {
            height: 54px * root.scale;
            background: Theme.surface-3;
            HorizontalLayout {
                padding-left: 12px * root.scale;
                padding-right: 12px * root.scale;
                spacing: 6px * root.scale;
                Text {
                    text: "● " + root.connected-name;
                    color: root.reconnecting ? #f59e0b : Theme.accent;
                    font-size: 13px * root.scale;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                PillButton {
                    scale: root.scale;
                    label: root.horizontal-mode ? "↻ Side" : "↻ Flat";
                    width: 78px * root.scale;
                    height: 34px * root.scale;
                    clicked => { root.toggle-horizontal(); }
                }
                PillButton {
                    scale: root.scale;
                    label: "Devices";
                    width: 78px * root.scale;
                    height: 34px * root.scale;
                    clicked => { root.open-devices(); }
                }
                PillButton {
                    scale: root.scale;
                    label: "Disconnect";
                    width: 92px * root.scale;
                    height: 34px * root.scale;
                    clicked => { root.stop-device(""); }
                }
            }
        }

        if root.reconnecting : Rectangle {
            height: 30px * root.scale;
            background: #3b2f07;
            Text {
                text: root.status;
                color: #fbbf24;
                font-size: 12px * root.scale;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Trackpad: native touch events are translated to relative mouse
        // motion and clicks by Rust. Nothing is drawn here on purpose.
        Rectangle {
            vertical-stretch: 1;
            min-height: 60px;
            background: Theme.bg;
            Text {
                text: (root.horizontal-mode ? "TRACKPAD · SIDE\n\n" : "TRACKPAD\n\n")
                    + "Drag = move · Tap = click\nHold + drag = drag\nTwo-finger tap = right click\nTwo-finger drag = scroll · Pinch = zoom";
                color: Theme.border-strong;
                font-size: 12px * root.scale;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            // One finger: move / click / drag. Coordinates are local to the
            // trackpad, so bars above and below can never move the cursor.
            TouchArea {
                pointer-event(event) => {
                    root.trackpad-event(
                        event.kind == PointerEventKind.down ? 0 :
                        event.kind == PointerEventKind.up ? 1 :
                        event.kind == PointerEventKind.move ? 2 : 3,
                        self.mouse-x,
                        self.mouse-y,
                        event.touch-finger-id
                    );
                }
            }
            // Two fingers: Slint converts them to pinch/rotate events and
            // stops sending plain Move events, so track scroll and zoom here.
            gestures := ScaleRotateGestureHandler {
                started => { root.gesture-start(gestures.center.x, gestures.center.y); }
                updated => { root.gesture-update(gestures.center.x, gestures.center.y, gestures.scale); }
                ended => { root.gesture-end(); }
                cancelled => { root.gesture-end(); }
            }
        }

        // Bottom typing bar: grows 1 → 5 lines, then scrolls by touch.
        Rectangle {
            height: root.horizontal-mode ? 38px * root.scale
                : min(root.bar-lines, 5) * 24px * root.scale + 14px * root.scale;
            background: Theme.surface-3;
            border-width: 1px;
            border-color: Theme.border;
            Rectangle {
                x: 4px; y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                clip: true;
                TextInput {
                    y: -root.text-offset;
                    x: 8px * root.scale;
                    width: parent.width - 24px * root.scale;
                    height: root.horizontal-mode ? 30px * root.scale : 5 * 24px * root.scale;
                    text <=> root.draft;
                    color: Theme.text;
                    font-size: 15px * root.scale;
                    wrap: root.horizontal-mode ? no-wrap : word-wrap;
                    single-line: root.horizontal-mode;
                    accepted => { root.send-text(root.draft); root.draft = ""; }
                }
                scroll := TouchArea {
                    width: 14px * root.scale;
                    x: parent.width - 14px * root.scale;
                    moved => {
                        root.text-offset = max(0px, root.text-offset - (scroll.pressed-y - scroll.mouse-y));
                    }
                }
            }
        }

        Rectangle {
            height: 44px * root.scale;
            HorizontalLayout {
                padding-left: 12px * root.scale;
                padding-right: 12px * root.scale;
                padding-bottom: 6px * root.scale;
                spacing: 8px * root.scale;
                PillButton {
                    scale: root.scale;
                    label: root.paste-mode ? "Paste mode" : "Type mode";
                    horizontal-stretch: 1;
                    clicked => { root.toggle-paste(); }
                }
                PillButton {
                    scale: root.scale;
                    label: "Send text";
                    primary: true;
                    horizontal-stretch: 1;
                    enabled: root.draft != "";
                    clicked => { root.send-text(root.draft); root.draft = ""; }
                }
            }
        }
        // Keep the typing bar above the software keyboard.
        Rectangle { height: root.virtual-keyboard-size.height; }
    }

    // ---------- Settings ----------
    if root.phase == "settings" : Flickable {
        viewport-height: max(root.height, 340px * root.scale + root.remembered.length * 54px * root.scale);
        VerticalLayout {
            width: root.width;
            padding-left: 18px * root.scale + root.safe-area-insets.left;
            padding-right: 18px * root.scale + root.safe-area-insets.right;
            padding-top: 18px * root.scale + root.safe-area-insets.top;
            padding-bottom: 18px * root.scale + root.safe-area-insets.bottom;
            spacing: 12px * root.scale;

            Text {
                text: "Settings";
                color: Theme.text;
                font-size: 27px * root.scale;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Remembered computers · auto-connect is on";
                color: Theme.muted;
                font-size: 11px * root.scale;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle {
                height: 48px * root.scale;
                border-radius: 10px * root.scale;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    x: 12px * root.scale;
                    y: 5px * root.scale;
                    text: "Appearance";
                    color: Theme.text-2;
                    font-size: 13px * root.scale;
                    font-weight: 600;
                }
                Text {
                    x: 12px * root.scale;
                    y: 25px * root.scale;
                    text: root.dark-mode ? "Dark · #121212" : "Light · white / blue";
                    color: Theme.faint;
                    font-size: 10px * root.scale;
                }
                Rectangle {
                    x: parent.width - 56px * root.scale;
                    y: 9px * root.scale;
                    width: 44px * root.scale;
                    height: 25px * root.scale;
                    border-radius: 13px * root.scale;
                    background: root.dark-mode ? Theme.accent-strong : Theme.border-strong;
                    TouchArea { clicked => { root.toggle-theme(); } }
                    Rectangle {
                        x: root.dark-mode ? 23px * root.scale : 3px * root.scale;
                        y: 3px * root.scale;
                        width: 19px * root.scale;
                        height: 19px * root.scale;
                        border-radius: 10px * root.scale;
                        background: #ffffff;
                        animate x { duration: 150ms; easing: ease-in-out; }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 80px;
                border-radius: 10px * root.scale;
                background: Theme.surface-3;
                VerticalLayout {
                    padding: 8px * root.scale;
                    spacing: 4px * root.scale;
                    alignment: start;
                    if root.remembered.length == 0 : Text {
                        text: "No remembered computers yet.";
                        color: Theme.faint;
                        font-size: 14px * root.scale;
                        horizontal-alignment: center;
                    }
                    for item[i] in root.remembered : Rectangle {
                        height: 50px * root.scale;
                        border-radius: 8px * root.scale;
                        background: Theme.surface;
                        Text {
                            x: 10px * root.scale; y: 5px * root.scale;
                            width: parent.width - 92px * root.scale;
                            text: (item.connected ? "● " : "") + item.name;
                            color: Theme.text-2;
                            font-size: 13px * root.scale;
                            overflow: elide;
                        }
                        Text {
                            x: 10px * root.scale; y: 26px * root.scale;
                            width: parent.width - 92px * root.scale;
                            text: item.fingerprint;
                            color: Theme.faint;
                            font-size: 10px * root.scale;
                            overflow: elide;
                        }
                        Rectangle {
                            x: parent.width - 76px * root.scale;
                            y: 8px * root.scale;
                            width: 66px * root.scale;
                            height: 32px * root.scale;
                            border-radius: 8px * root.scale;
                            background: Theme.danger-bg;
                            TouchArea { clicked => { root.forget(item.fingerprint); } }
                            Text {
                                text: "Forget";
                                color: Theme.danger-text;
                                font-size: 11px * root.scale;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            PillButton {
                scale: root.scale;
                label: "Back";
                primary: true;
                clicked => { root.back(); }
            }
        }
    }
}
