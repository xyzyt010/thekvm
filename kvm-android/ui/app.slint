// TheKVM Android controller — minimal three-phase UI.
// Phase 1 Devices (pick + auto-connect), Phase 2 Control (trackpad + text),
// Phase 3 Settings (forget devices, text mode, about).
// Everything is hand-drawn: no std-widgets, one software-rendered window.

struct DeviceItem {
    name: string,
    address: string,
    fingerprint: string,
    known: bool,
}

struct KnownItem {
    name: string,
    fingerprint: string,
}

// Chevron that turns a smooth 180 degrees. Path coordinates are recomputed
// from an animated angle: the software renderer ignores transform-rotation.
component Chevron inherits Rectangle {
    in property <bool> open: false;
    in property <color> glyph-color: #9ca3af;
    width: 14px;
    height: 14px;
    in-out property <angle> sweep: root.open ? 180deg : 0deg;
    animate sweep { duration: 180ms; easing: ease-in-out; }
    property <float> co: cos(root.sweep);
    property <float> si: sin(root.sweep);
    // Down V (2.5,4.5) (6,8) (9.5,4.5) rotated about the centre (6,6).
    property <float> ax: 6 - 3.5 * root.co + 1.5 * root.si;
    property <float> ay: 6 - 3.5 * root.si - 1.5 * root.co;
    property <float> bx: 6 - 2 * root.si;
    property <float> by: 6 + 2 * root.co;
    property <float> cx: 6 + 3.5 * root.co + 1.5 * root.si;
    property <float> cy: 6 + 3.5 * root.si - 1.5 * root.co;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 12; viewbox-height: 12;
        stroke: root.glyph-color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M " + (round(root.ax * 100) / 100) + " " + (round(root.ay * 100) / 100)
            + " L " + (round(root.bx * 100) / 100) + " " + (round(root.by * 100) / 100)
            + " L " + (round(root.cx * 100) / 100) + " " + (round(root.cy * 100) / 100);
    }
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 44px;
    border-radius: 10px;
    background: !root.enabled ? #1a1a1a : (root.primary ? #14532d : (touch.has-hover ? #262626 : #1e1e1e));
    border-width: 1px;
    border-color: root.primary ? #22c55e : #2a2a2a;
    opacity: root.enabled ? 1 : 0.45;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    Text {
        text: root.label;
        color: root.primary ? #dcfce7 : #e5e7eb;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component DeviceDropdown inherits Rectangle {
    in property <[DeviceItem]> devices: [];
    in-out property <int> selected: -1;
    width: 100%;
    height: 56px;
    border-radius: 11px;
    background: popup.is-open ? #262626 : #1a1a1a;
    border-width: 1px;
    border-color: #3a3a3a;
    touch := TouchArea {
        clicked => { if (popup.is-open) { popup.close(); } else { popup.show(); } }
    }
    Text {
        x: 16px;
        width: parent.width - 60px;
        text: root.selected >= 0 && root.selected < root.devices.length ? root.devices[root.selected].name : "Choose a computer…";
        color: #f3f4f6;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 16px;
        y: 33px;
        width: parent.width - 60px;
        text: root.selected >= 0 && root.selected < root.devices.length ? root.devices[root.selected].address : "Nearby Windows / Linux computers";
        color: #7c8698;
        font-size: 10px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - 32px;
        y: (parent.height - 14px) / 2;
        width: 14px; height: 14px;
        Chevron { open: popup.is-open; glyph-color: #9ca3af; }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        height: min(390px, 60px + root.devices.length * 58px);
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%; height: 100%;
            background: #1c1c1c;
            border-radius: 11px;
            border-width: 1px;
            border-color: #333333;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                alignment: start;
                if root.devices.length == 0 : Text {
                    text: "Scanning…";
                    color: #7c8698;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                for device[i] in root.devices : Rectangle {
                    height: 56px;
                    border-radius: 8px;
                    background: row.has-hover ? #2a2a2a : (i == root.selected ? #14291d : transparent);
                    row := TouchArea {
                        clicked => { root.selected = i; popup.close(); }
                    }
                    Text {
                        x: 12px; y: 7px;
                        width: parent.width - 24px;
                        text: device.name;
                        color: #e5e7eb;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        x: 12px; y: 29px;
                        width: parent.width - 24px;
                        text: device.address + (device.known ? "   · remembered" : "");
                        color: device.known ? #34d399 : #7c8698;
                        font-size: 10px;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

export component App inherits Window {
    title: "TheKVM";
    width: 420px;
    height: 780px;
    background: #0a0a0a;
    default-font-family: "Roboto, Noto Sans, Sans-Serif";

    in property <string> phase: "devices"; // devices | control | settings
    in property <[DeviceItem]> devices: [];
    in-out property <int> selected: -1;
    in property <string> status: "Scanning…";
    in property <string> connected-name: "";
    in property <[KnownItem]> remembered: [];
    in property <bool> paste-mode: false;
    in-out property <string> draft: "";
    in property <int> bar-lines: 1;
    in-out property <length> text-offset: 0px;

    callback connect-selected();
    callback disconnect();
    callback open-settings();
    callback back();
    callback forget(string);
    callback toggle-paste();
    callback send-text(string);

    // ---------- Devices (first page) ----------
    if root.phase == "devices" : VerticalLayout {
        padding: 24px;
        spacing: 14px;
        Rectangle { height: 26px; }
        Text {
            text: "TheKVM";
            color: #f3f4f6;
            font-size: 30px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "Control a Windows or Linux computer from your phone";
            color: #8b949e;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { height: 8px; }
        DeviceDropdown { devices <=> root.devices; selected <=> root.selected; }
        // New computers need the 6-digit code shown on their Allow prompt.
        Rectangle {
            height: 46px;
            border-radius: 10px;
            background: #161616;
            border-width: 1px;
            border-color: #353535;
            TextInput {
                x: 12px; y: 11px;
                width: parent.width - 24px;
                text <=> root.draft;
                color: #f3f4f6;
                font-size: 15px;
                letter-spacing: 2px;
            }
        }
        Text {
            text: "For a new computer, type the 6-digit code shown on its screen";
            color: #6b7280;
            font-size: 10px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.status;
            color: #7c8698;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
        PillButton {
            label: "Connect";
            primary: true;
            enabled: root.selected >= 0;
            clicked => { root.connect-selected(); }
        }
        PillButton {
            label: "Settings";
            clicked => { root.open-settings(); }
        }
        Rectangle { height: 16px; }
    }

    // ---------- Control (after connecting) ----------
    if root.phase == "control" : VerticalLayout {
        Rectangle {
            height: 56px;
            background: #141414;
            HorizontalLayout {
                padding-left: 14px; padding-right: 14px;
                spacing: 8px;
                Text {
                    text: "● " + root.connected-name;
                    color: #34d399;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                PillButton {
                    width: 96px; height: 34px;
                    label: "Settings";
                    clicked => { root.open-settings(); }
                }
                PillButton {
                    width: 96px; height: 34px;
                    label: "Disconnect";
                    clicked => { root.disconnect(); }
                }
            }
        }
        // The trackpad. Slint draws nothing here; native touch events are
        // translated to relative mouse motion / clicks by the Rust backend.
        Rectangle {
            vertical-stretch: 1;
            background: #0a0a0a;
            Text {
                text: "Trackpad\n\nDrag to move · Tap to click\nTwo-finger tap = right click\nTwo-finger drag = scroll";
                color: #303030;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
        // Bottom typing bar: grows from one to five lines, then scrolls.
        Rectangle {
            height: min(root.bar-lines, 5) * 26px + 20px;
            background: #161616;
            border-width: 1px;
            border-color: #333333;
            Rectangle {
                x: 4px; y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                clip: true;
                input := TextInput {
                    y: -root.text-offset;
                    x: 8px;
                    width: parent.width - 16px;
                    height: max(root.bar-lines, 5) * 26px;
                    text <=> root.draft;
                    color: #f3f4f6;
                    font-size: 15px;
                    wrap: word-wrap;
                    accepted => { root.send-text(root.draft); root.draft = ""; }
                }
                scroll := TouchArea {
                    width: 30px;
                    x: parent.width - 30px;
                    moved => {
                        root.text-offset = max(0px, root.text-offset - (scroll.pressed-y - scroll.mouse-y));
                    }
                }
            }
        }
        Rectangle {
            height: 46px;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                spacing: 8px;
                PillButton {
                    label: root.paste-mode ? "Paste mode" : "Type mode";
                    width: 140px; height: 34px;
                    clicked => { root.toggle-paste(); }
                }
                PillButton {
                    label: "Send text";
                    primary: true;
                    width: 140px; height: 34px;
                    enabled: root.draft != "";
                    clicked => { root.send-text(root.draft); root.draft = ""; }
                }
            }
        }
        Rectangle { height: 12px; }
    }

    // ---------- Settings ----------
    if root.phase == "settings" : VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Rectangle { height: 20px; }
        Text {
            text: "Settings";
            color: #f3f4f6;
            font-size: 26px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "Remembered computers · auto-connect is on";
            color: #8b949e;
            font-size: 12px;
            horizontal-alignment: center;
        }
        Rectangle {
            vertical-stretch: 1;
            border-radius: 10px;
            background: #141414;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;
                if root.remembered.length == 0 : Text {
                    text: "No remembered computers yet.";
                    color: #7c8698;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                for item[i] in root.remembered : Rectangle {
                    height: 52px;
                    border-radius: 8px;
                    background: #1e1e1e;
                    Text {
                        x: 10px; y: 5px;
                        width: parent.width - 90px;
                        text: item.name;
                        color: #e5e7eb;
                        font-size: 14px;
                        overflow: elide;
                    }
                    Text {
                        x: 10px; y: 27px;
                        width: parent.width - 90px;
                        text: item.fingerprint;
                        color: #7c8698;
                        font-size: 10px;
                        overflow: elide;
                    }
                    Rectangle {
                        x: parent.width - 76px; y: 8px;
                        width: 68px; height: 34px;
                        border-radius: 8px;
                        background: #3a1d1d;
                        TouchArea { clicked => { root.forget(item.fingerprint); } }
                        Text {
                            text: "Forget";
                            color: #fca5a5;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        Rectangle { height: 24px; }
        PillButton {
            label: "Back";
            primary: true;
            clicked => { root.back(); }
        }
        Rectangle { height: 16px; }
    }
}
