import { CheckBox, LineEdit, Palette, TabWidget } from "std-widgets.slint";

// ---------------------------------------------------------------------
// One loading language: a full faint ring with a single bright comet arc
// sweeping around it. Driven by an internal timer so the sweep is a true
// continuous circular path (not stepped arc snaps), identical on Windows
// and Linux, sized/coloured per its context.
// ---------------------------------------------------------------------
component SpinnerArc inherits Rectangle {
    in property <length> diameter: 20px;
    in property <color> arc-color: #34d399;
    in property <color> track-color: #173a29;
    in property <int> tick: 0;
    width: diameter;
    height: diameter;
    background: transparent;
    // Full-circle faint track.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: track-color;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 12 2.5 A 9.5 9.5 0 1 1 12 21.5 A 9.5 9.5 0 1 1 12 2.5";
    }
    // Comet arc (~90° of the ring) circling the track. Its endpoint
    // coordinates are recomputed from the angle every tick: the software
    // renderer repaints when `commands` changes, but ignores
    // transform-rotation on a Path (the arc used to sit completely still).
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: arc-color;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M "
            + (round((12 + 9.5 * cos(root.angle)) * 100) / 100) + " "
            + (round((12 + 9.5 * sin(root.angle)) * 100) / 100)
            + " A 9.5 9.5 0 0 1 "
            + (round((12 + 9.5 * cos(root.angle + 90deg)) * 100) / 100) + " "
            + (round((12 + 9.5 * sin(root.angle + 90deg)) * 100) / 100);
    }
    // One revolution every ~1.9s (3° per 16ms — 2x the old pace). The
    // angle wraps at 360° so long uptimes cannot lose float precision
    // and stutter. DS-07: calm (reduced motion) renders a static ring.
    in-out property <angle> angle: 0deg;
    Timer {
        interval: 16ms;
        running: !Theme.reduced;
        triggered => {
            root.angle = (root.angle + 3deg >= 360deg) ? (root.angle + 3deg - 360deg) : (root.angle + 3deg);
        }
    }
}

// Drawn chevron (no font glyph): one V that turns a smooth 180° — pointing
// DOWN when closed, UP when open. The angle is animated and the three V
// points are recomputed from it every frame; `transform-rotation` cannot be
// used here because the software renderer does not repaint a rotated Path
// (the arrow stayed static, or snapped only when something else redrew).
component ChevronGlyph inherits Rectangle {
    in property <bool> open: false;
    in property <color> glyph-color: Theme.faint;
    width: 14px;
    height: 14px;
    background: transparent;
    in-out property <angle> sweep: root.open ? 180deg : 0deg;
    animate sweep { duration: 200ms; easing: ease-in-out; }
    // cos/sin of the animated angle, reused by all three rotated points.
    property <float> c: cos(root.sweep);
    property <float> s: sin(root.sweep);
    // Down V is (2.5,4.5) (6,8) (9.5,4.5), rotated about the glyph centre
    // (6,6). At sweep=180deg this is exactly the inverted V.
    property <float> ax: 6 - 3.5 * root.c + 1.5 * root.s;
    property <float> ay: 6 - 3.5 * root.s - 1.5 * root.c;
    property <float> bx: 6 - 2 * root.s;
    property <float> by: 6 + 2 * root.c;
    property <float> cx: 6 + 3.5 * root.c + 1.5 * root.s;
    property <float> cy: 6 + 3.5 * root.s - 1.5 * root.c;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: root.glyph-color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M " + (round(root.ax * 100) / 100) + " " + (round(root.ay * 100) / 100)
            + " L " + (round(root.bx * 100) / 100) + " " + (round(root.by * 100) / 100)
            + " L " + (round(root.cx * 100) / 100) + " " + (round(root.cy * 100) / 100);
    }
}

// Single source of truth for both themes (same palette as the Android
// controller). Dark is #121212 grey, NOT pure black; light is white with
// black text and blue accents. Every neutral colour resolves here; accent
// and monitor-graphic colours are fixed and intentionally not themed.
export global Theme {
    in-out property <bool> dark: true;
    // DS-07: reduced motion — spinners/radar hold still (spinner arcs
    // render at a fixed angle, radar stops sweeping). Set by Rust from
    // the OS "show animations" preference at startup.
    in-out property <bool> reduced: false;
    // ONE CANVAS: every surface is the same color. Structure comes
    // from hairline borders, never from filled panel boxes. `hover`
    // is the single slightly-raised tone for pressed/hovered chrome.
    out property <color> bg: dark ? #121212 : #ffffff;
    out property <color> surface: dark ? #121212 : #ffffff;
    out property <color> surface-2: dark ? #121212 : #ffffff;
    out property <color> surface-3: dark ? #121212 : #ffffff;
    out property <color> hover: dark ? #1e1e1e : #eef2f8;
    out property <color> border: dark ? #262626 : #d3dae5;
    out property <color> border-strong: dark ? #3a3a3a : #b9c4d4;
    out property <color> text: dark ? #f3f4f6 : #121212;
    out property <color> text-2: dark ? #e5e7eb : #1f2937;
    out property <color> muted: dark ? #8b949e : #5b6675;
    out property <color> faint: dark ? #9ca3af : #6b7685;
    out property <color> accent: dark ? #34d399 : #2563eb;
    out property <color> accent-strong: dark ? #22c55e : #1d4ed8;
    out property <color> accent-bg: dark ? #14231a : #e8f0ff;
    out property <color> accent-panel: dark ? #14532d : #dbeafe;
    out property <color> accent-border: dark ? #1f5136 : #93b4f7;
    out property <color> accent-text: dark ? #dcfce7 : #1e3a8a;
}

struct GridPeer {
    name: string,
    fingerprint: string,
    col: int,
    row: int,
}

struct TrustedPeer {
    name: string,
    address: string,
    fingerprint: string,
}

// Minimal modern line icons: plus (add), trash (delete), radar
// (discovery). All drawn, no font glyphs, no word-buttons.
// DS-04: one family, one stroke, 36x36 hit targets, glyph optically
// centred by bounding box.
component IconButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> glyph: "+";
    in property <color> glyph-color: Theme.text-2;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: hit.has-hover && enabled ? Theme.hover : transparent;
    border-width: 1px;
    border-color: hit.has-hover && enabled ? Theme.border : transparent;
    opacity: enabled ? 1 : 0.45;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    accessible-role: button;
    accessible-label: "Add a computer";
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    // Plus cross sized to read at the same weight as a 16px bold title:
    // 14px arms, optically centred in the 36px box (centre 18).
    if root.glyph == "+" : Rectangle {
        x: 11px;
        y: 17px;
        width: 14px;
        height: 2px;
        border-radius: 1px;
        background: root.glyph-color;
    }
    if root.glyph == "+" : Rectangle {
        x: 17px;
        y: 11px;
        width: 2px;
        height: 14px;
        border-radius: 1px;
        background: root.glyph-color;
    }
}

// Vertical 3-dot overflow glyph (SET-06): 18px in a 36px box, dots
// centred on the box centre, same family/weight as the trash.
component OverflowIcon inherits Rectangle {
    width: 18px;
    height: 18px;
    background: transparent;
    Rectangle { x: 7px; y: 2px; width: 4px; height: 4px; border-radius: 2px; background: Theme.text-2; }
    Rectangle { x: 7px; y: 7px; width: 4px; height: 4px; border-radius: 2px; background: Theme.text-2; }
    Rectangle { x: 7px; y: 12px; width: 4px; height: 4px; border-radius: 2px; background: Theme.text-2; }
}

// Delete: Google Fonts Material Symbols "delete" (24dp, outlined,
// wght 400), redrawn as a native Slint Path — the exact vector from
// delete_24dp_FILL0_wght400_GRAD0_opsz24, not an imported SVG, so it
// rasterises crisply at 22px on the software renderer. One filled
// path (lid bar, handle, tub outline, two ribs as cut-out subpaths);
// only the colour is ours (white, per product feedback). 22px in a
// 36px box, optically centred by bounding box.
component TrashIcon inherits Rectangle {
    width: 22px;
    height: 22px;
    background: transparent;
    Path {
        x: 0px;
        y: 0px;
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #f3f4f6;
        commands: "M7,21q-0.82,0-1.41-0.59T5,19V6H4V4H9V3h6V4h5V6H19V19q0,0.82-0.59,1.41T17,21H7ZM17,6H7V19H17V6ZM9,17h2V8H9v9Zm4,0h2V8H13v9ZM7,6V19V6Z";
    }
}

// Discovery radar: concentric green rings with one bright comet arc
// sweeping around. Unlike the status donut this is a screen, not a
// ring: three rings + center dot + rotating wedge, drawn fresh every
// tick (the software renderer ignores Path transforms).
component RadarIcon inherits Rectangle {
    in property <bool> sweeping: false;
    in property <int> tick: 0;
    width: 46px;
    height: 46px;
    background: transparent;
    in-out property <angle> angle: 0deg;
    Timer {
        // ~0.5 second per revolution (2x the previous sweep): a brisk
        // radar, matching a normal player's spinner pace. DS-07: stops
        // sweeping under reduced motion.
        interval: 20ms;
        running: root.sweeping && !Theme.reduced;
        triggered => {
            root.angle = (root.angle + 14deg >= 360deg) ? (root.angle + 14deg - 360deg) : (root.angle + 14deg);
        }
    }
    // Three rings, center dot, and the comet arm.
    Rectangle { x: 3px; y: 3px; width: 40px; height: 40px; border-radius: 20px; border-width: 1px; border-color: #22c55e55; }
    Rectangle { x: 10px; y: 10px; width: 26px; height: 26px; border-radius: 13px; border-width: 1px; border-color: #22c55e66; }
    Rectangle { x: 18px; y: 18px; width: 10px; height: 10px; border-radius: 5px; background: #22c55e; }
    if root.sweeping : Path {
        x: 3px;
        y: 3px;
        width: 40px;
        height: 40px;
        viewbox-width: 40;
        viewbox-height: 40;
        stroke: #22c55e;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M "
            + (round((20 + 19 * cos(root.angle)) * 100) / 100) + " "
            + (round((20 + 19*sin(root.angle)) * 100) / 100)
            + " A 19 19 0 0 1 "
            + (round((20 + 19 * cos(root.angle + 70deg)) * 100) / 100) + " "
            + (round((20 + 19 * sin(root.angle + 70deg)) * 100) / 100);
    }
}

// Smooth custom toggle: pill + knob, no stair-step aliasing from the
// std-widgets Switch on the software renderer. Same two-way contract:
// `checked <=> root.<prop>`, plus `toggled` on user interaction.
// Anti-aliasing: the pill has NO border at all — a 1px border under a
// 13px radius is what stair-stepped on the software renderer. The
// knob is a pure circle (diameter = radius x 2) with exact integer
// pixel travel: 3px insets on both ends, 48x28 pill, 22px knob, so
// no sub-pixel offset ever misaligns the round in the pill.
component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled();
    width: 48px;
    height: 28px;
    border-radius: 14px;
    background: !enabled ? Theme.surface-2 : (checked ? Theme.accent-strong : Theme.border-strong);
    opacity: enabled ? 1 : 0.55;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.checked = !root.checked; root.toggled(); } }
    }
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; root.toggled(); } }
    Rectangle {
        x: root.checked ? 23px : 3px;
        y: 3px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: #ffffff;
    }
}

// Tab page scroller, hand-rolled instead of std ScrollView: the std
// one's Flickable is non-interactive with a 2px scrollbar sliver, and
// its viewport size is left for the child to imply — in the TabWidget
// that chain measured short, so Devices/Settings simply never
// scrolled. Here the Flickable's viewport-height is bound explicitly
// to the content child's own height, the wheel is native Flickable
// input, and the scrollbar is a real 8px track with a draggable thumb
// that is always visible whenever content overflows. Content drag-pan
// stays OFF (interactive: false) so monitor-card drags in Devices are
// never stolen; wheel + thumb are the scroll inputs.
component PageScroll inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-width: 100%;
    preferred-height: 100%;
    min-width: 50px;
    min-height: 50px;
    property <length> max-scroll: max(0px, flick.viewport-height - flick.height);
    flick := Flickable {
        width: parent.width;
        height: parent.height;
        interactive: false;
        viewport-width: self.width;
        viewport-height: content-box.height;
        content-box := Rectangle {
            width: flick.width;
            height: page.preferred-height;
            page := VerticalLayout {
                width: parent.width;
                @children
            }
        }
    }
    if root.max-scroll > 0px : track := Rectangle {
        x: parent.width - 10px;
        y: 2px;
        width: 8px;
        height: parent.height - 4px;
        border-radius: 4px;
        background: Theme.dark ? #ffffff14 : #00000014;
        thumb := Rectangle {
            x: 1px;
            width: 6px;
            height: max(28px, track.height * flick.height / max(1px, flick.viewport-height));
            y: (track.height - self.height) * (-flick.viewport-y / root.max-scroll);
            border-radius: 3px;
            background: drag.has-hover || drag.pressed ? Theme.faint : Theme.border-strong;
            drag := TouchArea {
                property <length> press-abs-y: 0px;
                property <length> press-view-y: 0px;
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        self.press-abs-y = self.absolute-position.y + self.mouse-y;
                        self.press-view-y = flick.viewport-y;
                    }
                }
                moved => {
                    if (self.pressed && track.height > thumb.height) {
                        let dy = (self.absolute-position.y + self.mouse-y) - self.press-abs-y;
                        flick.viewport-y = max(-root.max-scroll, min(0px, self.press-view-y - dy * root.max-scroll / (track.height - thumb.height)));
                    }
                }
            }
        }
    }
}

// The ONE button in the app: same height, radius, border and type
// scale as every dropdown, so nothing reads as foreign chrome.
// Primary = the action (Connect/Allow/Apply); silent = secondary.
// Width hugs its label (min-width forces a wider floor when needed).
component KvmButton inherits Rectangle {
    in property <string> text: "";
    // DS-10: accessible-label override when the visible text alone is
    // ambiguous to assistive tech (e.g. "Details for X, row 2 of 5").
    // Empty = announce the visible text.
    in property <string> aria-label: "";
    // DS-06: shown on hover; used to explain a disabled control.
    in property <string> tooltip: "";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    // Wider floor for side-by-side pairs (Allow/Deny): same idea as
    // the old std Button min-width, under a name Slint allows.
    in property <length> btn-width: 0px;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    background: !enabled ? Theme.bg
        : hit.pressed ? Theme.border-strong
        : danger ? #dc2626
        : primary ? Theme.accent-strong
        : hit.has-hover ? Theme.hover : Theme.bg;
    // DS-06 focus-visible: a visible outline ring while a keyboard user
    // has this button focused (FocusScope turns on tab navigation).
    border-width: 1px;
    border-color: scope.has-focus ? #60a5fa
        : !enabled ? Theme.border
        : danger ? #dc2626
        : primary ? Theme.accent-strong : Theme.border;
    // Width hugs the label, floored at btn-width when set.
    width: max(root.btn-width, label.preferred-width + 28px);
    opacity: enabled ? 1 : 0.55;
    // SET-10: forward focus to the internal FocusScope so dialog code
    // can move keyboard focus programmatically (trap + initial Cancel
    // focus), and expose that focus state to the parent so the trap can
    // decide where Tab goes next.
    forward-focus: scope;
    out property <bool> has-focus: scope.has-focus;
    scope := FocusScope {
        focus_on_tab_navigation: true;
        key_pressed(event) => {
            // Enter (U+000D) and Space (U+0020); the KeyEvent 'text' is
            // the normalized input in Slint 1.8.
            if event.text == "\n" || event.text == " " {
                if (root.enabled) { root.clicked(); }
                accept
            } else {
                reject
            }
        }
        key_released(event) => { reject }
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    if root.tooltip != "" : Tooltip {
        Rectangle {
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                Text {
                    text: root.tooltip;
                    color: Theme.text;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }
    accessible-role: button;
    accessible-label: root.aria-label == "" ? root.text : root.aria-label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    label := Text {
        width: parent.width;
        text: root.text;
        color: (root.primary || root.danger) && root.enabled ? #ffffff : Theme.text;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// SET-06 overflow menu row: one keyboard-navigable action shared by all
// five menu items. Tab reaches it; Enter/Space acts; Escape closes the
// menu (via escape-closed). Same 36px anatomy as the KvmButton family.
component RowMenuAction inherits Rectangle {
    in property <string> label: "";
    in property <color> fg: #ffffff;
    callback acted();
    callback escape-closed();
    height: 36px;
    border-radius: 8px;
    background: hit.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: label;
    item-focus := FocusScope {
        focus_on_tab_navigation: true;
        key_pressed(event) => {
            if (event.text == "\n" || event.text == " ") {
                root.acted();
                accept
            } else if (event.text == "\u{1b}") {
                root.escape-closed();
                accept
            } else {
                reject
            }
        }
        key_released(event) => { reject }
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.acted(); }
    }
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: label;
        color: root.fg;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Cohesive device dropdown: same pill + popup language as RoleDropdown, so
// every dropdown in the app opens identically. Replaces the foreign-looking
// std-widgets ComboBox.
component DeviceDropdown inherits Rectangle {
    in property <[string]> labels: [];
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    height: 36px;
    border-radius: 9px;
    background: hit.has-hover || popup.is-open ? Theme.hover : Theme.bg;
    border-width: 1px;
    border-color: popup.is-open ? Theme.border-strong : (hit.has-hover ? Theme.border-strong : Theme.border);
    opacity: enabled ? 1 : 0.5;

    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (!root.enabled) { return; }
            if (popup.is-open) { popup.close(); } else { popup.show(); }
        }
    }
    accessible-role: combobox;
    accessible-expanded: popup.is-open;
    accessible-action-expand => { popup.show(); }
    Text {
        x: 12px;
        width: parent.width - 40px;
        text: root.labels.length > 0 && root.current-index >= 0 && root.current-index < root.labels.length
            ? root.labels[root.current-index] : "No nearby computers";
        color: root.labels.length > 0 ? Theme.text : Theme.faint;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - 26px;
        y: (parent.height - 13px) / 2;
        width: 13px;
        height: 13px;
        ChevronGlyph { width: 100%; height: 100%; open: popup.is-open; glyph-color: Theme.faint; }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        height: min(280px, 44px + root.labels.length * 38px);
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.surface;
            border-radius: 11px;
            border-width: 1px;
            border-color: Theme.border;

            clip: true;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                alignment: start;
                if root.labels.length == 0 : Text {
                    text: "No nearby computers — press Scan";
                    color: Theme.faint;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                for label[i] in root.labels : Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: row-hit.has-hover || i == root.current-index ? Theme.hover : transparent;
                    row-hit := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.current-index = i; popup.close(); }
                    }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: label;
                        color: Theme.text-2;
                        font-size: 14px;
                        font-weight: i == root.current-index ? 700 : 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// Close (hide the card): a real cross, no button chrome.
// DS-04: 32px hit target, glyph optically centred.
component CloseButton inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: hit.has-hover && enabled ? Theme.border : transparent;
    opacity: enabled ? 1 : 0.45;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    accessible-role: button;
    accessible-label: "Hide nearby devices";
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Path {
        x: 10px;
        y: 10px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: hit.has-hover && enabled ? #e5e7eb : Theme.faint;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        commands: "M 1 1 L 11 11 M 11 1 L 1 11";
    }
}

// Rescan: the refresh arrow, replaced by the shared donut while a scan
// runs, so the button itself shows the work in progress.
// DS-04: 32px hit target, glyph optically centred.
component RescanButton inherits Rectangle {
    in property <bool> scanning: false;
    in property <bool> enabled: true;
    in property <int> tick: 0;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: hit.has-hover && enabled && !scanning ? Theme.border : transparent;
    opacity: enabled ? 1 : 0.45;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled && !root.scanning) { root.clicked(); } }
    }
    accessible-role: button;
    accessible-label: scanning ? "Scanning for nearby devices" : "Rescan for nearby devices";
    accessible-action-default => { if (root.enabled && !root.scanning) { root.clicked(); } }
    if !scanning : Path {
        // Standard refresh shape: a circular arrow with a solid head.
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: hit.has-hover && enabled ? #e5e7eb : Theme.faint;
        commands: "M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-8 8s3.57 8 8 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z";
    }
    if scanning : SpinnerArc {
        x: 4px;
        y: 4px;
        diameter: 18px;
        tick: root.tick;
    }
}

// ---------------------------------------------------------------------
// The arrangement is drawn as actual monitors: bezel, screen, neck and
// base. Exit edges light green on this computer; entry edges light teal
// on the linked one, so the crossing discipline is visible on the same
// picture the user assembles.
// ---------------------------------------------------------------------
component MonitorCard inherits Rectangle {
    in property <string> title: "THIS PC";
    in property <string> name: "";
    in property <bool> local: false;
    in property <bool> exit-left: false;
    in property <bool> exit-right: false;
    in property <bool> enter-left: false;
    in property <bool> enter-right: false;
    in property <bool> hovered: false;
    in property <bool> dragging: false;
    in property <bool> dimmed: false;
    // Steps fully aside while its dragged copy is on screen.
    in property <bool> hidden: false;
    // True while the linked computer is live right now; the mesh passes the
    // link state down. False dims the card, border and power LED.
    in property <bool> powered: true;
    // Briefly true on a handoff: the lit edge bars flash brighter.
    in property <bool> crossing-pulse: false;
    // Fixed size: a min-width alone lets a layout inflate the card past its
    // drawn frame, which pushed the stand off-centre.
    width: 160px;
    height: 118px;
    background: transparent;
    opacity: root.hidden ? 0 : (dimmed ? 0.55 : 1);
    body := Rectangle {
        y: 2px;
        // Explicit width, not 100%: a percentage here makes the card's own
        // preferred width circular and the layout inflates it.
        width: 160px;
        height: 98px;
        background: #17171a;
        border-radius: 9px;
        border-width: 1.5px;
        border-color: root.local ? (root.hovered || root.dragging ? #4ade80 : (root.powered ? #22c55e : #57534e)) : (root.hovered || root.dragging ? #a8a29e : (root.powered ? #5eead4 : Theme.border-strong));

        Rectangle {
            x: 7px;
            y: 7px;
            // Every size inside the card is explicit: a percentage here
            // (parent.width ...) makes the card's own preferred width
            // circular, and the layout then inflates the card far past its
            // drawn frame.
            width: 146px;
            height: 80px;
            background: root.local
                ? @linear-gradient(180deg, #0e2a1c 0%, #08150e 100%)
                : @linear-gradient(180deg, #141414 0%, #0a0a0a 100%);
            border-radius: 4px;
            // Exit bars (this computer) and entry bars (linked computer).
            // Bar centre is the screen centre (y 14 + 52/2 = 40 in screen
            // space): the crossing arrows land exactly on it.
            if root.exit-left : Rectangle { x: 0; y: 14px; width: 3px; height: 52px; border-radius: 2px; background: root.crossing-pulse ? #86efac : #22c55e; }
            if root.exit-right : Rectangle { x: 143px; y: 14px; width: 3px; height: 52px; border-radius: 2px; background: root.crossing-pulse ? #86efac : #22c55e; }
            if root.enter-left : Rectangle { x: 0; y: 14px; width: 3px; height: 52px; border-radius: 2px; background: root.crossing-pulse ? #99f6e4 : #5eead4; }
            if root.enter-right : Rectangle { x: 143px; y: 14px; width: 3px; height: 52px; border-radius: 2px; background: root.crossing-pulse ? #99f6e4 : #5eead4; }
            // Tiny direction chevrons beside the lit edges.
            if root.exit-left : Path { x: 7px; y: 35px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; stroke: #22c55e; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round; fill: transparent; commands: "M 8 2 L 3 5 L 8 8"; }
            if root.exit-right : Path { x: 129px; y: 35px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; stroke: #22c55e; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round; fill: transparent; commands: "M 2 2 L 7 5 L 2 8"; }
            if root.enter-left : Path { x: 7px; y: 35px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; stroke: #5eead4; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round; fill: transparent; commands: "M 3 2 L 8 5 L 3 8"; }
            if root.enter-right : Path { x: 129px; y: 35px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; stroke: #5eead4; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round; fill: transparent; commands: "M 8 2 L 3 5 L 8 8"; }
            Text {
                x: 10px;
                y: 6px;
                width: 126px;
                text: root.title;
                color: root.local ? #6ee7b7 : #78716c;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 1.2px;
                horizontal-alignment: center;
            }
            // Name sits above the arrow lane (centre y=40): both labels
            // stacked at mid-screen crossed the crossing arrows through
            // the text.
            Text {
                x: 10px;
                y: 18px;
                width: 126px;
                text: root.name == "" ? "…" : root.name;
                color: white;
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        // Power LED.
        Rectangle {
            x: 78px;
            y: parent.height - 6px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: root.powered ? (root.local ? #22c55e : #2dd4bf) : #44403c;
        }
    }
    // Stand neck and base. The card is a fixed 160px wide, so the stand is
    // centred on that constant: deriving it from parent.width would make
    // the card's width depend on the stand's position - a circular
    // reference Slint cannot solve, which collapsed the card entirely.
    Rectangle { x: 72px; y: 100px; width: 16px; height: 9px; background: #26262a; }
    Rectangle { x: 56px; y: 109px; width: 48px; height: 4px; border-radius: 2px; background: #26262a; }
}

// One tap swaps the two screens. The press gets a short green flash and
// nothing stays highlighted afterwards: the monitor positions themselves
// already show the current arrangement, and a sticky highlight reads as a
// toggle that never clears.
component ChevronButton inherits Rectangle {
    in property <bool> points-left: true;
    in property <bool> flash: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: root.flash ? Theme.accent-panel : (hit.has-hover && enabled ? Theme.border : transparent);
    border-width: 1px;
    border-color: root.flash ? #22c55e : Theme.border;
    opacity: enabled ? 1 : 0.4;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    accessible-role: button;
    accessible-label: points-left ? "Move the linked computer to the left" : "Move the linked computer to the right";
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Path {
        x: 10px;
        y: 10px;
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: root.flash ? #22c55e : (hit.has-hover && enabled ? #e5e7eb : Theme.faint);
        stroke-width: 2.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: points-left ? "M 11 3 L 5.5 9 L 11 15" : "M 7 3 L 12.5 9 L 7 15";
    }
}

// The mesh: this computer and the linked computer as two monitors, with
// the exit/entry edges lit. The linked monitor is draggable: it follows
// the pointer, a magnetic target lights up on the side it would land,
// and releasing it there swaps the placement. Double-clicking either
// monitor swaps too. Chevrons remain for a single precise tap.
component ArrangementMesh inherits Rectangle {
    in property <string> local-name: "";
    in property <string> peer-name: "";
    in property <bool> peer-on-right: true;
    in property <bool> enabled: false;
    in property <int> edge-mode: 0;
    // Live link state and a brief pulse on each handoff, passed through to
    // the cards and arrows.
    in property <bool> link-live: false;
    in property <bool> crossing-pulse: false;
    // Roles of this computer and the linked computer: they decide where the
    // arrow heads sit, exactly as in the crossing-edge illustrations.
    in property <int> our-mode: 0;
    in property <int> peer-mode: 0;
    callback to-left();
    callback to-right();

    height: 166px;
    background: Theme.surface-3;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;

    property <length> margin: 52px;
    property <length> card-w: 160px;
    property <length> card-y: 32px;
    property <length> card-h: 118px;

    // Every internal position is derived from the mesh's OWN rendered width
    // (parent.width from a child's point of view, self.width from here).
    // root.width is the declared width; the panel can render narrower than
    // declared when the tab column is tight, and cards placed from the
    // declared width then land outside the visible panel.
    property <length> inner-w: self.width;

    property <length> local-x: root.peer-on-right ? root.margin : root.inner-w - root.margin - root.card-w;
    property <length> peer-x: root.peer-on-right ? root.inner-w - root.margin - root.card-w : root.margin;
    property <length> slot-distance: root.inner-w - 2 * root.margin - root.card-w;
    property <length> drag-limit: root.slot-distance + 24px;
    property <length> drag-start-abs: 0px;
    in-out property <bool> dragging: false;
    in-out property <bool> dragging-local: false;
    in-out property <length> drag-dx: 0px;
    // A drop on the other side holds its dragged position until the
    // placement is confirmed upstream, then snaps magnetically into the
    // new slot - no rubber-band back to the old one first.
    in-out property <bool> flip-pending: false;
    in-out property <bool> flip-right: false;
    // Which chevron is flashing (0 = left, 1 = right, -1 = none). A press
    // lights the arrow for a moment and then clears: no sticky highlight
    // is left behind on the last pressed arrow.
    in-out property <int> flash-side: -1;
    function press_side(side: int) {
        root.flash-side = side;
        if (side == 1) { root.to-right(); } else { root.to-left(); }
    }
    Timer {
        interval: 450ms;
        running: root.flash-side >= 0;
        triggered => { root.flash-side = -1; }
    }
    changed peer-on-right => {
        if (root.flip-pending && root.peer-on-right == root.flip-right) {
            root.flip-pending = false;
            root.drag-dx = 0px;
        }
    }
    property <bool> will-land-right: root.peer-x + root.drag-dx + root.card-w / 2 > root.inner-w / 2;
    Timer {
        interval: 1500ms;
        running: root.flip-pending;
        triggered => {
            // The placement never landed: return the screen to truth.
            if (root.peer-on-right != root.flip-right) {
                root.flip-pending = false;
                root.drag-dx = 0px;
            }
        }
    }

    // Exit edges are this computer's way OUT and entry edges are the linked
    // computer's way IN: hidden under the role that forbids that direction.
    // ("Client" never leaves this machine; "Server" never lets the other
    // one in.)
    property <bool> exit-left: root.our-mode != 2 && (root.edge-mode != 0 || !root.peer-on-right);
    property <bool> exit-right: root.our-mode != 2 && (root.edge-mode != 0 || root.peer-on-right);
    property <bool> enter-left: root.our-mode != 1 && (root.edge-mode == 1 || (root.edge-mode == 0 && root.peer-on-right));
    property <bool> enter-right: root.our-mode != 1 && (root.edge-mode == 1 || (root.edge-mode == 0 && !root.peer-on-right));

    // ---- Roles, carried by the arrow heads -------------------------
    property <bool> we-may-drive: root.our-mode == 0 || root.our-mode == 1;
    property <bool> we-may-be-driven: root.our-mode == 0 || root.our-mode == 2;
    property <bool> peer-may-drive: root.peer-mode == 0 || root.peer-mode == 1;
    property <bool> peer-may-be-driven: root.peer-mode == 0 || root.peer-mode == 2;
    // A sharp head sits on the machine being DRIVEN and the blunt side on
    // the machine doing the driving: both ways gets a head on both ends.
    property <bool> head-at-peer: root.we-may-drive && root.peer-may-be-driven;
    property <bool> head-at-our: root.peer-may-drive && root.we-may-be-driven;

    // ---- Where the two cards actually are right now ----------------
    // The grabbed monitor follows the pointer exactly (no lag, no haze:
    // it is lifted out of its slot). The OTHER monitor previews the
    // swap: once the grabbed card's centre crosses the middle, the
    // other card slides into the vacated slot, so the drop target is
    // already occupied-correct before the pointer is released. On
    // release the placement callback confirms and both cards settle
    // (magnetise) into their slots with the x animation.
    property <bool> peer-will-swap: root.dragging && !root.dragging-local && (root.will-land-right != root.peer-on-right);
    property <bool> local-will-swap: root.dragging && root.dragging-local && ((root.local-x + root.drag-dx + root.card-w / 2 > root.inner-w / 2) == root.peer-on-right);
    property <length> local-render-x: (root.dragging && root.dragging-local)
        ? root.local-x + root.drag-dx
        : (root.peer-will-swap ? root.peer-x : root.local-x);
    property <length> peer-render-x: ((root.dragging && !root.dragging-local) || root.flip-pending)
        ? root.peer-x + root.drag-dx
        : (root.local-will-swap ? root.local-x : root.peer-x);
    property <length> our-cur-x: root.local-render-x;
    property <length> peer-cur-x: root.peer-render-x;
    property <length> our-l: root.our-cur-x;
    property <length> our-r: root.our-cur-x + root.card-w;
    property <length> peer-l: root.peer-cur-x;
    property <length> peer-r: root.peer-cur-x + root.card-w;
    // Bar centres inside a monitor card (the source of every colored bar):
    // the lit bars sit 7px inside the card (left edge of the screen area)
    // or 7px+143px+3px/2 (right edge). Every arrow endpoint lands on the
    // exact bar it connects, so an arrow never overshoots the frame it
    // joins (an earlier version ran card-edge to card-edge and stuck out
    // past both monitors' bezels).
    property <length> our-bar-l: root.our-cur-x + 8.5px;
    property <length> our-bar-r: root.our-cur-x + 151.5px;
    property <length> peer-bar-l: root.peer-cur-x + 8.5px;
    property <length> peer-bar-r: root.peer-cur-x + 151.5px;


    // Chevron row: a plain Rectangle does not stretch its children, so the
    // row is given the mesh's own width explicitly rather than a stretch
    // factor (which had no effect here and dropped the right chevron off).
    HorizontalLayout {
        x: 0;
        y: root.card-y;
        width: root.inner-w;
        height: root.card-h;
        spacing: 6px;
        ChevronButton {
            width: 38px;
            height: 38px;
            vertical-stretch: 0;
            points-left: true;
            flash: root.flash-side == 0;
            enabled: root.enabled;
            clicked => { root.press_side(0); }
        }
        Rectangle { horizontal-stretch: 1; }
        ChevronButton {
            width: 38px;
            height: 38px;
            vertical-stretch: 0;
            points-left: false;
            flash: root.flash-side == 1;
            enabled: root.enabled;
            clicked => { root.press_side(1); }
        }
    }

    // Vacated-slot ghost while a card is lifted: the slot the grabbed
    // monitor came from stays drawn as an empty outline, so the pair
    // never looks like one monitor vanished into haze.
    if root.dragging : Rectangle {
        x: root.dragging-local ? root.local-x : root.peer-x;
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: Theme.border-strong;
        background: transparent;
    }
    // The two monitors, placed from the mesh's rendered width and animated:
    // the grabbed card tracks the pointer with zero animation lag; the
    // other card (and a confirmed drop) slides with the animation.
    local := MonitorCard {
        x: root.local-render-x;
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        title: "THIS PC";
        name: root.local-name;
        local: true;
        exit-left: root.enabled && root.exit-left;
        exit-right: root.enabled && root.exit-right;
        hovered: local-drag-area.has-hover;
        dragging: root.dragging && root.dragging-local;
        powered: root.link-live;
        crossing-pulse: root.crossing-pulse;
        animate x { duration: (root.dragging && root.dragging-local) ? 0ms : 200ms; easing: ease-in-out; }
    }
    peer := MonitorCard {
        x: root.peer-render-x;
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        title: "LINKED";
        name: root.enabled ? (root.peer-name == "" ? "Linked PC" : root.peer-name) : "Not linked";
        local: false;
        enter-left: root.enabled && root.enter-left;
        enter-right: root.enabled && root.enter-right;
        hovered: drag-area.has-hover;
        dragging: root.dragging && !root.dragging-local;
        dimmed: !root.enabled;
        powered: root.link-live;
        crossing-pulse: root.crossing-pulse;
        animate x { duration: (root.dragging && !root.dragging-local) ? 0ms : 200ms; easing: ease-in-out; }
    }
    // ---- The crossing arrows ---------------------------------------
    // Both arrows are dead straight and parallel to each other. The short
    // one joins the two edges that FACE each other (this computer's right
    // edge to the linked computer's left edge); the long one joins this
    // computer's LEFT edge to the linked computer's RIGHT edge, so it runs
    // the full span of the pair underneath both screens. Two connected
    // edges, two arrows, and the second is visibly the longer route.
    property <length> our-facing-x: root.peer-on-right ? root.our-bar-r : root.our-bar-l;
    property <length> our-far-x: root.peer-on-right ? root.our-bar-l : root.our-bar-r;
    property <length> peer-facing-x: root.peer-on-right ? root.peer-bar-l : root.peer-bar-r;
    // The peer edge the second arrow lands on: Mirror takes the far edge.
    property <length> entry-x: root.peer-on-right ? root.peer-bar-r : root.peer-bar-l;
    property <float> near-x1: root.our-facing-x / 1px;
    property <float> near-x2: root.peer-facing-x / 1px;
    property <float> far-x1: root.our-far-x / 1px;
    property <float> far-x2: root.entry-x / 1px;
    // Arrows are perfectly centred on the screens: the screen area's
    // vertical middle is card-y + 9 (bezel) + 40 (half the 80px
    // screen) = card-y + 49, which is also the lit bars' centre. The
    // double disciplines straddle it symmetrically (±11); Single runs
    // dead through it.
    property <int> center-y: root.card-y / 1px + 49;
    property <int> y-near: root.edge-mode == 0 ? root.center-y : root.center-y - 11;
    property <int> y-far: root.center-y + 11;
    property <bool> near-right: root.near-x1 < root.near-x2;
    property <bool> far-right: root.far-x1 < root.far-x2;

    property <string> near-line: "M \{root.near-x1} \{root.y-near} L \{root.near-x2} \{root.y-near}";
    // Head on THIS computer's end of the short arrow.
    property <string> near-our-head: root.near-right
        ? "M \{root.near-x1 + 5} \{root.y-near - 2.5} L \{root.near-x1} \{root.y-near} L \{root.near-x1 + 5} \{root.y-near + 2.5}"
        : "M \{root.near-x1 - 5} \{root.y-near - 2.5} L \{root.near-x1} \{root.y-near} L \{root.near-x1 - 5} \{root.y-near + 2.5}";
    // Head on the linked computer's end of the short arrow.
    property <string> near-peer-head: root.near-right
        ? "M \{root.near-x2 - 5} \{root.y-near - 2.5} L \{root.near-x2} \{root.y-near} L \{root.near-x2 - 5} \{root.y-near + 2.5}"
        : "M \{root.near-x2 + 5} \{root.y-near - 2.5} L \{root.near-x2} \{root.y-near} L \{root.near-x2 + 5} \{root.y-near + 2.5}";

    property <string> far-line: "M \{root.far-x1} \{root.y-far} L \{root.far-x2} \{root.y-far}";
    // Head on THIS computer's left-edge end of the long arrow.
    property <string> far-our-head: root.far-right
        ? "M \{root.far-x1 + 5} \{root.y-far - 2.5} L \{root.far-x1} \{root.y-far} L \{root.far-x1 + 5} \{root.y-far + 2.5}"
        : "M \{root.far-x1 - 5} \{root.y-far - 2.5} L \{root.far-x1} \{root.y-far} L \{root.far-x1 - 5} \{root.y-far + 2.5}";
    // Head on the linked computer's end of the long arrow.
    property <string> far-peer-head: root.far-right
        ? "M \{root.far-x2 - 5} \{root.y-far - 2.5} L \{root.far-x2} \{root.y-far} L \{root.far-x2 - 5} \{root.y-far + 2.5}"
        : "M \{root.far-x2 + 5} \{root.y-far - 2.5} L \{root.far-x2} \{root.y-far} L \{root.far-x2 + 5} \{root.y-far + 2.5}";

    // The short arrow: the facing-edge crossing. Hidden until a peer is
    // linked, exactly like the lit edges themselves.
    if root.enabled : Path {
        x: 0;
        y: 0;
        width: root.inner-w;
        height: 166px;
        viewbox-width: max(1, root.inner-w / 1px);
        viewbox-height: 166;
        stroke: root.crossing-pulse ? #a7f3d0 : #22c55e;
        stroke-width: root.crossing-pulse ? 3px : 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.near-line
            + (root.head-at-peer ? root.near-peer-head : "")
            + (root.head-at-our ? root.near-our-head : "");
    }
    // The long arrow: the second crossing. Only a double discipline has
    // one, and it is visibly the longer route of the two.
    if root.enabled && root.edge-mode != 0 : Path {
        x: 0;
        y: 0;
        width: root.inner-w;
        height: 166px;
        viewbox-width: max(1, root.inner-w / 1px);
        viewbox-height: 166;
        stroke: root.crossing-pulse ? #99f6e4 : #5eead4;
        stroke-width: root.crossing-pulse ? 3px : 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.far-line
            + (root.head-at-peer ? root.far-peer-head : "")
            + (root.head-at-our ? root.far-our-head : "");
    }
    // The linked monitor is draggable: it follows the pointer and lands on
    // the side it is released on.
    drag-area := TouchArea {
        x: root.peer-render-x;
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? (root.dragging ? grabbing : grab) : default;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.flip-pending = false;
                root.dragging = true;
                root.dragging-local = false;
                root.drag-start-abs = self.absolute-position.x + self.mouse-x;
                root.drag-dx = 0px;
            } else if (event.kind == PointerEventKind.move && root.dragging && !root.dragging-local) {
                root.drag-dx = max(-root.drag-limit, min(root.drag-limit, (self.absolute-position.x + self.mouse-x) - root.drag-start-abs));
            } else if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && root.dragging && !root.dragging-local) {
                root.dragging = false;
                let want-right = root.will-land-right;
                if (want-right != root.peer-on-right) {
                    root.flip-pending = true;
                    root.flip-right = want-right;
                    if (want-right) {
                        root.to-right();
                    } else {
                        root.to-left();
                    }
                } else {
                    root.drag-dx = 0px;
                }
            }
        }
        double-clicked => {
            if (root.peer-on-right) { root.to-left(); } else { root.to_right(); }
        }
        animate x { duration: (root.dragging && !root.dragging-local) ? 0ms : 200ms; easing: ease-in-out; }
    }
    // The local monitor is draggable too: pushing THIS PC across the middle
    // is the same swap as pulling the linked PC the other way, so the
    // gesture feels symmetric on both halves of the pair.
    local-drag-area := TouchArea {
        x: root.local-render-x;
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? (root.dragging ? grabbing : grab) : default;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.flip-pending = false;
                root.dragging = true;
                root.drag-start-abs = self.absolute-position.x + self.mouse_x;
                root.drag-dx = 0px;
                root.dragging-local = true;
            } else if (event.kind == PointerEventKind.move && root.dragging && root.dragging-local) {
                root.drag-dx = max(-root.drag-limit, min(root.drag-limit, (self.absolute-position.x + self.mouse_x) - root.drag-start-abs));
            } else if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && root.dragging && root.dragging-local) {
                root.dragging = false;
                root.dragging-local = false;
                // Dragging the local card to the right puts the peer on the
                // left, and vice versa.
                let want-right = root.local-x + root.drag-dx + root.card-w / 2 > root.inner-w / 2;
                if (want-right != root.peer-on-right) {
                    root.flip-pending = true;
                    root.flip-right = want-right;
                    if (want-right) {
                        root.to_right();
                    } else {
                        root.to_left();
                    }
                } else {
                    root.drag-dx = 0px;
                }
            }
        }
        double-clicked => {
            if (root.peer-on-right) { root.to-left(); } else { root.to-right(); }
        }
        animate x { duration: (root.dragging && root.dragging-local) ? 0ms : 200ms; easing: ease-in-out; }
    }    // Magnetic landing slot while dragging.
    if root.dragging : Rectangle {
        x: root.will-land-right ? root.inner-w - root.margin - root.card-w : root.margin;
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: root.will-land-right == root.peer-on-right ? #22c55e33 : #22c55e;
        background: #22c55e10;
    }
}

// Schematic crossing diagram for one discipline: green bars are exit
// edges on this computer, teal bars are entry edges on the linked one.
component EdgeModeDiagram inherits Rectangle {
    in property <int> mode: 0;
    in property <int> our-mode: 0;
    in property <int> peer-mode: 0;
    width: 142px;
    height: 66px;
    background: transparent;

    // ---- What each COMPUTER allows ------------------------------
    property <bool> we-may-drive: root.our-mode == 0 || root.our-mode == 1;
    property <bool> we-may-be-driven: root.our-mode == 0 || root.our-mode == 2;
    property <bool> peer-may-drive: root.peer-mode == 0 || root.peer-mode == 1;
    property <bool> peer-may-be-driven: root.peer-mode == 0 || root.peer-mode == 2;
    property <bool> forward-ok: root.we-may-drive && root.peer-may-be-driven;
    property <bool> backward-ok: root.peer-may-drive && root.we-may-be-driven;
    // The sharp head sits on the machine being DRIVEN (the client); the
    // blunt side is the machine doing the driving (the server). "Both ways"
    // puts a head on both ends of every arrow.
    property <bool> head-at-peer: root.forward-ok;
    property <bool> head-at-our: root.backward-ok;

    // ---- Geometry ------------------------------------------------
    // The tiles draw the CURRENT arrangement (the linked computer on the
    // side the user arranged), not a baked-in mirrored scene: what must
    // match reality is where the pinned entry edge is, so each discipline
    // always visibly agrees with the arrangement shown above it.
    in property <bool> peer-on-right: true;
    property <length> mon-w: 36px;
    property <length> our-x: root.peer-on-right ? 6px : 96px;
    property <length> peer-x: root.peer-on-right ? 96px : 6px;
    property <length> our-l: root.our-x;
    property <length> our-r: root.our-x + root.mon-w;
    property <length> peer-l: root.peer-x;
    property <length> peer-r: root.peer-x + root.mon-w;

    // ---- The two monitors ----------------------------------------
    Rectangle { x: root.our-x; y: 6px; width: root.mon-w; height: 28px; background: #17171a; border-radius: 4px; border-width: 1px; border-color: #22c55e; }
    Rectangle { x: root.our-x + 3px; y: 9px; width: root.mon-w - 6px; height: 22px; background: #0b1f14; border-radius: 2px; }
    Rectangle { x: root.peer-x; y: 6px; width: root.mon-w; height: 28px; background: #17171a; border-radius: 4px; border-width: 1px; border-color: #57534e; }
    Rectangle { x: root.peer-x + 3px; y: 9px; width: root.mon-w - 6px; height: 22px; background: #101010; border-radius: 2px; }

    // ---- The connected edges, lit --------------------------------
    // Exits on THIS computer: the facing edge always, the far edge too in
    // every double discipline.
    Rectangle { x: root.peer-on-right ? root.our-r - 1.5px : root.our-l - 1.5px; y: 12px; width: 3px; height: 16px; border-radius: 1.5px; background: #22c55e; }
    if root.mode != 0 : Rectangle { x: root.peer-on-right ? root.our-l - 1.5px : root.our-r - 1.5px; y: 12px; width: 3px; height: 16px; border-radius: 1.5px; background: #22c55e; }
    // Entries on the linked computer, exactly per discipline:
    // Single: the facing edge. Mirror: both the facing and the far edge.
    if root.mode == 0 || root.mode == 1 : Rectangle { x: root.peer-on-right ? root.peer-l - 1.5px : root.peer-r - 1.5px; y: 12px; width: 3px; height: 16px; border-radius: 1.5px; background: #5eead4; }
    if root.mode == 1 : Rectangle { x: root.peer-on-right ? root.peer-r - 1.5px : root.peer-l - 1.5px; y: 12px; width: 3px; height: 16px; border-radius: 1.5px; background: #5eead4; }

    // ---- The crossing arrows -------------------------------------
    // Both arrows are dead straight and parallel.
    //
    // The SHORT one runs along the baseline of the screens and joins the two
    // edges that face each other: this computer's right edge to the linked
    // computer's left edge.
    //
    // The LONG one runs underneath both screens and joins this computer's
    // LEFT edge to the linked computer's RIGHT edge - the full span of the
    // pair, which is what makes it the longer of the two. Mirror's entry is
    // the inverse of the exit, so that is the edge it lands on.
    property <length> our-facing-x: root.peer-on-right ? root.our-r : root.our-l;
    property <length> our-far-x: root.peer-on-right ? root.our-l : root.our-r;
    property <length> peer-facing-x: root.peer-on-right ? root.peer-l : root.peer-r;
    property <length> entry-x: root.peer-on-right ? root.peer-r : root.peer-l;
    property <float> near-x1: root.our-facing-x / 1px;
    property <float> near-x2: root.peer-facing-x / 1px;
    property <float> far-x1: root.our-far-x / 1px;
    property <float> far-x2: root.entry-x / 1px;
    property <int> y-near: root.mode == 0 ? 20 : 14;
    property <int> y-far: 26;
    property <bool> near-right: root.near-x1 < root.near-x2;
    property <bool> far-right: root.far-x1 < root.far-x2;

    property <string> near-line: "M \{root.near-x1} \{root.y-near} L \{root.near-x2} \{root.y-near}";
    // Head on THIS computer's end of the short arrow.
    property <string> near-our-head: root.near-right
        ? "M \{root.near-x1 + 5} \{root.y-near - 2.5} L \{root.near-x1} \{root.y-near} L \{root.near-x1 + 5} \{root.y-near + 2.5}"
        : "M \{root.near-x1 - 5} \{root.y-near - 2.5} L \{root.near-x1} \{root.y-near} L \{root.near-x1 - 5} \{root.y-near + 2.5}";
    // Head on the linked computer's end of the short arrow.
    property <string> near-peer-head: root.near-right
        ? "M \{root.near-x2 - 5} \{root.y-near - 2.5} L \{root.near-x2} \{root.y-near} L \{root.near-x2 - 5} \{root.y-near + 2.5}"
        : "M \{root.near-x2 + 5} \{root.y-near - 2.5} L \{root.near-x2} \{root.y-near} L \{root.near-x2 + 5} \{root.y-near + 2.5}";

    property <string> far-line: "M \{root.far-x1} \{root.y-far} L \{root.far-x2} \{root.y-far}";
    // Head on THIS computer's left-edge end of the long arrow.
    property <string> far-our-head: root.far-right
        ? "M \{root.far-x1 + 5} \{root.y-far - 2.5} L \{root.far-x1} \{root.y-far} L \{root.far-x1 + 5} \{root.y-far + 2.5}"
        : "M \{root.far-x1 - 5} \{root.y-far - 2.5} L \{root.far-x1} \{root.y-far} L \{root.far-x1 - 5} \{root.y-far + 2.5}";
    // Head on the linked computer's end of the long arrow.
    property <string> far-peer-head: root.far-right
        ? "M \{root.far-x2 - 5} \{root.y-far - 2.5} L \{root.far-x2} \{root.y-far} L \{root.far-x2 - 5} \{root.y-far + 2.5}"
        : "M \{root.far-x2 + 5} \{root.y-far - 2.5} L \{root.far-x2} \{root.y-far} L \{root.far-x2 + 5} \{root.y-far + 2.5}";

    // The short arrow: the facing-edge crossing. Every discipline has one.
    Path {
        x: 0;
        y: 0;
        width: 142px;
        height: 66px;
        viewbox-width: 142;
        viewbox-height: 66;
        stroke: #22c55e;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.near-line
            + (root.head-at-peer ? root.near-peer-head : "")
            + (root.head-at-our ? root.near-our-head : "");
    }
    // The long arrow: the second crossing. Only a double discipline has
    // one, and it is visibly the longer route of the two.
    if root.mode != 0 : Path {
        x: 0;
        y: 0;
        width: 142px;
        height: 66px;
        viewbox-width: 142;
        viewbox-height: 66;
        stroke: #5eead4;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.far-line
            + (root.head-at-peer ? root.far-peer-head : "")
            + (root.head-at-our ? root.far-our-head : "");
    }
}
component EdgeModeTile inherits Rectangle {
    in property <int> mode: 0;
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> applying: false;
    in property <bool> enabled: true;
    in property <int> tick: 0;
    // Roles of this computer and the linked computer, plus the live
    // arrangement: together they decide how many crossing arrows the
    // illustration draws and where their heads sit.
    in property <int> our-mode: 0;
    in property <int> peer-mode: 0;
    in property <bool> arranged-peer-on-right: true;
    callback clicked();
    // Swap which side the linked computer sits on (keeps Single mode,
    // flips the arrangement) - edges adapt automatically.
    callback flip();
    // Slightly larger: the monitors inside are bigger, so the tile has to
    // be too or the diagram would be squeezed.
    width: 162px;
    height: 124px;
    border-radius: 10px;
    // The tile in force wears a green highlight box - the same accent the
    // live edges use - so the discipline actually applied to the link is
    // unmistakable at a glance.
    background: root.selected ? Theme.accent-bg : Theme.surface-2;
    border-width: root.selected ? 2px : 1.5px;
    border-color: root.selected ? #22c55e : (hit.has-hover && root.enabled ? Theme.faint : Theme.border);

    opacity: root.enabled ? 1 : 0.4;

    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled && !root.applying) { root.clicked(); } }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled && !root.applying) { root.clicked(); } }
    VerticalLayout {
        padding: 7px;
        spacing: 5px;
        alignment: center;
        EdgeModeDiagram {
            mode: root.mode;
            our-mode: root.our-mode;
            peer-mode: root.peer-mode;
            peer-on-right: root.arranged-peer-on-right;
        }
        // Single mode only: one more way to flip the arrangement (besides
        // drag and the chevrons). Minimal glyph, centred in the tile.
        if root.mode == 0 : Rectangle {
            height: 16px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 16px;
                    border-radius: 8px;
                    background: swap-hit.has-hover ? Theme.accent-panel : Theme.accent-bg;
                    border-width: 1px;
                    border-color: swap-hit.has-hover ? Theme.accent-border : Theme.accent-panel;
                    swap-hit := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Flip sides: move the linked computer to the other side";
                        accessible-action-default => { root.flip(); }
                        clicked => { root.flip(); }
                    }
                    Path {
                        x: 8px;
                        y: 4px;
                        width: 10px;
                        height: 8px;
                        viewbox-width: 10;
                        viewbox-height: 8;
                        stroke: swap-hit.has-hover ? #a7f3d0 : #86efac;
                        stroke-width: 1.4px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                        fill: transparent;
                        commands: "M 8.5 2 H 1.5 M 1.5 2 L 4 0.25 M 1.5 2 L 4 3.75 M 1.5 6 H 8.5 M 8.5 6 L 6 7.75 M 8.5 6 L 6 4.25";
                    }
                }
            }
        }
        Text {
            text: root.label;
            color: root.selected ? #e5e7eb : Theme.faint;
            font-size: 14px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }

    // Applying this discipline: the same donut as everywhere else.
    if root.applying : Rectangle {
        width: 100%;
        height: 100%;
        background: #0a0a0ad0;
        border-radius: 10px;
        SpinnerArc {
            x: (root.width - 26px) / 2;
            y: (root.height - 26px) / 2;
            diameter: 26px;
            tick: root.tick;
        }
    }
}

component EdgeModePicker inherits Rectangle {
    in property <int> selected: 1;
    in property <bool> applying: false;
    in property <int> pending-index: -1;
    in property <bool> enabled: false;
    in property <int> tick: 0;
    // Roles of this computer and the linked computer and the live
    // arrangement, passed down to the illustrations so each crossing
    // arrow set matches the pair.
    in property <int> our-mode: 0;
    in property <int> peer-mode: 0;
    in property <bool> arranged-peer-on-right: true;
    callback picked(int);
    callback flip();
    height: 124px;
    background: transparent;
    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        EdgeModeTile {
            mode: 0;
            label: "Single";
            selected: root.selected == 0;
            applying: root.applying && root.pending-index == 0;
            enabled: root.enabled;
            tick: root.tick;
            our-mode: root.our-mode;
            peer-mode: root.peer-mode;
            arranged-peer-on-right: root.arranged-peer-on-right;
            clicked => { root.picked(0); }
            flip => { root.flip(); }
        }
        EdgeModeTile {
            mode: 1;
            label: "Mirror";
            selected: root.selected == 1;
            applying: root.applying && root.pending-index == 1;
            enabled: root.enabled;
            tick: root.tick;
            our-mode: root.our-mode;
            peer-mode: root.peer-mode;
            arranged-peer-on-right: root.arranged-peer-on-right;
            clicked => { root.picked(1); }
        }

    }
}

// One role option inside the dropdown popup: icon, the option name and a
// one-line plain-English explanation of what it does. Every element is
// vertically centred on the row; the row itself centres its children.
component RoleRow inherits Rectangle {
    in property <string> label: "";
    in property <string> caption: "";
    in property <int> icon: 0;
    in property <bool> selected: false;
    callback picked();
    height: 42px;
    background: hit.has-hover || root.selected ? Theme.hover : transparent;
    border-radius: 8px;

    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    HorizontalLayout {
        // Tight pockets and gaps so a row still has room for the 15px role
        // name inside a popup that is exactly as wide as the 140px pill.
        padding-left: 5px;
        padding-right: 5px;
        spacing: 4px;
        alignment: center;
        // Icon slot: a full-height centering cell. `alignment: center` on
        // the HorizontalLayout only centres along its main (horizontal)
        // axis, so a fixed-height icon otherwise sits at the top of the
        // 42px row. This wrapper owns the row height and centres the 26px
        // glyph box vertically on both axes.
        VerticalLayout {
            width: 22px;
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 6px;
                background: root.selected ? Theme.hover : Theme.hover;
                // Both ways: paired arrows. Server: arrow up/out (you drive).
                // Client: arrow down/in (the peer drives you).
                if root.icon == 0 : Path {
                    x: 2px; y: 5px; width: 18px; height: 12px;
                    viewbox-width: 18; viewbox-height: 12;
                    stroke: Theme.text-2;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                    commands: "M 2 3.5 H 16 M 16 3.5 L 13 1 M 16 3.5 L 13 6 M 16 8.5 H 2 M 2 8.5 L 5 6 M 2 8.5 L 5 11";
                }
                if root.icon == 1 : Path {
                    x: 4px; y: 3px; width: 14px; height: 16px;
                    viewbox-width: 14; viewbox-height: 16;
                    stroke: Theme.text-2;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                    commands: "M 7 15 V 1 M 7 1 L 2.75 5.25 M 7 1 L 11.25 5.25";
                }
                if root.icon == 2 : Path {
                    x: 4px; y: 3px; width: 14px; height: 16px;
                    viewbox-width: 14; viewbox-height: 16;
                    stroke: Theme.text-2;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                    commands: "M 7 1 V 15 M 7 15 L 2.75 10.75 M 7 15 L 11.25 10.75";
                }
            }
        }
        VerticalLayout {
            spacing: 1px;
            alignment: center;
            Text {
                text: root.label;
                color: Theme.text;
                // Same 13px size as every other label: the role name is
                // the same size closed and expanded.
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.caption;
                color: Theme.faint;
                font-size: 12px;
                font-weight: 400;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.selected : VerticalLayout {
            width: 11px;
            alignment: center;
            Path {
                width: 11px;
                height: 11px;
                viewbox-width: 12;
                viewbox-height: 12;
                stroke: Theme.faint;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
                commands: "M 2 6 L 5 9 L 10 3";
            }
        }
    }
}

// Role selection as a proper dropdown with a drawn chevron. The popup is
// a PopupWindow, so it floats above the tab content and closes on an
// outside click; the chevron flips while it is open. The control itself
// is a compact 140×36 pill that sits level with its neighbours, and the
// popup is exactly the same width — no horizontal jump when it opens.
component RoleDropdown inherits Rectangle {
    in property <string> current: "Both ways";
    in property <int> mode-index: 0;
    in property <bool> enabled: true;
    // The daemon is applying the pending role — show a donut in the arrow
    // slot so the press visibly took effect. Cleared when the daemon
    // confirms (or refuses).
    in property <bool> applying: false;
    // The role just landed (kept for the applied-state timer; no green
    // frame is drawn — the control stays neutral in every state).
    in-out property <bool> applied: false;
    in property <int> tick: 0;
    callback picked(int);
    width: 140px;
    height: 36px;
    border-radius: 9px;
    background: hit.has-hover || popup.is-open ? Theme.hover : Theme.bg;
    border-width: 1px;
    // Neutral outline in every state: no green frame on apply, on the
    // brief "applied" flash, or while the popup is open.
    border-color: popup.is-open ? Theme.border-strong : (hit.has-hover ? Theme.faint : Theme.border);


    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (popup.is-open) {
                popup.close();
            } else {
                popup.show();
            }
        }
    }
    accessible-role: combobox;
    accessible-label: "This computer's role";
    accessible-expanded: popup.is-open;
    accessible-action-expand => { popup.show(); }
    // The icon + label group is centred as one unit in the space left of
    // the chevron slot, both axes. The icon renders in the compressed
    // state exactly as it does inside the popup.
    if !root.applying : HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        alignment: center;
        spacing: 7px;
        // Icon, in a full-height centering cell: the 36px pill's fixed
        // 16px glyph must sit on the text's centre line, not the top.
        VerticalLayout {
            width: 16px;
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                if root.mode-index == 0 : Path {
                    width: 100%; height: 100%;
                    viewbox-width: 18; viewbox-height: 12;
                    stroke: Theme.text-2;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                    commands: "M 2 3 H 16 M 16 3 L 13 0.75 M 16 3 L 13 5.25 M 16 9 H 2 M 2 9 L 5 6.75 M 2 9 L 5 11.25";
                }
                if root.mode-index == 1 : Path {
                    width: 100%; height: 100%;
                    viewbox-width: 14; viewbox-height: 16;
                    stroke: Theme.text-2;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                    commands: "M 7 15 V 1 M 7 1 L 2.75 5.25 M 7 1 L 11.25 5.25";
                }
                if root.mode-index == 2 : Path {
                    width: 100%; height: 100%;
                    viewbox-width: 14; viewbox-height: 16;
                    stroke: Theme.text-2;
                    stroke-width: 1.8px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                    commands: "M 7 1 V 15 M 7 15 L 2.75 10.75 M 7 15 L 11.25 10.75";
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.current;
                color: Theme.text;
                // Same 13px size as the closed pill: the role name never
                // changes size between closed and open.
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    if root.applying : SpinnerArc {
        x: (parent.width - 18px) / 2;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        diameter: 18px;
        tick: root.tick;
    }
    // Chevron pinned to the right slot; hidden while the donut occupies it.
    if !root.applying : Rectangle {
        x: parent.width - 23px;
        y: (parent.height - 13px) / 2;
        width: 13px;
        height: 13px;
        ChevronGlyph {
            width: 100%;
            height: 100%;
            open: popup.is-open;
            glyph-color: popup.is-open ? Theme.text-2 : Theme.faint;
        }
    }
    Timer {
        interval: 700ms;
        running: root.applied;
        triggered => { root.applied = false; }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        // Exactly the compressed pill's width: opening the list must not
        // make the control look wider or shift its right edge.
        width: root.width;
        height: 142px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.surface;
            border-radius: 11px;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                alignment: start;
                RoleRow {
                    label: "Both ways";
                    caption: "Drive each other";
                    icon: 0;
                    selected: root.mode-index == 0;
                    picked => { popup.close(); root.picked(0); }
                }
                RoleRow {
                    label: "Server";
                    caption: "This computer drives the other";
                    icon: 2;
                    selected: root.mode-index == 1;
                    picked => { popup.close(); root.picked(1); }
                }
                RoleRow {
                    label: "Client";
                    caption: "The other drives this computer";
                    icon: 1;
                    selected: root.mode-index == 2;
                    picked => { popup.close(); root.picked(2); }
                }
            }
        }
    }
}

// Collapsible section header for things that should stay out of sight.
component Disclosure inherits Rectangle {
    in property <string> label: "";
    in property <bool> open: false;
    callback clicked();
    horizontal-stretch: 1;
    height: 36px;
    background: transparent;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        horizontal-stretch: 1;
        min-width: 300px;
        spacing: 8px;
        Text {
            text: root.label;
            color: Theme.text-2;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        ChevronGlyph { open: root.open; glyph-color: Theme.faint; }
    }
}

// TheKVM: Deskflow-simple. The Connect tab is the whole product for most
// users: pick what this computer does, type the other computer's address,
// press Connect. Everything advanced lives under Devices and Settings.
export component AppWindow inherits Window {
    title: "TheKVM" + title-alert;

    min-width: 720px;
    min-height: 560px;
    background: Theme.bg;
    // Crisp native-feeling text: resolve the desktop's own UI family
    // (Ubuntu on Mint, Segoe UI on Windows) instead of Slint's embedded
    // fallback. Small unhinted fallback glyphs read blurry next to
    // native apps; the system family is drawn for exactly these sizes.
    // Missing families fall back gracefully per platform, never blank.
    // TEST: temporarily without default-font-family
    // default-font-family: "Ubuntu, Segoe UI, Noto Sans, DejaVu Sans, Sans-Serif";

    // The native widgets (Button/LineEdit/CheckBox) follow Palette, so the
    // scheme tracks the app theme toggle. Applied at startup and re-asserted
    // on a slow guard timer, since the backend re-applies the OS theme on
    // ThemeChanged/xdg-portal events and would otherwise flip the palette
    // behind the user's back.
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
        scheme-guard.start();
    }
    scheme-guard := Timer {
        interval: 3s;
        triggered => {
            if (Palette.color-scheme != (Theme.dark ? ColorScheme.dark : ColorScheme.light)) {
                Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
            }
        }
    }
    changed status-text => {
        if (root.status-text != "" && root.status-text != root.status-notice) {
            root.status-notice = root.status-text;
            notice-timer.restart();
        }
    }
    notice-timer := Timer {
        interval: 7s;
        triggered => { root.status-notice = ""; }
    }
    // The crossing pulse is a flash, not a state: it clears itself.
    Timer {
        interval: 650ms;
        running: root.crossing-pulse;
        triggered => { root.crossing-pulse = false; }
    }

    in property <string> status-text: "";
    // Transient feedback line: mirrors the latest status briefly (errors,
    // refusals, saved settings) and then disappears, so no permanent bar.
    in-out property <string> status-notice: "";
    in property <bool> connected: false;
    in property <string> session-text: "Not connected";
    in property <bool> session-active: false;
    // True only after the child reported a verified session. session-active
    // alone means "a link process exists" (Connecting OR Connected).
    in property <bool> session-verified: false;
    in-out property <string> fingerprint: "…";
    in-out property <string> peer-list: "No trusted computers";
    in-out property <string> linked-peer-name: "";
    in-out property <string> arrangement-text: "No linked screens yet — pair a computer first.";
    in-out property <bool> peer-on-right: true;
    // Roles for the crossing illustration: this computer's role and the
    // linked computer's role (0 both ways, 1 control other only, 2 be
    // controlled) decide how many crossing arrows the mirror shows.
    in-out property <int> our-mode: 0;
    in-out property <int> peer-mode: 0;
    in-out property <bool> edge-active: false;
    in-out property <string> driving-text: "";
    // True while a live inbound session from the peer has demonstrably taken
    // the cursor AND sent input recently (peer is actively driving).
    in-out property <bool> inbound-driving: false;
    // True while OUR outbound drive is active (child stderr said "driving").
    in-out property <bool> outbound-driving: false;
    // Link is live right now: our dial-back child verified, or an inbound
    // session is verifiably carrying input. The mesh, LED and borders use
    // this instead of "some peer exists in the book".
    in-out property <bool> link-live: false;
    // Brief handoff pulse: the lit edge bars and crossing arrows flash
    // bright for a moment on every crossing.
    in-out property <bool> crossing-pulse: false;
    in-out property <string> revoke-fingerprint: "";
    in-out property <string> pending-peer-fingerprint: "";
    in-out property <string> pending-peer-name: "";
    in-out property <string> pending-verification-code: "";
    in-out property <string> incoming-pairing: "";
    in-out property <string> incoming-pairing-fingerprint: "";
    in-out property <string> incoming-verification-code: "";
    // One-time ceremony opt-out: when the allow card is approved with this
    // ticked, THIS computer always reconnects to that computer silently
    // from now on (both sides tick once, never again).
    in-out property <bool> incoming-autoconnect: true;
    // Inbound link approval (see PendingLink): a paired peer dialing a
    // fresh epoch waits for Allow/Deny here. Set from the poll loop;
    // cleared when the queue empties.
    in-out property <string> incoming-link: "";
    in-out property <string> incoming-link-fingerprint: "";
    in-out property <bool> lock-screen-control: false;
    in-out property <bool> clipboard-enabled: true;
    in-out property <string> clipboard-max-mb: "2";
    in-out property <bool> reverse-scroll: false;
    // Login auto-start (kvm-platform::autostart): the switch reflects
    // what the OS will actually do at the next logon, not a config
    // value, so it can never claim a state the machine does not have.
    in-out property <bool> autostart-enabled: false;
    in property <bool> autostart-supported: true;
    in-out property <bool> autostart-busy: false;
    in-out property <string> autostart-note: "";
    // Auto-reconnect: true only for the last link this machine was
    // actually linked to at shutdown. A Disconnect clears the remembered
    // address, so a link the user ended is never resurrected; the
    // epoch-ban system still refuses the re-dial if the peer also ended
    // it on their side.
    in-out property <bool> auto-connect-on-start: false;
    in property <bool> auto-connect-known: false;
    in-out property <bool> auto-connect-busy: false;
    in-out property <string> auto-connect-note: "";
    // 0 Both ways, 1 Server, 2 Client.
    in-out property <int> mode-index: 0;
    // Set while a role change is in flight (arc shows in the dropdown), and
    // briefly after it lands (green frame).
    in-out property <bool> role-applying: false;
    in-out property <bool> role-applied: false;
    // 0 Single, 1 Mirror.
    in-out property <int> edge-mode-index: 1;
    // True while an edge-mode change is being applied to a live child; the
    // pressed tile shows the donut until the child acknowledges.
    in property <bool> edge-applying: false;
    // Which tile was pressed last, so its donut shows (the daemon may not
    // have applied the new selection yet when the spinner starts).
    in-out property <int> pending-edge-index: -1;
    in property <string> role-text: "Both ways";
    in property <string> app-version: "";
    // Taskbar/dock alert: set while an incoming pairing waits, so a
    // minimized window still announces the request.
    in property <string> title-alert: "";
    in-out property <bool> advanced-open: false;
    in-out property <bool> dark-mode: true;
    // Multi-node grid: opt-in in Devices. Placement persists locally and
    // applies to every pinned peer via the daemon push.
    in-out property <bool> multi-node: false;
    in-out property <string> mesh-mode: "bidirectional";
    in-out property <[GridPeer]> grid-peers: [];
    in-out property <string> grid-drag: "";
    in-out property <string> grid-pending: "";
    in-out property <bool> grid-open: false;
    in-out property <bool> mesh-applying: false;
    in-out property <int> hover-col: -1;
    in-out property <int> hover-row: -1;
    callback toggle-theme();
    callback toggle-multi-node();
    callback open-discovery();
    callback close-discovery();
    callback confirm-delete();
    callback cancel-delete();
    callback set-mesh-mode(string);
    callback open-mesh-grid();
    callback close-mesh-grid();
    callback grid-peer-tap(string);
    callback grid-cell-down(int, int);
    callback grid-cell-move(int, int);
    callback grid-cell-up(int, int);
    callback grid-remove(string);
    callback apply-mesh();
    // Trusted peers with their fingerprints, shown only inside Advanced.
    in-out property <string> trusted-peers-advanced: "";
    // Allowed connections (Settings): structured rows with a red trash
    // icon per computer, fed from the same peer book as Advanced.
    in-out property <[TrustedPeer]> trusted-peers: [];
    // Pending deletion: set to the peer's fingerprint on trash tap;
    // the popup asks first, then revokes.
    in-out property <string> pending-delete: "";
    in-out property <string> pending-delete-name: "";
    // Overflow-menu state (SET-06): rename editor target.
    in-out property <string> rename-peer-fp: "";
    in-out property <string> rename-peer-name: "";
    // DS-07: OS "show animations" preference switches this on: spinners
    // and the radar hold still. Mirrored into Theme.reduced at startup.
    in-out property <bool> reduced-motion: false;
    // CB-13 toast: smart auto-dismissing notification (non-modal, never
    // steals focus). The 5s Timer clears it; the user can dismiss it with
    // the x. Currently used for the over-limit file clipboard (CB-05).
    in-out property <string> clipboard-toast: "";
    callback peer-view-details(string /* fingerprint */);
    callback peer-show-keys(string /* fingerprint */);
    callback peer-copy-address(string /* fingerprint */);
    callback peer-rename(string /* fingerprint */, string /* current name */);
    callback peer-save-rename(string /* fingerprint */, string /* new name */);
    // Connect roster (CON-03): the complete machine list — every row's
    // name, address and state text, fed by the Rust side per status poll.
    in-out property <[string]> roster-names: [];
    in-out property <[string]> roster-addresses: [];
    in-out property <[string]> roster-states: [];
    in-out property <[string]> roster-fingerprints: [];
    // Dev-10 state vocabulary: one label per state, shared by roster +
    // Devices. Values: Live, Connecting, Idle, Discovered, Error.
    // Discovery sheet (Settings +): green radar sweep while scanning,
    // then the found devices as tappable rows.
    in-out property <bool> discovery-open: false;
    in-out property <string> layout-path: "";
    in-out property <string> peer-address: "";
    in-out property <string> pair-code: "";
    in property <string> pairing-code: "";
    in-out property <string> discovery-text: "No LAN scan yet";
    // Nearby-devices card (top of the Connect tab): shown on startup so
    // the LAN set is visible without hunting for the Devices tab. The
    // drawn cross hides it; the drawn refresh button rescans (and shows
    // the donut while the scan runs), and the UI re-reveals the card when
    // a background scan detects a NEW device, so a hidden card can never
    // keep a nearby computer invisible. Listing only — never dials.
    in-out property <bool> discovery-card-visible: true;
    // Expanded per-computer detail card on the Devices tab; peers only
    // fill in their address/fingerprint once the daemon reports them.
    in-out property <bool> details-expanded: false;
    in-out property <string> details-peer-name: "";
    in-out property <string> details-peer-address: "";
    in-out property <string> details-peer-fingerprint: "";
    // True while a scan is in flight.
    in-out property <bool> discovery-scanning: false;
    // Scanned devices (label + dial address behind each row): refreshed by
    // the Scan button and, when auto-discovery is on, the background poll.
    // Picking a row and pressing Connect dials it through the normal
    // pairing/mode-checked flow — a tap never bypasses approval.
    in-out property <[string]> discovered-labels: [];
    in-out property <int> discovered-index: 0;
    // Automatic LAN discovery listing (Settings, default on): listing
    // only, never dials by itself.
    in-out property <bool> auto-discover: true;
    // Manual control (Settings ▸ This computer, default OFF): gates the
    // typed-IP / typed-code out-of-band path and the pairing-code
    // readout. Auto-connect needs none of it.
    in-out property <bool> manual-control-enabled: false;
    in-out property <string> device-name: "";
    in-out property <string> auto-connect-address: "";
    in-out property <string> local-address: "";
    in-out property <string> invite-text: "";
    in-out property <image> invite-qr;
    in-out property <bool> invite-ready: false;
    in-out property <string> invite-input: "";

    // First-connect link warm-up: set when the user presses Connect (or
    // the station dials back), cleared the moment the session display
    // settles (see set_session). While set and no session is live, the
    // Connect tab shows the donut beside the session line — and crossings
    // stay gated daemon-side until edge-ready, so the first push after
    // the spinner is already warm and instant.
    in property <bool> link-connecting: false;
    in-out property <int> spinner-tick: 0;

    callback connect-to(string /* address */, string /* typed station code, may be empty */);
    callback disconnect();
    callback set-role(int /* 0 both, 1 controller, 2 receiver */);
    callback set-edge-mode(int /* 0 single facing edge, 1 double horizontal edges */);
    callback set-reverse-scroll(bool /* true reverses outbound wheel */);
    callback pair-from-invite(string /* invite */);
    callback discover-lan();
    callback hide-discovery();
    callback connect-discovered(int /* ComboBox row */);
    callback apply-auto-discover(bool /* wanted */);
    callback apply-manual-control(bool /* wanted */);
    callback start-daemon();
    callback confirm-pairing();
    callback cancel-pairing();
    callback approve-incoming-pairing(string /* fingerprint */, bool /* also remember for auto-connect */);
    callback reject-incoming-pairing(string);
    callback approve-incoming-link(string /* fingerprint */, bool /* also remember for auto-connect */);
    callback reject-incoming-link(string);
    callback revoke-peer(string);
    callback place-peer-left();
    callback place-peer-right();
    callback open-log-folder();
    callback apply-config(bool, int, string, string, bool, string);
    // Login auto-start and auto-reconnect toggles (Problem 3). Both carry the
    // requested state; the UI code re-reads the OS / the daemon afterwards so
    // the switches always show what the machine will really do.
    callback apply-autostart(bool /* wanted */);
    callback apply-auto-connect(bool /* wanted */);
    callback import-layout(string);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Persistent offline banner: daemon unreachable is shown at all
        // times, on every tab (not the 7-second transient footer). Visible
        // only while offline — a conditional element takes no layout space.
        if !connected : Rectangle {
            vertical-stretch: 0;
            height: 34px;
            background: #3b2f07;
            border-width: 1px;
            border-color: #f59e0b;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: "⚠ Background service is offline";
                    color: #fbbf24;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: "the link cannot work until it is running";
                    color: #fcd34d;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                KvmButton {
                    text: "Start service";
                    clicked => { root.start-daemon(); }
                }
            }
        }

        // NOTE: no header of any kind lives here anymore — not even the
        // old slim status row. Every in-flow strip above the tabs read
        // as a permanent black bar (Slint reserves layout space for
        // hidden elements), so the tabs start at the window padding and
        // live status already shows inside the Connect tab.
        GridLayout {
            padding: 12px;
            spacing: 0px;

        TabWidget {
            row: 0;
            col: 0;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            Tab {
                title: "Connect";
                // Scrollable: tab content is taller than the window, and a
                // plain VerticalLayout silently CLIPS everything past the
                // bottom — which once hid the whole address/code/connect
                // row with no way to reach it. Never clip again.
                PageScroll {
                Rectangle {
                // Exactly the Flickable's width: the content must never ask the
                // viewport to be wider than the window, or the panels get
                // sliced off at the right edge and a horizontal scrollbar
                // appears for no reason. Height comes from the layout's
                // own preferred height so long content overflows the
                // viewport and the ScrollView actually scrolls (a
                // layout-managed child otherwise measures the viewport
                // height and everything below the fold is unreachable).
                width: parent.width;
                height: content-connect.preferred-height + 24px;
                content-connect := VerticalLayout {
                    padding: 12px;
                    spacing: 12px;

                    // ---- One expanded control box ------------------------
                    // The entire top section is a single hairline box:
                    // device dropdown + Both ways role on the top row,
                    // the ONE Connect/Disconnect button right below it
                    // on the right side. It sits a little lower than the
                    // old floating card, and nothing else frames these
                    // controls (no inner panels, no highlights).
                    Rectangle { height: 6px; background: transparent; }
                    if discovery-card-visible : Rectangle {
                        vertical-stretch: 0;
                        background: Theme.bg;
                        border-radius: 14px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Nearby devices";
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                RescanButton {
                                    scanning: root.discovery-scanning;
                                    tick: root.spinner-tick;
                                    clicked => { discover-lan(); }
                                }
                                CloseButton {
                                    clicked => { hide-discovery(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                if discovered-labels.length > 0 : DeviceDropdown {
                                    labels: root.discovered-labels;
                                    current-index <=> root.discovered-index;
                                    height: 36px;
                                    horizontal-stretch: 1;
                                }
                                if discovered-labels.length == 0 : DeviceDropdown {
                                    labels: [];
                                    current-index: 0;
                                    height: 36px;
                                    horizontal-stretch: 1;
                                }
                                // Role selection is local configuration, not a
                                // daemon-dependent action: the dropdown is always
                                // pressable. Gating it once made it look permanently
                                // dead whenever the status poll failed.
                                RoleDropdown {
                                    current: root.role-text;
                                    mode-index: root.mode-index;
                                    applying: root.role-applying;
                                    applied: root.role-applied;
                                    tick: root.spinner-tick;
                                    picked(index) => { set-role(index); }
                                }
                            }
                            // No "Scanning…" caption: the spinning rescan
                            // icon already says it. Only the result count
                            // shows, once the scan settles.
                            Text {
                                text: root.discovery-scanning ? "" : root.discovery-text;
                                color: Theme.faint;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            // The ONE button, two faces: Connect when idle
                            // (dials the selected nearby computer),
                            // Disconnect while linked (ends the whole
                            // link). No second button anywhere.
                            HorizontalLayout {
                                alignment: end;
                                spacing: 9px;
                                if link-connecting && !session-verified : VerticalLayout {
                                    width: 18px;
                                    alignment: center;
                                    SpinnerArc {
                                        diameter: 18px;
                                        tick: root.spinner-tick;
                                    }
                                }
                                KvmButton {
                                    text: session-active ? "Disconnect" : "Connect";
                                    primary: !session-active;
                                    enabled: session-active || discovered-labels.length > 0;
                                    clicked => {
                                        if (session-active) {
                                            disconnect();
                                        } else {
                                            connect-discovered(root.discovered-index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // The card's rescan control lives inside the box, so
                    // hiding it must leave a way back: this compact chip
                    // rescans and reopens the listing.
                    if !discovery-card-visible : Rectangle {
                        vertical-stretch: 0;
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.surface-2;
                        border-width: 1px;
                        border-color: Theme.border;
                        RescanButton {
                            x: 4px;
                            y: 4px;
                            scanning: root.discovery-scanning;
                            tick: root.spinner-tick;
                            clicked => {
                                root.discovery-card-visible = true;
                                discover-lan();
                            }
                        }
                    }

                    // ---- Connect (manual out-of-band path) ----------------
                    // Auto-discovery is the normal way in, so the typed-IP
                    // row and the pairing code stay hidden unless the user
                    // opted into Manual control in Settings.
                    if root.manual-control-enabled : VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 10px;
                            addr := LineEdit {
                                text <=> root.peer-address;
                                placeholder-text: "Other computer's address";
                                enabled: !session-active;
                                // Fixed width, no stretch: a stretched sibling
                                // starves the Connect button to zero width.
                                width: 320px;
                            }
                            KvmButton {
                                text: "Connect";
                                primary: true;
                                enabled: addr.text != "" && !session-active;
                                tooltip: session-active ? "Disconnect the current session first" : (addr.text == "" ? "Enter the other computer's address" : "");
                                clicked => { connect-to(addr.text, code-field.text); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        code-field := LineEdit {
                            vertical-stretch: 0;
                            text <=> root.pair-code;
                            placeholder-text: "Pairing code (optional)";
                            enabled: !session-active;
                        }
                    }

                    // ---- This computer / Connected computer (CON-02) ---
                    // Two rows on ONE grid: the status dots share a single
                    // 24px column at the same baseline and both labels start
                    // on the same vertical line. Connected text never shifts
                    // the grid. Vocabulary: Live / Connecting / Idle.
                    Text {
                        vertical-stretch: 0;
                        text: "Computers";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        height: 40px;
                        spacing: 8px;
                        // Left-hugging row: the dot column stays glued to
                        // the content gutter on both rows, so the status
                        // dots share one column and the labels start at
                        // the same line in every state (Live/Connecting/
                        // Idle) — centering let the dot column drift.
                        alignment: start;
                        VerticalLayout {
                            width: 24px;
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: #22c55e;
                            }
                        }
                        Text {
                            text: "This computer";
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.device-name == "" ? "" : root.device-name;
                            color: Theme.faint;
                            font-size: 14px;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.local-address == "" ? "—" : root.local-address;
                            color: Theme.text-2;
                            font-size: 14px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Live";
                            color: #22c55e;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        height: 40px;
                        spacing: 8px;
                        // Left-hugging row, same grid as the local row
                        // above: dots share one column, labels start at
                        // the same line in every state.
                        alignment: start;
                        VerticalLayout {
                            width: 24px;
                            alignment: center;
                            if link-connecting && !session-verified : SpinnerArc {
                                diameter: 18px;
                                tick: root.spinner-tick;
                            }
                            if !link-connecting || session-verified : Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: session-verified ? #22c55e : (session-active ? #f59e0b : Theme.border-strong);
                            }
                        }
                        Text {
                            text: root.linked-peer-name == "" ? "Connected computer" : root.linked-peer-name;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.linked-peer-name == "" ? "" : "Connected computer";
                            color: Theme.faint;
                            font-size: 14px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.details-peer-address == "" ? "—" : root.details-peer-address;
                            color: Theme.text-2;
                            font-size: 14px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            text: session-verified ? "Live" : (link-connecting || session-active ? "Connecting" : "Idle");
                            color: session-verified ? #22c55e : (link-connecting || session-active ? #f59e0b : Theme.faint);
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    if driving-text != "" : Text {
                        vertical-stretch: 0;
                        text: driving-text;
                        color: #34d399;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        vertical-stretch: 0;
                        text: session-text;
                        color: Theme.faint;
                        font-size: 12px;
                        overflow: elide;
                        wrap: word-wrap;
                    }
                    // (No roster here: the complete per-computer roster
                    // lives once, in Devices. Connect stays the two-row
                    // this/connected status grid only.)

                    // ---- Pairing code ------------------------------------
                    // Only meaningful for the manual path: auto-connect never
                    // uses it. Fixed, right-eliding block — never clips.
                    if root.manual-control-enabled : Rectangle {
                        vertical-stretch: 0; height: 1px; background: Theme.border; }
                    if root.manual-control-enabled : HorizontalLayout {
                        vertical-stretch: 0;
                        height: 36px;
                        spacing: 10px;
                        Text {
                            text: "Pairing code";
                            color: Theme.faint;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            width: 150px;
                            text: root.pairing-code == "" ? "…" : root.pairing-code;
                            color: #22c55e;
                            font-size: 21px;
                            font-weight: 800;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }

                    // ---- Pairing ceremonies ------------------------------
                    if pending-verification-code != "" : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        Text {
                            text: "Does " + (pending-peer-name == "" ? "the other computer" : pending-peer-name) + " show this code?";
                            color: #f59e0b;
                            font-size: 14px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            text: pending-verification-code;
                            color: #22c55e;
                            font-size: 28px;
                            font-weight: 800;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            KvmButton {
                                text: "Codes match";
                                primary: true;
                                btn-width: 110px;
                                clicked => { confirm-pairing(); }
                            }
                            KvmButton {
                                text: "Cancel";
                                btn-width: 96px;
                                clicked => { cancel-pairing(); }
                            }
                        }
                    }
                    if incoming-pairing != "" : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        // Both directions must be visible SIMULTANEOUSLY. This
                        // used to hide while our own outgoing code check was
                        // open — so when both computers pressed Connect, each
                        // side showed only its outgoing screen and neither
                        // could ever approve the other: a mutual-blindness
                        // deadlock with both users staring at unanswerable
                        // code screens until everything timed out.
                        Text {
                            text: "Incoming pairing · " + incoming-pairing;
                            color: #f59e0b;
                            font-size: 14px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        if incoming-verification-code != "" : Text {
                            text: incoming-verification-code;
                            color: #22c55e;
                            font-size: 28px;
                            font-weight: 800;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            KvmButton {
                                text: "Allow";
                                primary: true;
                                btn-width: 96px;
                                clicked => { approve-incoming-pairing(incoming-pairing-fingerprint, root.incoming-autoconnect); }
                            }
                            KvmButton {
                                text: "Deny";
                                btn-width: 96px;
                                clicked => { reject-incoming-pairing(incoming-pairing-fingerprint); }
                            }
                        }
                        CheckBox {
                            text: "Auto-connect this computer next time";
                            checked <=> root.incoming-autoconnect;
                        }
                    }
                    if incoming-link != "" : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        // Paired computers still ask before driving: a
                        // fresh link epoch from a trusted peer waits here
                        // (Allow once per link — retries and the dial-back
                        // on the same link never ask again).
                        Text {
                            text: "Link request · " + incoming-link;
                            color: #6ee7b7;
                            font-size: 14px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            Rectangle { horizontal-stretch: 1; }
                            KvmButton {
                                text: "Allow";
                                primary: true;
                                btn-width: 96px;
                                clicked => { approve-incoming-link(incoming-link-fingerprint, root.incoming-autoconnect); }
                            }
                            KvmButton {
                                text: "Deny";
                                btn-width: 96px;
                                clicked => { reject-incoming-link(incoming-link-fingerprint); }
                            }
                        }
                        CheckBox {
                            text: "Auto-connect this computer next time";
                            checked <=> root.incoming-autoconnect;
                        }
                    }

                    if !connected : KvmButton {
                        vertical-stretch: 0;
                        text: "Start background service";
                        clicked => { start-daemon(); }
                    }
                
                    // Absorbs all spare vertical space so every row above
                    // keeps its natural height instead of stretching.
                    Rectangle { height: 28px; background: transparent; }
                }
                }
                }
            }

            Tab {
                title: "Devices";
                PageScroll {
                Rectangle {
                // Exactly the Flickable's width: the content must never ask the
                // viewport to be wider than the window, or the panels get
                // sliced off at the right edge and a horizontal scrollbar
                // appears for no reason. Height comes from the layout's
                // own preferred height so long content overflows the
                // viewport and the ScrollView actually scrolls (a
                // layout-managed child otherwise measures the viewport
                // height and everything below the fold is unreachable).
                width: parent.width;
                height: content-devices.preferred-height + 24px;
                content-devices := VerticalLayout {
                    padding: 12px;
                    spacing: 12px;

                    // ---- Computers (DEV-01: title, roster summary) ------
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        Text {
                            text: "Computers";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.roster-names.length == 0 ? "0" : root.roster-names.length + " known";
                            color: Theme.faint;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        if discovery-scanning : SpinnerArc {
                            diameter: 16px;
                            tick: root.spinner-tick;
                        }
                        KvmButton {
                            text: "Scan";
                            enabled: !discovery-scanning;
                            clicked => { discover-lan(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 78px;
                            height: 30px;
                            border-radius: 7px;
                            background: details-hit.has-hover ? Theme.accent-panel : transparent;
                            border-width: 1px;
                            border-color: details-hit.has-hover ? Theme.accent-border : Theme.border;
                            details-hit := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.details-expanded = !root.details-expanded; }
                            }
                            accessible-role: button;
                            accessible-label: root.details-expanded ? "Hide computer details" : "Show computer details";
                            accessible-expanded: root.details-expanded;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 6px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: "Details";
                                    color: details-hit.has-hover ? #86efac : Theme.faint;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                ChevronGlyph {
                                    open: root.details-expanded;
                                    glyph-color: details-hit.has-hover ? #86efac : Theme.faint;
                                }
                            }
                        }
                    }
                    // ---- Per-computer rows (DEV-03/04): one primary
                    // state per computer, from the single vocabulary
                    // Live / Connecting / Idle / Discovered / Error.
                    // Only actions valid for the current state appear.
                    for i in root.roster-names.length : Rectangle {
                        vertical-stretch: 0;
                        height: 48px;
                        border-radius: 10px;
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 8px;
                            // Left-hugging row: dot/name/address/state
                            // start at the content gutter in every state.
                            alignment: start;
                            VerticalLayout {
                                width: 24px;
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: root.roster-states[i] == "Live" ? #22c55e
                                        : root.roster-states[i] == "Android · Live" ? #facc15
                                        : root.roster-states[i] == "Android" ? #facc15
                                        : root.roster-states[i] == "Connecting" ? #f59e0b
                                        : root.roster-states[i] == "Error" ? #f87171
                                        : root.roster-states[i] == "Discovered" ? #5eead4
                                        : Theme.border-strong;
                                }
                            }
                            Text {
                                text: root.roster-names[i];
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.roster-addresses[i];
                                color: Theme.text-2;
                                font-size: 14px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Text {
                                width: 80px;
                                text: root.roster-states[i];
                                color: Theme.faint;
                                font-size: 14px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            KvmButton {
                                text: "Details";
                                aria-label: "Details for " + root.roster-names[i] + ", row " + (i + 1) + " of " + root.roster-names.length;
                                enabled: root.roster-fingerprints[i] != "";
                                tooltip: root.roster-fingerprints[i] == "" ? "Details become available after this computer is paired" : "";
                                clicked => { root.peer-view-details(root.roster-fingerprints[i]); }
                            }
                            // DS-10: the row announces its position in the
                            // list ("row N of M") to assistive tech.
                            if root.roster-states[i] == "Idle" || root.roster-states[i] == "Discovered" || root.roster-states[i] == "Android" : KvmButton {
                                text: "Connect";
                                aria-label: "Connect to " + root.roster-names[i] + ", row " + (i + 1) + " of " + root.roster-names.length;
                                primary: true;
                                enabled: !session-active && root.roster-addresses[i] != "";
                                tooltip: session-active ? "Disconnect the current session first" : (root.roster-addresses[i] == "" ? "No address is known for this computer yet" : "");
                                clicked => { connect-to(root.roster-addresses[i], ""); }
                            }
                        }
                    }
                    if root.roster-names.length == 0 : Text {
                        vertical-stretch: 0;
                        text: "No computers yet. Press Scan, or add one with + in Settings.";
                        color: Theme.faint;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    // Expanded per-computer detail, collapsible inline.
                    if root.details-expanded : Rectangle {
                        vertical-stretch: 0;
                        background: Theme.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Computer details";
                                    color: Theme.text;
                                    font-size: 16px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                CloseButton {
                                    clicked => { root.details-expanded = false; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: "THIS COMPUTER"; color: #6ee7b7; font-size: 12px; font-weight: 800; letter-spacing: 1.3px; }
                                    Text { text: root.device-name == "" ? "Unknown" : root.device-name; color: Theme.text; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                                    Text { text: "LAN · " + (root.local-address == "" ? "…" : root.local-address); color: Theme.text-2; font-size: 14px; wrap: word-wrap; }
                                    Text { text: "Fingerprint · " + root.fingerprint; color: Theme.muted; font-size: 12px; wrap: word-wrap; letter-spacing: 0.5px; }
                                    Text { text: "Role · " + root.role-text; color: Theme.faint; font-size: 14px; }
                                }
                                Rectangle { width: 1px; background: Theme.border; vertical-stretch: 1; }
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: "LINKED COMPUTER"; color: #5eead4; font-size: 12px; font-weight: 800; letter-spacing: 1.3px; }
                                    Text { text: root.linked-peer-name == "" ? "Not paired yet" : root.linked-peer-name; color: Theme.text; font-size: 14px; font-weight: 700; wrap: word-wrap; }
                                    Text { text: "Address · " + (root.details-peer-address == "" ? "unknown" : root.details-peer-address); color: Theme.text-2; font-size: 14px; wrap: word-wrap; }
                                    Text { text: "Fingerprint · " + (root.details-peer-fingerprint == "" ? "unknown" : root.details-peer-fingerprint); color: Theme.muted; font-size: 12px; wrap: word-wrap; letter-spacing: 0.5px; }
                                    Text { text: "Link · " + (session-verified ? "Live" : (link-connecting || session-active ? "Connecting" : "Idle")); color: Theme.faint; font-size: 14px; }
                                    Text { text: "Trust · Allowed"; color: Theme.faint; font-size: 14px; }
                                    Text { text: "Capabilities · Control, Clipboard"; color: Theme.faint; font-size: 14px; }
                                }
                            }
                        }
                    }
                    // Nearby devices + the single Connect/Disconnect button
                    // live on the Connect tab. This tab stays arrangement
                    // only, so there is exactly one action button in
                    // the whole window.
                    // (Past/present computer names deliberately not listed
                    // here: the Devices tab shows what is arranged.
                    // Remembered names/addresses come later.)

                    Rectangle {
                        vertical-stretch: 0; height: 1px; background: Theme.border; }

                    // ---- Arrangement -------------------------------------
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        Text {
                            text: "Screen arrangement";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.edge-mode-index == 0 ? "Single" : "Mirror";
                            color: #22c55e;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    ArrangementMesh {
                        vertical-stretch: 0;
                        local-name: root.device-name;
                        peer-name: root.linked-peer-name;
                        peer-on-right: root.peer-on-right;
                        enabled: root.link-live;
                        link-live: root.link-live;
                        crossing-pulse: root.crossing-pulse;
                        edge-mode: root.edge-mode-index;
                        our-mode: root.mode-index;
                        peer-mode: root.peer-mode;
                        to-left => { place-peer-left(); }
                        to-right => { place-peer-right(); }
                    }
                    // Live cue for who has the cursor right now. Honest about
                    // which computer currently makes this screen respond.
                    if root.outbound-driving : Text {
                        vertical-stretch: 0;
                        text: "You are driving " + root.linked-peer-name;
                        color: #22c55e; font-size: 14px; font-weight: 700;
                    }
                    if !root.outbound-driving && root.inbound-driving : Text {
                        vertical-stretch: 0;
                        text: root.linked-peer-name + " is driving this computer";
                        color: #5eead4; font-size: 14px; font-weight: 700;
                    }

                    Rectangle {
                        vertical-stretch: 0; height: 1px; background: Theme.border; }

                    // ---- Crossing edges ----------------------------------
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        Text {
                            text: "Crossing edges";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.edge-mode-index == 0 ? "Single" : "Mirror";
                            color: #22c55e;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    EdgeModePicker {
                        vertical-stretch: 0;
                        selected: root.edge-mode-index;
                        applying: root.edge-applying;
                        pending-index: root.pending-edge-index;
                        // Crossing discipline is global config: selectable
                        // before the first pair too, not only while linked.
                        enabled: true;
                        tick: root.spinner-tick;
                        our-mode: root.mode-index;
                        peer-mode: root.peer-mode;
                        arranged-peer-on-right: root.peer-on-right;
                        picked(index) => {
                            root.pending-edge-index = index;
                            set-edge-mode(index);
                        }
                        flip => {
                            if (root.peer-on-right) {
                                place-peer-left();
                            } else {
                                place-peer-right();
                            }
                        }
                    }
                    if driving-text != "" : Text {
                        vertical-stretch: 0;
                        text: driving-text;
                        color: #22c55e;
                        font-size: 14px;
                        font-weight: 700;
                    }

                    // ---- Multi-node grid (opt-in; 2-device stays default) ----
                    Rectangle {
                        vertical-stretch: 0; height: 1px; background: Theme.border; }
                    Rectangle {
                        vertical-stretch: 0;
                        height: 48px;
                        border-radius: 10px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            x: 12px; y: 5px;
                            text: "Multi-node grid";
                            color: Theme.text-2;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        Text {
                            x: 12px; y: 25px;
                            text: root.multi-node ? "Up to 15 computers on a 5 x 3 grid" : "Two-device mode";
                            color: Theme.faint;
                            font-size: 10px;
                        }
                        ToggleSwitch {
                            x: parent.width - 58px; y: 11px;
                            checked <=> root.multi-node;
                            toggled => { root.toggle-multi-node(); }
                        }
                    }
                    if root.multi-node : Rectangle {
                        vertical-stretch: 0;
                        height: 36px;
                        Rectangle {
                            width: (parent.width - 16px) / 3; height: 32px;
                            border-radius: 8px;
                            background: root.mesh-mode == "bidirectional" ? Theme.accent-panel : Theme.hover;
                            TouchArea { mouse-cursor: pointer; clicked => { root.set-mesh-mode("bidirectional"); } }
                            Text { text: "Both ways"; color: root.mesh-mode == "bidirectional" ? Theme.accent-text : Theme.faint; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            x: (parent.width - 16px) / 3 + 8px; width: (parent.width - 16px) / 3; height: 32px;
                            border-radius: 8px;
                            background: root.mesh-mode == "server_client" ? Theme.accent-panel : Theme.hover;
                            TouchArea { mouse-cursor: pointer; clicked => { root.set-mesh-mode("server_client"); } }
                            Text { text: "One server"; color: root.mesh-mode == "server_client" ? Theme.accent-text : Theme.faint; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            x: (parent.width - 16px) / 3 * 2 + 16px; width: (parent.width - 16px) / 3; height: 32px;
                            border-radius: 8px;
                            background: root.mesh-mode == "client_only" ? Theme.accent-panel : Theme.hover;
                            TouchArea { mouse-cursor: pointer; clicked => { root.set-mesh-mode("client_only"); } }
                            Text { text: "Clients"; color: root.mesh-mode == "client_only" ? Theme.accent-text : Theme.faint; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    if root.multi-node : KvmButton {
                        vertical-stretch: 0;
                        text: "Configure grid";
                        primary: true;
                        enabled: !root.mesh-applying;
                        tooltip: root.mesh-applying ? "The current arrangement is still being applied" : "";
                        clicked => { root.open-mesh-grid(); }
                    }

                    Rectangle { height: 28px; background: transparent; }
                }
                }
                }
            }

            Tab {
                title: "Settings";
                PageScroll {
                Rectangle {
                // Exactly the Flickable's width: the content must never ask the
                // viewport to be wider than the window, or the panels get
                // sliced off at the right edge and a horizontal scrollbar
                // appears for no reason. Height comes from the layout's
                // own preferred height so long content overflows the
                // viewport and the ScrollView actually scrolls (a
                // layout-managed child otherwise measures the viewport
                // height and everything below the fold is unreachable).
                width: parent.width;
                height: content-settings.preferred-height + 24px;
                content-settings := VerticalLayout {
                    padding: 12px;
                    spacing: 4px;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        Text {
                            text: "Computer name";
                            color: Theme.text-2;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        name := LineEdit {
                            height: 36px;
                            text <=> root.device-name;
                            placeholder-text: "friendly name";
                            width: 230px;
                        }
                        KvmButton {
                            text: "Save";
                            enabled: name.text != "";
                            clicked => { apply-config(lock-screen-control, mode-index, name.text, auto-connect-address, clipboard-enabled, root.clipboard-max-mb); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Control login and lock screens";
                            color: Theme.text-2;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToggleSwitch {
                            checked <=> root.lock-screen-control;
                            toggled => { apply-config(root.lock-screen-control, root.mode-index, root.device-name, root.auto-connect-address, root.clipboard-enabled, root.clipboard-max-mb); }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Sync text clipboard";
                            color: Theme.text-2;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToggleSwitch {
                            checked <=> root.clipboard-enabled;
                            toggled => { apply-config(root.lock-screen-control, root.mode-index, root.device-name, root.auto-connect-address, root.clipboard-enabled, root.clipboard-max-mb); }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Reverse scroll on the other computer";
                            color: Theme.text-2;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToggleSwitch {
                            checked <=> root.reverse-scroll;
                            toggled => { root.set-reverse-scroll(root.reverse-scroll); }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Find nearby computers";
                            color: Theme.text-2;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToggleSwitch {
                            checked <=> root.auto-discover;
                            toggled => { root.apply-auto-discover(root.auto-discover); }
                        }
                    }
                    // Manual control gates the typed-IP + typed-code path. When
                    // off, auto-discovery is the only way machines come in.
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Manual control";
                            color: Theme.text-2;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToggleSwitch {
                            checked <=> root.manual-control-enabled;
                            toggled => { root.apply-manual-control(root.manual-control-enabled); }
                        }
                    }
                    Text {
                        vertical-stretch: 0;
                        text: "Typed address and pairing code for this computer; the auto-connect path never uses it.";
                        color: Theme.faint;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Start when I log in";
                            color: root.autostart-supported && !root.autostart-busy ? Theme.text-2 : Theme.faint;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToggleSwitch {
                            checked <=> root.autostart-enabled;
            enabled: root.autostart-supported && !root.autostart-busy;
                            toggled => { root.apply-autostart(root.autostart-enabled); }
                        }
                    }
                    if autostart-note != "" : Text {
                        vertical-stretch: 0;
                        text: autostart-note;
                        color: #fbbf24;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Reconnect at startup";
                            color: root.auto-connect-known && !root.auto-connect-busy ? Theme.text-2 : Theme.faint;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToggleSwitch {
                            checked <=> root.auto-connect-on-start;
                            enabled: root.auto-connect-known && !root.auto-connect-busy;
                            toggled => { root.apply-auto-connect(root.auto-connect-on-start); }
                        }
                    }
                    if root.auto-connect-known : Text {
                        vertical-stretch: 0;
                        text: "Reconnects to last connected device";
                        color: #fbbf24;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    if auto-connect-note != "" : Text {
                        vertical-stretch: 0;
                        text: auto-connect-note;
                        color: #fbbf24;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: root.dark-mode ? "Dark theme (#121212)" : "Light theme (white / blue)";
                            color: Theme.text-2;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToggleSwitch {
                            checked <=> root.dark-mode;
                            toggled => { root.toggle-theme(); }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Clipboard limit (MB)";
                            color: Theme.text-2;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        clipboard-max := LineEdit {
                            height: 36px;
                            text <=> root.clipboard-max-mb;
                            placeholder-text: "2";
                            width: 64px;
                        }
                        KvmButton {
                            text: "Save";
                            clicked => { apply-config(root.lock-screen-control, root.mode_index, root.device-name, root.auto-connect-address, root.clipboard-enabled, clipboard-max.text); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    Rectangle {
                        vertical-stretch: 0; height: 1px; background: Theme.border; }

                    // SET-01: the plus and the title are ONE header row —
                    // same centre line, same gap, aligned to the content
                    // gutter, 36px target, section-size title.
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;
                        alignment: start;
                        IconButton {
                            glyph: "+";
                            clicked => { open-discovery(); }
                        }
                        Text {
                            text: "Allowed connections";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    // SET-02/03/04/05/06: fixed anatomy, left to right —
                    // index; name; 32px hairline separator; IP; flexible
                    // spacer; 3-dot overflow; trash at the far right edge.
                    // The order never changes; delete is rightmost.
                    for peer[i] in root.trusted-peers : Rectangle {
                        vertical-stretch: 0;
                        border-radius: 10px;
                        background: row-hover.has-hover ? Theme.hover : Theme.bg;
                        border-width: 1px;
                        border-color: Theme.border;
                        // SET-10: the delete confirmation lives inside
                        // its own row (below the 48px anatomy) so focus
                        // can trap in the confirm and return to this
                        // row's trash.
                        VerticalLayout {
                            padding: 0px;
                            spacing: 0px;
                            alignment: start;
                            Rectangle {
                                height: 48px;
                                row-hover := TouchArea { mouse-cursor: pointer; }
                                HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 8px;
                            // Content hugs the left gutter (index starts
                            // at the box edge); the spacer pushes the two
                            // trailing actions to the right edge.
                            alignment: start;
                            // SET-03: one-based index, left-aligned so it
                            // starts at the box edge; numbers renumber
                            // automatically after a delete.
                            Text {
                                width: 28px;
                                text: (i + 1) + ".";
                                color: Theme.muted;
                                font-size: 14px;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                            // Fixed columns (SET-02 acceptance): name and
                            // IP share one column edge across EVERY row.
                            // Tight: a too-wide name field read as a huge
                            // hollow gap between the name and the IP.
                            Text {
                                width: 150px;
                                text: peer.name == "" ? "Unnamed computer" : peer.name;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                            // SET-04: one 1px hairline, 24px, centred and
                            // dark-theme-visible (a #3a3a3a line on #121212
                            // was invisible).
                            Rectangle {
                                width: 24px;
                                height: 1px;
                                background: #5b6675;
                            }
                            Text {
                                width: 150px;
                                text: peer.address == "" ? "—" : peer.address;
                                color: Theme.text-2;
                                font-size: 14px;
                                overflow: elide;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // SET-06: 3-dot overflow, immediately left of
                            // the trash, 36x36, opens a menu with the five
                            // documented actions. Closes on outside click
                            // or Escape (PopupWindow close-on-click-outside).
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 8px;
                                background: over-hit.has-hover ? Theme.hover : transparent;
                                // SET-10: keyboard-navigable (SET-06). Tab
                                // reaches the 3-dot; Enter/Space toggles the
                                // menu; Escape closes it.
                                over-scope := FocusScope {
                                    focus_on_tab_navigation: true;
                                    key_pressed(event) => {
                                        if (event.text == "\n" || event.text == " ") {
                                            if (over-popup.is-open) { over-popup.close(); } else { over-popup.show(); }
                                            accept
                                        } else if (event.text == "\u{1b}") {
                                            over-popup.close();
                                            accept
                                        } else {
                                            reject
                                        }
                                    }
                                    key_released(event) => { reject }
                                }
                                over-hit := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (over-popup.is-open) { over-popup.close(); } else { over-popup.show(); }
                                    }
                                }
                                accessible-role: button;
                                accessible-label: "More actions for " + peer.name + ", row " + (i + 1) + " of " + root.trusted-peers.length;
                                accessible-action-default => { over-popup.show(); }
                                OverflowIcon { x: 9px; y: 9px; }
                                over-popup := PopupWindow {
                                    x: parent.width - 220px;
                                    y: 40px;
                                    width: 220px;
                                    height: 5 * 36px + 8px;
                                    close-policy: close-on-click-outside;
                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: Theme.surface;
                                        border-radius: 11px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        clip: true;
                                        VerticalLayout {
                                            padding: 4px;
                                            spacing: 2px;
                                            alignment: start;
                                            RowMenuAction {
                                                label: "View details";
                                                fg: Theme.text;
                                                acted => { over-popup.close(); root.peer-view-details(peer.fingerprint); }
                                                escape-closed => { over-popup.close(); }
                                            }
                                            RowMenuAction {
                                                label: "Device keys and fingerprint";
                                                fg: Theme.text;
                                                acted => { over-popup.close(); root.peer-show-keys(peer.fingerprint); }
                                                escape-closed => { over-popup.close(); }
                                            }
                                            RowMenuAction {
                                                label: "Copy address";
                                                fg: Theme.text;
                                                acted => { over-popup.close(); root.peer-copy-address(peer.fingerprint); }
                                                escape-closed => { over-popup.close(); }
                                            }
                                            RowMenuAction {
                                                label: "Rename";
                                                fg: Theme.text;
                                                acted => { over-popup.close(); root.peer-rename(peer.fingerprint, peer.name); }
                                                escape-closed => { over-popup.close(); }
                                            }
                                            RowMenuAction {
                                                label: "Remove";
                                                fg: #f87171;
                                                acted => { over-popup.close(); root.pending-delete = peer.fingerprint; root.pending-delete-name = peer.name == "" ? "Unnamed computer" : peer.name; }
                                                escape-closed => { over-popup.close(); }
                                            }
                                        }
                                    }
                                }
                            }
                            // SET-05: trash, 18px glyph optically centred
                            // in a 36x36 target, aligned with the overflow,
                            // at the far right edge.
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 8px;
                                background: del-hit.has-hover ? #f8717118 : transparent;
                                // SET-10: trash is a tab stop in visual
                                // order and Enter/Space opens the same
                                // delete confirmation as a click.
                                trash-scope := FocusScope {
                                    focus_on_tab_navigation: true;
                                    key_pressed(event) => {
                                        if (event.text == "\n" || event.text == " ") {
                                            root.pending-delete = peer.fingerprint;
                                            root.pending-delete-name = peer.name == "" ? "Unnamed computer" : peer.name;
                                            accept
                                        } else {
                                            reject
                                        }
                                    }
                                    key_released(event) => { reject }
                                }
                                del-hit := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.pending-delete = peer.fingerprint;
                                        root.pending-delete-name = peer.name == "" ? "Unnamed computer" : peer.name;
                                    }
                                }
                                accessible-role: button;
                                accessible-label: "Remove " + peer.name + ", row " + (i + 1) + " of " + root.trusted-peers.length;
                                accessible-action-default => {
                                    root.pending-delete = peer.fingerprint;
                                    root.pending-delete-name = peer.name == "" ? "Unnamed computer" : peer.name;
                                }
                                TrashIcon {
                                    x: 7px;
                                    y: 7px;
                                }
                            }
                                }
                            }
                            // SET-10: delete confirmation. Cancel is
                            // the default (focused on open); Tab /
                            // Shift-Tab cycle between Cancel and Delete
                            // only (focus trap); Escape cancels; closing
                            // returns focus to this row's trash.
                            if root.pending-delete == peer.fingerprint : trap := FocusScope {
                                focus_on_tab_navigation: false;
                                capture_key_pressed(event) => {
                                    if (event.text == "\u{9}" || event.text == "\u{19}") {
                                        if (delete-b.has-focus) { cancel-b.focus(); } else { delete-b.focus(); }
                                        accept
                                    } else if (event.text == "\u{1b}") {
                                        cancel-delete();
                                        trash-scope.focus();
                                        accept
                                    } else {
                                        reject
                                    }
                                }
                                key_released(event) => { reject }
                                focus-timer := Timer {
                                    interval: 10ms;
                                    running: true;
                                    triggered => {
                                        cancel-b.focus();
                                        self.running = false;
                                    }
                                }
                                Rectangle {
                                    vertical-stretch: 0;
                                    background: Theme.bg;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #f87171;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text {
                                            text: "Are you sure you want to remove " + (peer.name == "" ? "Unnamed computer" : peer.name) + "?";
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 700;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "This computer will no longer be allowed to connect automatically.";
                                            color: Theme.faint;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: 8px;
                                            cancel-b := KvmButton {
                                                text: "Cancel";
                                                btn-width: 96px;
                                                aria-label: "Cancel removing " + peer.name;
                                                clicked => {
                                                    cancel-delete();
                                                    trash-scope.focus();
                                                }
                                            }
                                            delete-b := KvmButton {
                                                text: "Delete";
                                                danger: true;
                                                btn-width: 96px;
                                                aria-label: "Delete " + peer.name;
                                                clicked => {
                                                    confirm-delete();
                                                    trash-scope.focus();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Rename editor (SET-06): opened from the overflow menu.
                    if root.rename-peer-fp != "" : Rectangle {
                        vertical-stretch: 0;
                        background: Theme.bg;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: "Rename computer";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            rename-edit := LineEdit {
                                height: 36px;
                                text <=> root.rename-peer-name;
                                placeholder-text: "Friendly name";
                                width: 320px;
                            }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                KvmButton {
                                    text: "Cancel";
                                    btn-width: 96px;
                                    clicked => { root.rename-peer-fp = ""; root.rename-peer-name = ""; }
                                }
                                KvmButton {
                                    text: "Save";
                                    primary: true;
                                    btn-width: 96px;
                                    enabled: rename-edit.text != "";
                                    tooltip: rename-edit.text == "" ? "Enter a computer name first" : "";
                                    clicked => { root.peer-save-rename(root.rename-peer-fp, rename-edit.text); root.rename-peer-fp = ""; root.rename-peer-name = ""; }
                                }
                            }
                        }
                    }
                    if root.trusted-peers.length == 0 : Text {
                        vertical-stretch: 0;
                        text: "No allowed connections yet. Press + to add one.";
                        color: Theme.faint;
                        font-size: 14px;
                        wrap: word-wrap;
                    }

                    // Delete confirmation (SET-10) lives inside its
                    // own row now (trap + default Cancel + return
                    // focus); nothing is removed until confirmed.

                    // Discovery sheet: green radar sweep while scanning,
                    // then the found devices as tappable rows.
                    if root.discovery-open : Rectangle {
                        vertical-stretch: 0;
                        background: Theme.bg;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            alignment: start;
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: center;
                                RadarIcon {
                                    width: 46px;
                                    height: 46px;
                                    sweeping: root.discovery-scanning;
                                    tick: root.spinner-tick;
                                }
                                Text {
                                    text: root.discovered-labels.length == 0
                                        ? (root.discovery-scanning ? "" : "No devices found yet")
                                        : root.discovered-labels.length == 1 ? "1 device found" : root.discovered-labels.length + " devices found";
                                    color: Theme.text-2;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                RescanButton {
                                    scanning: root.discovery-scanning;
                                    tick: root.spinner-tick;
                                    clicked => { discover-lan(); }
                                }
                                CloseButton {
                                    clicked => { close-discovery(); }
                                }
                            }
                            Text {
                                text: "Tap a device to connect it";
                                color: Theme.faint;
                                font-size: 14px;
                            }
                            if !root.discovery-scanning && root.discovered-labels.length == 0 : Text {
                                text: "Press the refresh icon to search again";
                                color: Theme.faint;
                                font-size: 14px;
                            }
                            for label[i] in root.discovered-labels : Rectangle {
                                vertical-stretch: 0;
                                height: 36px;
                                border-radius: 8px;
                                background: row-hit.has-hover ? Theme.hover : transparent;
                                border-width: 1px;
                                border-color: Theme.border;
                                row-hit := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { connect-discovered(i); close-discovery(); }
                                }
                                accessible-role: button;
                                accessible-label: label;
                                accessible-action-default => { connect-discovered(i); close-discovery(); }
                                Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    text: label;
                                    color: Theme.text-2;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 0; height: 1px; background: Theme.border; }
                    Disclosure {
                        vertical-stretch: 0;
                        label: "Advanced";
                        open: root.advanced-open;
                        clicked => { root.advanced-open = !root.advanced-open; }
                    }
                    if advanced-open : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "Fingerprint";
                            color: Theme.faint;
                            font-size: 14px;
                        }
                        Text {
                            text: fingerprint;
                            color: #f87171;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                        if trusted-peers-advanced != "" : Text {
                            text: "Trusted computers";
                            color: Theme.faint;
                            font-size: 14px;
                        }
                        if trusted-peers-advanced != "" : Text {
                            text: trusted-peers-advanced;
                            color: Theme.faint;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            revoke := LineEdit {
                                height: 36px;
                                text <=> root.revoke-fingerprint;
                                placeholder-text: "Fingerprint to remove";
                                width: 320px;
                            }
                            KvmButton {
                                text: "Remove";
                                enabled: revoke.text != "";
                                clicked => { revoke-peer(revoke.text); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            startup := LineEdit {
                                height: 36px;
                                text <=> root.auto-connect-address;
                                placeholder-text: "Startup address";
                                width: 320px;
                            }
                            KvmButton {
                                text: "Save";
                                clicked => { apply-config(lock-screen-control, mode-index, device-name, startup.text, clipboard-enabled, root.clipboard-max-mb); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            path := LineEdit {
                                height: 36px;
                                text <=> root.layout-path;
                                placeholder-text: "Layout file";
                                width: 320px;
                            }
                            KvmButton {
                                text: "Import";
                                enabled: path.text != "";
                                clicked => { import-layout(path.text); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        KvmButton {
                            text: "Open log folder";
                            clicked => { open-log-folder(); }
                        }
                    }
                    Text {
                        vertical-stretch: 0;
                        text: "TheKVM " + app-version;
                        color: Theme.faint;
                        font-size: 14px;
                    }
                
                    // Absorbs all spare vertical space so every row above
                    // keeps its natural height instead of stretching.
                    Rectangle { height: 28px; background: transparent; }
                }
                }
                }
            }
        }

            // Approval popups: conditional (not merely hidden) so they
            // occupy ZERO space when nothing pends, and overlapped onto
            // the tabs' cell so they float above the content instead of
            // shoving it down. Approval rendezvous still works on every
            // tab — missed requests used to be indistinguishable from a
            // broken network. The `if` (not `visible`) matters: Slint
            // reserves layout space for hidden elements, which is what
            // used to read as a permanent empty bar.
            if incoming-pairing != "" || incoming-link != "" : Rectangle {
                row: 0;
                col: 0;
                // Transparent shell: the cell is sized by the tabs, so
                // this floats over them at zero layout cost; the inner
                // column stacks the pending cards from the top.
                VerticalLayout {
                    spacing: 8px;
                    if incoming-pairing != "" : Rectangle {
                        background: #453008;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #f59e0b;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Pairing request · " + incoming-pairing + (incoming-verification-code == "" ? "" : " · code " + incoming-verification-code);
                                    color: #fde68a;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                KvmButton {
                                    text: "Allow";
                                    primary: true;
                                    btn-width: 96px;
                                    clicked => { approve-incoming-pairing(incoming-pairing-fingerprint, root.incoming-autoconnect); }
                                }
                                KvmButton {
                                    text: "Deny";
                                    btn-width: 96px;
                                    clicked => { reject-incoming-pairing(incoming-pairing-fingerprint); }
                                }
                            }
                            CheckBox {
                                text: "Auto-connect this computer next time";
                                checked <=> root.incoming-autoconnect;
                            }
                        }
                    }
                    if incoming-link != "" : Rectangle {
                        background: #123a2a;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #22c55e;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Link request · " + incoming-link;
                                    color: #a7f3d0;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                KvmButton {
                                    text: "Allow";
                                    primary: true;
                                    btn-width: 96px;
                                    clicked => { approve-incoming-link(incoming-link-fingerprint, root.incoming-autoconnect); }
                                }
                                KvmButton {
                                    text: "Deny";
                                    btn-width: 96px;
                                    clicked => { reject-incoming-link(incoming-link-fingerprint); }
                                }
                            }
                            CheckBox {
                                text: "Auto-connect this computer next time";
                                checked <=> root.incoming-autoconnect;
                            }
                        }
                    }
                }
            }
            // CB-13 toast: its own zero-cost overlay (same pattern as the
            // approval popups), stacked over the tabs; auto-dismisses in 5s.
            if root.clipboard-toast != "" : Rectangle {
                row: 0;
                col: 0;
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: end;
                        Rectangle {
                            width: 400px;
                            height: 52px;
                            border-radius: 10px;
                            background: #3b2f07;
                            border-width: 1px;
                            border-color: #f59e0b;
                            clip: true;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: center;
                                Text {
                                    text: root.clipboard-toast;
                                    color: #fcd34d;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 8px;
                                    background: toast-hit.has-hover ? Theme.hover : transparent;
                                    toast-hit := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.clipboard-toast = ""; }
                                    }
                                    accessible-role: button;
                                    accessible-label: "Dismiss notification";
                                    Text {
                                        text: "x";
                                        color: Theme.text-2;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Timer {
                                interval: 5s;
                                running: true;
                                triggered => { root.clipboard-toast = ""; }
                            }
                        }
                    }
                }
            }
            // Multi-node grid editor: floating overlay in the tab cell, same
            // pattern as the approval popups (zero layout cost when closed).
            if root.grid-open : Rectangle {
                row: 0; col: 0;
                background: Theme.bg;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Rectangle {
                        height: 30px;
                        Text {
                            text: "Arrange computers  ·  5 x 3 grid  ·  right edge wraps to the left";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            x: parent.width - 34px; y: 1px;
                            width: 30px; height: 28px;
                            border-radius: 8px;
                            background: Theme.surface-2;
                            TouchArea { mouse-cursor: pointer; clicked => { root.close-mesh-grid(); } }
                            Text { text: "x"; color: Theme.text-2; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        if root.mesh-applying : SpinnerArc {
                            x: parent.width - 68px; y: 2px;
                            diameter: 18px;
                            tick: root.spinner-tick;
                        }
                    }
                    Text {
                        text: "Drag a screen into a cell, or select one below then click a cell. Adjacent cells cross into each other.";
                        color: Theme.faint;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        width: 640px;
                        height: 330px;
                        background: Theme.surface-3;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 10px;
                        clip: true;
                        for c in 5 : Rectangle {
                            x: c * 128px; y: 0; width: 1px; height: 100%;
                            background: Theme.border;
                        }
                        for r in 3 : Rectangle {
                            x: 0; y: r * 110px; width: 100%; height: 1px;
                            background: Theme.border;
                        }
                        Text {
                            x: parent.width - 30px; y: parent.height / 2 - 10px;
                            text: "wrap";
                            color: Theme.accent;
                            font-size: 10px;
                            font-weight: 700;
                        }
                        if root.grid-drag != "" || root.grid-pending != "" : Rectangle {
                            x: root.hover-col >= 0 ? root.hover-col * 128px : 0;
                            y: root.hover-row >= 0 ? root.hover-row * 110px : 0;
                            width: 128px; height: 110px;
                            background: Theme.accent-bg;
                            border-width: 2px;
                            border-color: Theme.accent-strong;
                        }
                        for node in root.grid-peers : Rectangle {
                            if node.col >= 0 && node.row >= 0 && node.fingerprint != root.grid-drag : Rectangle {
                                x: node.col * 128px + 8px;
                                y: node.row * 110px + 8px;
                                width: 112px;
                                height: 94px;
                                Rectangle {
                                    width: 112px; height: 62px;
                                    border-radius: 5px;
                                    background: #17171a;
                                    border-width: 1.5px;
                                    border-color: Theme.accent-strong;
                                    Rectangle {
                                        x: 5px; y: 5px;
                                        width: 102px; height: 52px;
                                        border-radius: 3px;
                                        background: Theme.dark ? #1e40af : #3b82f6;
                                        Text {
                                            y: 18px; width: 100%;
                                            text: "▰ ▰ ▱";
                                            color: #dbeafe;
                                            font-size: 10px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                                Rectangle { x: 48px; y: 62px; width: 16px; height: 9px; background: #26262a; }
                                Rectangle { x: 38px; y: 71px; width: 36px; height: 5px; border-radius: 2px; background: #26262a; }
                                Text {
                                    y: 79px; width: 112px;
                                    text: node.name;
                                    color: Theme.text-2;
                                    font-size: 10px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        grid-area := TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    root.grid-cell-down(floor(grid-area.mouse-x / 128px), floor(grid-area.mouse-y / 110px));
                                } else if (event.kind == PointerEventKind.move) {
                                    root.grid-cell-move(clamp(floor(grid-area.mouse-x / 128px), 0, 4), clamp(floor(grid-area.mouse-y / 110px), 0, 2));
                                } else if (event.kind == PointerEventKind.up) {
                                    root.grid-cell-up(clamp(floor(grid-area.mouse-x / 128px), 0, 4), clamp(floor(grid-area.mouse-y / 110px), 0, 2));
                                } else {
                                    root.grid-cell-up(-1, -1);
                                }
                            }
                        }
                    }
                    Text {
                        text: root.grid-pending != "" ? "Now click a cell to place the selected computer" : "Computers (tap to select, or drag from the grid)";
                        color: Theme.faint;
                        font-size: 14px;
                    }
                    Flickable {
                        height: 46px;
                        viewport-width: max(640px, root.grid-peers.length * 110px);
                        HorizontalLayout {
                            spacing: 8px;
                            for node in root.grid-peers : Rectangle {
                                if node.col < 0 : Rectangle {
                                    width: 100px; height: 38px;
                                    border-radius: 8px;
                                    background: root.grid-pending == node.fingerprint ? Theme.accent-panel : Theme.surface-2;
                                    border-width: 1px;
                                    border-color: root.grid-pending == node.fingerprint ? Theme.accent-strong : Theme.border;
                                    TouchArea { mouse-cursor: pointer; clicked => { root.grid-peer-tap(node.fingerprint); } }
                                    Text { text: node.name; color: Theme.text-2; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                }
                            }
                            if root.grid-drag != "" : Rectangle {
                                width: 90px; height: 38px;
                                border-radius: 8px;
                                background: Theme.surface-2;
                                border-width: 1px;
                                border-color: Theme.border;
                                TouchArea { mouse-cursor: pointer; clicked => { root.grid-remove(root.grid-drag); } }
                                Text { text: "Unplace"; color: Theme.text-2; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                    KvmButton {
                        text: root.mesh-applying ? "Applying…" : "Apply to all computers";
                        primary: !root.mesh-applying;
                        enabled: !root.mesh-applying;
                        tooltip: root.mesh-applying ? "The current arrangement is still being applied" : "";
                        clicked => { root.apply-mesh(); }
                    }
                }
            }
        }

            if status-notice != "" : Rectangle {
                height: 28px;
                background: Theme.surface-2;
                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: root.status-notice;
                    color: Theme.faint;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
    }
}



