import { Button, LineEdit, Switch, TabWidget } from "std-widgets.slint";

// TheKVM: Deskflow-simple. The Connect tab is the whole product for most
// users: pick what this computer does, type the other computer's address,
// press Connect. Everything advanced lives under Devices and Settings.
export component AppWindow inherits Window {
    title: "TheKVM " + app-version + title-alert;
    min-width: 720px;
    min-height: 560px;
    background: #0a0a0a;

    in property <string> status-text: "Not connected";
    in property <bool> connected: false;
    in property <string> session-text: "Not connected";
    in property <bool> session-active: false;
    in-out property <string> fingerprint: "…";
    in-out property <string> peer-list: "No trusted computers";
    in-out property <string> linked-peer-name: "";
    in-out property <string> arrangement-text: "No linked screens yet — pair a computer first.";
    in-out property <bool> peer-on-right: true;
    in-out property <bool> edge-active: false;
    in-out property <string> driving-text: "";
    in-out property <string> revoke-fingerprint: "";
    in-out property <string> pending-peer-fingerprint: "";
    in-out property <string> pending-peer-name: "";
    in-out property <string> pending-verification-code: "";
    in-out property <string> incoming-pairing: "";
    in-out property <string> incoming-pairing-fingerprint: "";
    in-out property <string> incoming-verification-code: "";
    in-out property <bool> lock-screen-control: false;
    in-out property <bool> clipboard-enabled: false;
    in-out property <int> mode-index: 0;
    in property <string> role-text: "Both ways";
    in property <string> app-version: "";
    // Taskbar/dock alert: set while an incoming pairing waits, so a
    // minimized window still announces the request.
    in property <string> title-alert: "";
    in property <int> poll-count: 0;
    in-out property <string> layout-path: "";
    in-out property <string> peer-address: "";
    in-out property <string> pair-code: "";
    in property <string> pairing-code: "";
    in-out property <string> discovery-text: "No LAN scan yet";
    in-out property <string> device-name: "";
    in-out property <string> auto-connect-address: "";
    in-out property <string> local-address: "";
    in-out property <string> invite-text: "";
    in-out property <image> invite-qr;
    in-out property <bool> invite-ready: false;
    in-out property <string> invite-input: "";

    callback connect-to(string /* address */, string /* typed station code, may be empty */);
    callback disconnect();
    callback set-role(int /* 0 both, 1 controller, 2 receiver */);
    callback pair-from-invite(string /* invite */);
    callback discover-lan();
    callback start-daemon();
    callback confirm-pairing();
    callback cancel-pairing();
    callback approve-incoming-pairing(string);
    callback reject-incoming-pairing(string);
    callback revoke-peer(string);
    callback swap-sides();
    callback set-edge-mode(bool);
    callback open-log-folder();
    callback apply-config(bool, int, string, string, bool);
    callback import-layout(string);


    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "TheKVM " + app-version;
                font-size: 28px;
                font-weight: 800;
                color: white;
                vertical-alignment: center;
            }
            Rectangle {
                width: 4px;
                height: 28px;
                background: connected ? #22c55e : #ef4444;
            }
            VerticalLayout {
                spacing: 0px;
                Text {
                    text: status-text;
                    color: connected ? #22c55e : #9ca3af;
                    vertical-alignment: center;
                    font-size: 13px;
                }
                Text {
                    text: local-address == "" ? "This computer: detecting…" : "This computer: " + local-address;
                    color: #6b7280;
                    font-size: 11px;
                }
            }
        }

        Rectangle {
            // Approval rendezvous must not depend on which tab is open. A
            // missed incoming request (wrong tab, minimized window) used to
            // be indistinguishable from a broken network — same silence on
            // both ends. This strip is visible on EVERY tab while a request
            // is pending, with the full details under the Connect tab.
            visible: incoming-pairing != "";
            background: #453008;
            border-radius: 8px;
            HorizontalLayout {
                padding: 8px;
                spacing: 12px;
                Text {
                    text: "INCOMING pairing — code " + incoming-verification-code + " (details under Connect tab)";
                    color: #fcd34d;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Button {
                    text: "Allow";
                    primary: true;
                    clicked => { approve-incoming-pairing(incoming-pairing-fingerprint); }
                }
                Button {
                    text: "Deny";
                    clicked => { reject-incoming-pairing(incoming-pairing-fingerprint); }
                }
            }
        }

        TabWidget {
            Tab {
                title: "Connect";
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text { text: "This computer will:"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: "Current role: " + role-text;
                        color: #22c55e;
                        font-size: 14px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        // Role selection is local configuration, not a
                        // daemon-dependent action: these buttons are always
                        // pressable. Gating them on daemon reachability once
                        // made them look permanently dead (no hover, no
                        // click, no feedback) whenever the status poll
                        // failed, with no way to tell why.
                        Button {
                            text: "Control other";
                            clicked => { set-role(1); }
                        }
                        Button {
                            text: "Be controlled";
                            clicked => { set-role(2); }
                        }
                        Button {
                            text: "Both ways";
                            clicked => { set-role(0); }
                        }
                    }
                    Text {
                        text: mode-index == 1 ? "Your keyboard and mouse will drive the other computer." : mode-index == 2 ? "The other computer will drive this keyboard and mouse." : "Both computers can drive each other.";
                        color: #9ca3af;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Linking two computers takes two sides. STATION (waits): choose 'Be controlled' or 'Both ways' and read this computer's address and pairing code above. NODE (dials): choose 'Control other' or 'Both ways', type the station's address and its pairing code, press Connect — no click needed on the station. Without a code, both sides compare the 6-digit code before anything connects. Either side can Disconnect and reconnect at any time.";
                        color: #9ca3af;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text {
                        text: "Your pairing code — the other computer types this instead of waiting for a popup:";
                        color: white;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: pairing-code == "" ? "starting…" : pairing-code;
                        color: #22c55e;
                        font-size: 32px;
                        font-weight: 800;
                        letter-spacing: 6px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Read it over once (phone, chat, sticky note). Whoever types it can pair — no approval click needed here, and it changes every 30 minutes.";
                        color: #9ca3af;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "Other computer's address:"; color: white; font-size: 16px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 12px;
                        addr := LineEdit {
                            text <=> root.peer-address;
                            placeholder-text: "e.g. 192.168.1.7";
                            enabled: !session-active;
                        }
                        Button {
                            text: "Connect";
                            primary: true;
                            visible: !session-active;
                            enabled: addr.text != "";
                            clicked => { connect-to(addr.text, code-field.text); }
                        }
                        Button {
                            text: "Disconnect";
                            visible: session-active;
                            clicked => { disconnect(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        code-field := LineEdit {
                            text <=> root.pair-code;
                            placeholder-text: "code shown on the other computer (recommended — skips its popup)";
                            enabled: !session-active;
                        }
                    }
                    Text {
                        text: session-text;
                        color: session-active ? #22c55e : #9ca3af;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    Text {
                        visible: driving-text != "";
                        text: driving-text;
                        color: #22c55e;
                        font-size: 13px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        visible: !session-active;
                        Button {
                            text: edge-active ? "Stop edge control" : "Start edge control";
                            primary: true;
                            clicked => { set-edge-mode(!edge-active); }
                        }
                    }
                    Text {
                        text: "Connect (above) is full takeover: the other computer gets your whole keyboard and mouse until Disconnect. Edge control keeps both computers usable — only cursor crossings move control, and pushing back returns it.";
                        color: #9ca3af;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Button {
                        visible: !connected;
                        text: "Start background service";
                        clicked => { start-daemon(); }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    VerticalLayout {
                        spacing: 6px;
                        visible: pending-verification-code != "";
                        Text {
                            text: "OUTGOING — you are calling the other computer:";
                            color: #f59e0b;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Does " + (pending-peer-name == "" ? "the other computer" : pending-peer-name) + " show this same code?";
                            color: white;
                            font-size: 15px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            text: pending-verification-code;
                            color: #22c55e;
                            font-size: 32px;
                            font-weight: 800;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "The other computer shows this request under its own INCOMING section — compare the codes, press Allow there, then confirm here to connect.";
                            color: #9ca3af;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            Button {
                                text: "Codes match — connect";
                                primary: true;
                                clicked => { confirm-pairing(); }
                            }
                            Button {
                                text: "Cancel";
                                clicked => { cancel-pairing(); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        // Both directions must be visible SIMULTANEOUSLY. This
                        // used to hide while our own outgoing code check was
                        // open — so when both computers pressed Connect, each
                        // side showed only its outgoing screen and neither
                        // could ever approve the other: a mutual-blindness
                        // deadlock with both users staring at unanswerable
                        // code screens until everything timed out.
                        visible: incoming-pairing != "";
                        Text {
                            text: "INCOMING — the other computer is calling you:";
                            color: #f59e0b;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: "A computer wants to connect: " + incoming-pairing;
                            color: white;
                            font-size: 15px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            visible: incoming-verification-code != "";
                            text: incoming-verification-code;
                            color: #22c55e;
                            font-size: 32px;
                            font-weight: 800;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            Button {
                                text: "Allow";
                                primary: true;
                                clicked => { approve-incoming-pairing(incoming-pairing-fingerprint); }
                            }
                            Button {
                                text: "Deny";
                                clicked => { reject-incoming-pairing(incoming-pairing-fingerprint); }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Devices";
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text { text: "Find on my network"; color: white; font-size: 16px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 12px;
                        Button { text: "Scan network"; clicked => { discover-lan(); } }
                        Text {
                            text: discovery-text;
                            color: #9ca3af;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "Share this computer"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: "The other computer scans this code or pastes the invite text instead of typing your address. Connecting still asks both sides to compare the code.";
                        color: #9ca3af;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        Rectangle {
                            width: 200px;
                            height: 200px;
                            background: white;
                            border-radius: 8px;
                            Image {
                                x: 8px; y: 8px;
                                width: 184px; height: 184px;
                                visible: invite-ready;
                                source: root.invite-qr;
                                image-fit: contain;
                            }
                            Text {
                                visible: !invite-ready;
                                text: "Start the app to generate the invite";
                                color: #6b7280;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            Text { text: "Invite text (copy from here):"; color: #9ca3af; font-size: 12px; }
                            shown := LineEdit {
                                text: root.invite-text;
                                read-only: true;
                                placeholder-text: "invite appears when the app is ready";
                            }
                        }
                    }
                    Text { text: "Connect from an invite"; color: white; font-size: 16px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 12px;
                        pasted := LineEdit {
                            text <=> root.invite-input;
                            placeholder-text: "paste thekvm:// invite";
                        }
                        Button {
                            text: "Connect";
                            primary: true;
                            enabled: pasted.text != "";
                            clicked => { pair-from-invite(pasted.text); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "Trusted computers"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: peer-list;
                        color: #9ca3af;
                        font-size: 11px;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        revoke := LineEdit {
                            text <=> root.revoke-fingerprint;
                            placeholder-text: "fingerprint to remove";
                        }
                        Button {
                            text: "Remove";
                            enabled: revoke.text != "";
                            clicked => { revoke-peer(revoke.text); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "Linked screens (edge control)"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: arrangement-text;
                        color: #9ca3af;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    // Screen icons with names: this computer and the linked
                    // peer, placed left/right as arranged. The exit edge is
                    // the facing edge — the outer edges do nothing.
                    HorizontalLayout {
                        spacing: 12px;
                        visible: peer-on-right;
                        Rectangle {
                            width: 130px;
                            height: 92px;
                            background: #14532d;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: #22c55e;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                Text { text: "THIS PC"; color: #bbf7d0; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: device-name == "" ? "…" : device-name; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                            }
                        }
                        Text { text: "▶"; color: #22c55e; font-size: 20px; font-weight: 800; vertical-alignment: center; }
                        Rectangle {
                            width: 130px;
                            height: 92px;
                            background: #1c1917;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: #57534e;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                Text { text: "LINKED"; color: #d6d3d1; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: linked-peer-name == "" ? "…" : linked-peer-name; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        visible: !peer-on-right;
                        Rectangle {
                            width: 130px;
                            height: 92px;
                            background: #1c1917;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: #57534e;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                Text { text: "LINKED"; color: #d6d3d1; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: linked-peer-name == "" ? "…" : linked-peer-name; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                            }
                        }
                        Text { text: "◀"; color: #22c55e; font-size: 20px; font-weight: 800; vertical-alignment: center; }
                        Rectangle {
                            width: 130px;
                            height: 92px;
                            background: #14532d;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: #22c55e;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                Text { text: "THIS PC"; color: #bbf7d0; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: device-name == "" ? "…" : device-name; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Button {
                            text: "Swap sides";
                            enabled: linked-peer-name != "";
                            clicked => { swap-sides(); }
                        }
                        Button {
                            text: edge-active ? "Stop edge control" : "Start edge control";
                            primary: true;
                            enabled: linked-peer-name != "";
                            clicked => { set-edge-mode(!edge-active); }
                        }
                    }
                    Text {
                        visible: driving-text != "";
                        text: driving-text;
                        color: #22c55e;
                        font-size: 13px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                }
            }

            Tab {
                title: "Settings";
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text { text: "Computer name"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: "The name nearby computers see.";
                        color: #9ca3af;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        name := LineEdit {
                            text <=> root.device-name;
                            placeholder-text: "friendly name";
                        }
                        Button {
                            text: "Save";
                            enabled: name.text != "";
                            clicked => { apply-config(lock-screen-control, mode-index, name.text, auto-connect-address, clipboard-enabled); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Control login and lock screens";
                            color: #d1d5db;
                            vertical-alignment: center;
                        }
                        Switch {
                            checked <=> root.lock-screen-control;
                            toggled => { apply-config(root.lock-screen-control, root.mode-index, root.device-name, root.auto-connect-address, root.clipboard-enabled); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Sync text clipboard";
                            color: #d1d5db;
                            vertical-alignment: center;
                        }
                        Switch {
                            checked <=> root.clipboard-enabled;
                            toggled => { apply-config(root.lock-screen-control, root.mode-index, root.device-name, root.auto-connect-address, root.clipboard-enabled); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text {
                        text: "Reconnect at startup to (optional)";
                        color: white;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        startup := LineEdit {
                            text <=> root.auto-connect-address;
                            placeholder-text: "computer IP or hostname:42110";
                        }
                        Button {
                            text: "Save";
                            clicked => { apply-config(lock-screen-control, mode-index, device-name, startup.text, clipboard-enabled); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "Screen layout file"; color: white; font-size: 16px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 12px;
                        path := LineEdit {
                            text <=> root.layout-path;
                            placeholder-text: "path to layout.json";
                        }
                        Button {
                            text: "Import";
                            enabled: path.text != "";
                            clicked => { import-layout(path.text); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "This computer's fingerprint:"; color: #9ca3af; font-size: 12px; }
                    Text { text: fingerprint; color: #ef4444; font-size: 12px; }
                    Rectangle { height: 1px; background: #262626; }
                    Text {
                        text: "Background updates: " + poll-count + " (grows every few seconds while the app talks to its background service)";
                        color: #6b7280;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Button {
                        text: "Open log folder";
                        clicked => { open-log-folder(); }
                    }
                }
            }
        }
    }
}
