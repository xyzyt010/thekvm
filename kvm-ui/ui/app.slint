import { Button, ComboBox, LineEdit, Palette, Switch, TabWidget } from "std-widgets.slint";

// ---------------------------------------------------------------------
// One loading language: a donut of arc + track, rotating smoothly with
// the shared monotonic spinner tick. Every waiting state (scan, connect
// warm-up, edge-mode apply) uses exactly this, at the size and colours
// its context needs. Drawn rather than font-based so Windows and Linux
// render identical pixels.
// ---------------------------------------------------------------------
component SpinnerArc inherits Rectangle {
    in property <length> diameter: 18px;
    in property <color> arc-color: #22c55e;
    in property <color> track-color: #14532d;
    in property <int> tick: 0;
    width: diameter;
    height: diameter;
    background: transparent;
    // Full-circle track under the moving arc.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: track-color;
        stroke-width: 3.2px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 12 3 A 9 9 0 1 1 12 21 A 9 9 0 1 1 12 3";
    }
    // 270° arc: one step of 45° per 90ms tick, animated across the gap
    // so the motion never stops between steps.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: arc-color;
        stroke-width: 3.2px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 12 3 A 9 9 0 1 1 3 12";
        transform-rotation: root.tick * 45deg;
        animate transform-rotation { duration: 130ms; easing: linear; }
    }
}

// Drawn chevron (no font glyph): points down; rotates 180° when open.
component ChevronGlyph inherits Rectangle {
    in property <bool> open: false;
    in property <color> glyph-color: #9ca3af;
    width: 14px;
    height: 14px;
    background: transparent;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: root.glyph-color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 2.5 4.5 L 6 8 L 9.5 4.5";
        transform-rotation: root.open ? 180deg : 0deg;
        animate transform-rotation { duration: 160ms; easing: ease-out; }
    }
}

// Close (hide the card): a real cross, no button chrome.
component CloseButton inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: hit.has-hover && enabled ? #1f2937 : transparent;
    opacity: enabled ? 1 : 0.45;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    accessible-role: button;
    accessible-label: "Hide nearby devices";
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Path {
        x: 7px;
        y: 7px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: hit.has-hover && enabled ? #e5e7eb : #9ca3af;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        commands: "M 1 1 L 11 11 M 11 1 L 1 11";
    }
}

// Rescan: the refresh arrow, replaced by the shared donut while a scan
// runs, so the button itself shows the work in progress.
component RescanButton inherits Rectangle {
    in property <bool> scanning: false;
    in property <bool> enabled: true;
    in property <int> tick: 0;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: hit.has-hover && enabled && !scanning ? #1f2937 : transparent;
    opacity: enabled ? 1 : 0.45;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled && !root.scanning) { root.clicked(); } }
    }
    accessible-role: button;
    accessible-label: scanning ? "Scanning for nearby devices" : "Rescan for nearby devices";
    accessible-action-default => { if (root.enabled && !root.scanning) { root.clicked(); } }
    if !scanning : Path {
        // Standard refresh shape: a circular arrow with a solid head.
        x: 5px;
        y: 5px;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: hit.has-hover && enabled ? #e5e7eb : #9ca3af;
        commands: "M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-8 8s3.57 8 8 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z";
    }
    if scanning : SpinnerArc {
        x: 5px;
        y: 5px;
        diameter: 16px;
        tick: root.tick;
    }
}

// ---------------------------------------------------------------------
// The arrangement is drawn as actual monitors: bezel, screen, neck and
// base. Exit edges light green on this computer; entry edges light teal
// on the linked one, so the crossing discipline is visible on the same
// picture the user assembles.
// ---------------------------------------------------------------------
component MonitorCard inherits Rectangle {
    in property <string> title: "THIS PC";
    in property <string> name: "";
    in property <bool> local: false;
    in property <bool> exit-left: false;
    in property <bool> exit-right: false;
    in property <bool> enter-left: false;
    in property <bool> enter-right: false;
    in property <bool> hovered: false;
    in property <bool> dragging: false;
    in property <bool> dimmed: false;
    // Steps fully aside while its dragged copy is on screen.
    in property <bool> hidden: false;
    // True while the linked computer is live right now; the mesh passes the
    // link state down. False dims the card, border and power LED.
    in property <bool> powered: true;
    // Briefly true on a handoff: the lit edge bars flash brighter.
    in property <bool> crossing-pulse: false;
    // Fixed size: a min-width alone lets a layout inflate the card past its
    // drawn frame, which pushed the stand off-centre.
    width: 160px;
    height: 118px;
    background: transparent;
    opacity: root.hidden ? 0 : (dimmed ? 0.55 : 1);
    body := Rectangle {
        y: 2px;
        // Explicit width, not 100%: a percentage here makes the card's own
        // preferred width circular and the layout inflates it.
        width: 160px;
        height: 98px;
        background: #17171a;
        border-radius: 9px;
        border-width: 1.5px;
        border-color: root.local ? (root.hovered || root.dragging ? #4ade80 : (root.powered ? #22c55e : #57534e)) : (root.hovered || root.dragging ? #a8a29e : (root.powered ? #5eead4 : #3f3f46));
        drop-shadow-color: #00000088;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;
        Rectangle {
            x: 7px;
            y: 7px;
            // Every size inside the card is explicit: a percentage here
            // (parent.width ...) makes the card's own preferred width
            // circular, and the layout then inflates the card far past its
            // drawn frame.
            width: 146px;
            height: 80px;
            background: root.local
                ? @linear-gradient(180deg, #0e2a1c 0%, #08150e 100%)
                : @linear-gradient(180deg, #141414 0%, #0a0a0a 100%);
            border-radius: 4px;
            // Exit bars (this computer) and entry bars (linked computer).
            if root.exit-left : Rectangle { x: 0; y: 12px; width: 3px; height: 52px; border-radius: 2px; background: root.crossing-pulse ? #86efac : #22c55e; }
            if root.exit-right : Rectangle { x: 143px; y: 12px; width: 3px; height: 52px; border-radius: 2px; background: root.crossing-pulse ? #86efac : #22c55e; }
            if root.enter-left : Rectangle { x: 0; y: 12px; width: 3px; height: 52px; border-radius: 2px; background: root.crossing-pulse ? #99f6e4 : #5eead4; }
            if root.enter-right : Rectangle { x: 143px; y: 12px; width: 3px; height: 52px; border-radius: 2px; background: root.crossing-pulse ? #99f6e4 : #5eead4; }
            // Tiny direction chevrons beside the lit edges.
            if root.exit-left : Path { x: 7px; y: 35px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; stroke: #22c55e; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round; fill: transparent; commands: "M 8 2 L 3 5 L 8 8"; }
            if root.exit-right : Path { x: 129px; y: 35px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; stroke: #22c55e; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round; fill: transparent; commands: "M 2 2 L 7 5 L 2 8"; }
            if root.enter-left : Path { x: 7px; y: 35px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; stroke: #5eead4; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round; fill: transparent; commands: "M 3 2 L 8 5 L 3 8"; }
            if root.enter-right : Path { x: 129px; y: 35px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; stroke: #5eead4; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round; fill: transparent; commands: "M 8 2 L 3 5 L 8 8"; }
            Text {
                x: 10px;
                y: 6px;
                width: 126px;
                text: root.title;
                color: root.local ? #6ee7b7 : #78716c;
                font-size: 8px;
                font-weight: 800;
                letter-spacing: 1.2px;
                horizontal-alignment: center;
            }
            Text {
                x: 10px;
                y: 37px;
                width: 126px;
                text: root.name == "" ? "…" : root.name;
                color: white;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        // Power LED.
        Rectangle {
            x: 78px;
            y: parent.height - 6px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: root.powered ? (root.local ? #22c55e : #2dd4bf) : #44403c;
        }
    }
    // Stand neck and base. The card is a fixed 160px wide, so the stand is
    // centred on that constant: deriving it from parent.width would make
    // the card's width depend on the stand's position - a circular
    // reference Slint cannot solve, which collapsed the card entirely.
    Rectangle { x: 72px; y: 100px; width: 16px; height: 9px; background: #26262a; }
    Rectangle { x: 56px; y: 109px; width: 48px; height: 4px; border-radius: 2px; background: #26262a; }
}

// One tap swaps the two screens. The press gets a short green flash and
// nothing stays highlighted afterwards: the monitor positions themselves
// already show the current arrangement, and a sticky highlight reads as a
// toggle that never clears.
component ChevronButton inherits Rectangle {
    in property <bool> points-left: true;
    in property <bool> flash: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: root.flash ? #14532d : (hit.has-hover && enabled ? #1f2937 : transparent);
    border-width: 1px;
    border-color: root.flash ? #22c55e : #374151;
    opacity: enabled ? 1 : 0.4;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    accessible-role: button;
    accessible-label: points-left ? "Move the linked computer to the left" : "Move the linked computer to the right";
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Path {
        x: 10px;
        y: 10px;
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: root.flash ? #22c55e : (hit.has-hover && enabled ? #e5e7eb : #9ca3af);
        stroke-width: 2.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: points-left ? "M 11 3 L 5.5 9 L 11 15" : "M 7 3 L 12.5 9 L 7 15";
    }
}

// The mesh: this computer and the linked computer as two monitors, with
// the exit/entry edges lit. The linked monitor is draggable: it follows
// the pointer, a magnetic target lights up on the side it would land,
// and releasing it there swaps the placement. Double-clicking either
// monitor swaps too. Chevrons remain for a single precise tap.
component ArrangementMesh inherits Rectangle {
    in property <string> local-name: "";
    in property <string> peer-name: "";
    in property <bool> peer-on-right: true;
    in property <bool> enabled: false;
    in property <int> edge-mode: 0;
    // Live link state and a brief pulse on each handoff, passed through to
    // the cards and arrows.
    in property <bool> link-live: false;
    in property <bool> crossing-pulse: false;
    // Roles of this computer and the linked computer: they decide where the
    // arrow heads sit, exactly as in the crossing-edge illustrations.
    in property <int> our-mode: 0;
    in property <int> peer-mode: 0;
    callback to-left();
    callback to-right();

    height: 166px;
    background: #0d1117;
    border-radius: 12px;
    border-width: 1px;
    border-color: #1f2937;

    property <length> margin: 52px;
    property <length> card-w: 160px;
    property <length> card-y: 32px;
    property <length> card-h: 118px;

    // Every internal position is derived from the mesh's OWN rendered width
    // (parent.width from a child's point of view, self.width from here).
    // root.width is the declared width; the panel can render narrower than
    // declared when the tab column is tight, and cards placed from the
    // declared width then land outside the visible panel.
    property <length> inner-w: self.width;

    property <length> local-x: root.peer-on-right ? root.margin : root.inner-w - root.margin - root.card-w;
    property <length> peer-x: root.peer-on-right ? root.inner-w - root.margin - root.card-w : root.margin;
    property <length> slot-distance: root.inner-w - 2 * root.margin - root.card-w;
    property <length> drag-limit: root.slot-distance + 24px;
    property <length> drag-start-abs: 0px;
    in-out property <bool> dragging: false;
    in-out property <bool> dragging-local: false;
    in-out property <length> drag-dx: 0px;
    // A drop on the other side holds its dragged position until the
    // placement is confirmed upstream, then snaps magnetically into the
    // new slot - no rubber-band back to the old one first.
    in-out property <bool> flip-pending: false;
    in-out property <bool> flip-right: false;
    // Which chevron is flashing (0 = left, 1 = right, -1 = none). A press
    // lights the arrow for a moment and then clears: no sticky highlight
    // is left behind on the last pressed arrow.
    in-out property <int> flash-side: -1;
    function press_side(side: int) {
        root.flash-side = side;
        if (side == 1) { root.to-right(); } else { root.to-left(); }
    }
    Timer {
        interval: 450ms;
        running: root.flash-side >= 0;
        triggered => { root.flash-side = -1; }
    }
    changed peer-on-right => {
        if (root.flip-pending && root.peer-on-right == root.flip-right) {
            root.flip-pending = false;
            root.drag-dx = 0px;
        }
    }
    property <bool> will-land-right: root.peer-x + root.drag-dx + root.card-w / 2 > root.inner-w / 2;
    Timer {
        interval: 1500ms;
        running: root.flip-pending;
        triggered => {
            // The placement never landed: return the screen to truth.
            if (root.peer-on-right != root.flip-right) {
                root.flip-pending = false;
                root.drag-dx = 0px;
            }
        }
    }

    // Exit edges are this computer's way OUT and entry edges are the linked
    // computer's way IN: hidden under the role that forbids that direction.
    // ("Be controlled only" never leaves this machine; "Control other only"
    // never lets the other one in.)
    property <bool> exit-left: root.our-mode != 2 && (root.edge-mode != 0 || !root.peer-on-right);
    property <bool> exit-right: root.our-mode != 2 && (root.edge-mode != 0 || root.peer-on-right);
    property <bool> enter-left: root.our-mode != 1 && (root.edge-mode == 1 || root.edge-mode == 2 || (root.edge-mode == 0 && root.peer-on-right));
    property <bool> enter-right: root.our-mode != 1 && (root.edge-mode == 1 || root.edge-mode == 3 || (root.edge-mode == 0 && !root.peer-on-right));

    // ---- Roles, carried by the arrow heads -------------------------
    property <bool> we-may-drive: root.our-mode == 0 || root.our-mode == 1;
    property <bool> we-may-be-driven: root.our-mode == 0 || root.our-mode == 2;
    property <bool> peer-may-drive: root.peer-mode == 0 || root.peer-mode == 1;
    property <bool> peer-may-be-driven: root.peer-mode == 0 || root.peer-mode == 2;
    // A sharp head sits on the machine being DRIVEN and the blunt side on
    // the machine doing the driving: both ways gets a head on both ends.
    property <bool> head-at-peer: root.we-may-drive && root.peer-may-be-driven;
    property <bool> head-at-our: root.peer-may-drive && root.we-may-be-driven;

    // ---- Where the two cards actually are right now ----------------
    // A drag nudges the grabbed monitor, so the arrows follow the card they
    // start or end on rather than its resting slot.
    property <length> our-cur-x: root.local-x + ((root.dragging-local && root.dragging) ? root.drag-dx : 0px);
    property <length> peer-cur-x: root.peer-x + ((root.dragging || root.flip-pending) ? root.drag-dx : 0px);
    property <length> our-l: root.our-cur-x;
    property <length> our-r: root.our-cur-x + root.card-w;
    property <length> peer-l: root.peer-cur-x;
    property <length> peer-r: root.peer-cur-x + root.card-w;
    // Bar centres inside a monitor card (the source of every colored bar):
    // the lit bars sit 7px inside the card (left edge of the screen area)
    // or 7px+143px+3px/2 (right edge). Every arrow endpoint lands on the
    // exact bar it connects, so an arrow never overshoots the frame it
    // joins (an earlier version ran card-edge to card-edge and stuck out
    // past both monitors' bezels).
    property <length> our-bar-l: root.our-cur-x + 8.5px;
    property <length> our-bar-r: root.our-cur-x + 151.5px;
    property <length> peer-bar-l: root.peer-cur-x + 8.5px;
    property <length> peer-bar-r: root.peer-cur-x + 151.5px;


    // Chevron row: a plain Rectangle does not stretch its children, so the
    // row is given the mesh's own width explicitly rather than a stretch
    // factor (which had no effect here and dropped the right chevron off).
    HorizontalLayout {
        x: 0;
        y: root.card-y;
        width: root.inner-w;
        height: root.card-h;
        spacing: 6px;
        ChevronButton {
            width: 38px;
            height: 38px;
            vertical-stretch: 0;
            points-left: true;
            flash: root.flash-side == 0;
            enabled: root.enabled;
            clicked => { root.press_side(0); }
        }
        Rectangle { horizontal-stretch: 1; }
        ChevronButton {
            width: 38px;
            height: 38px;
            vertical-stretch: 0;
            points-left: false;
            flash: root.flash-side == 1;
            enabled: root.enabled;
            clicked => { root.press_side(1); }
        }
    }

    // The two monitors, placed from the mesh's rendered width and animated:
    // a drag nudges the grabbed monitor, a confirmed swap slides it into the
    // other slot.
    local := MonitorCard {
        x: root.local-x + ((root.dragging-local && root.dragging) ? root.drag-dx : 0px);
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        title: "THIS PC";
        name: root.local-name;
        local: true;
        exit-left: root.enabled && root.exit-left;
        exit-right: root.enabled && root.exit-right;
        powered: root.link-live;
        crossing-pulse: root.crossing-pulse;
        animate x { duration: root.dragging ? 0ms : 200ms; easing: ease-in-out; }
    }
    peer := MonitorCard {
        x: root.peer-x + (root.dragging || root.flip-pending ? root.drag-dx : 0px);
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        title: "LINKED";
        name: root.enabled ? (root.peer-name == "" ? "Linked PC" : root.peer-name) : "Not linked";
        local: false;
        enter-left: root.enabled && root.enter-left;
        enter-right: root.enabled && root.enter-right;
        hovered: drag-area.has-hover;
        dragging: root.dragging;
        dimmed: !root.enabled;
        powered: root.link-live;
        crossing-pulse: root.crossing-pulse;
        animate x { duration: root.dragging ? 0ms : 200ms; easing: ease-in-out; }
    }
    // ---- The crossing arrows ---------------------------------------
    // Both arrows are dead straight and parallel to each other. The short
    // one joins the two edges that FACE each other (this computer's right
    // edge to the linked computer's left edge); the long one joins this
    // computer's LEFT edge to the linked computer's RIGHT edge, so it runs
    // the full span of the pair underneath both screens. Two connected
    // edges, two arrows, and the second is visibly the longer route.
    property <length> our-facing-x: root.peer-on-right ? root.our-bar-r : root.our-bar-l;
    property <length> our-far-x: root.peer-on-right ? root.our-bar-l : root.our-bar-r;
    property <length> peer-facing-x: root.peer-on-right ? root.peer-bar-l : root.peer-bar-r;
    // The peer edge the second arrow lands on: Mirror takes the far edge,
    // the fixed disciplines take their pinned edge whatever side the card
    // sits on.
    property <length> entry-x:
        root.edge-mode == 2 ? root.peer-bar-l
        : root.edge-mode == 3 ? root.peer-bar-r
        : (root.peer-on-right ? root.peer-bar-r : root.peer-bar-l);
    property <float> near-x1: root.our-facing-x / 1px;
    property <float> near-x2: root.peer-facing-x / 1px;
    property <float> far-x1: root.our-far-x / 1px;
    property <float> far-x2: root.entry-x / 1px;
    // Single draws ONE arrow, and it runs dead straight through the
    // vertical middle of the screens; the double disciplines keep their
    // staggered two-arrow pair.
    property <int> y-near: root.edge-mode == 0 ? root.card-y / 1px + 49 : root.card-y / 1px + 38;
    property <int> y-far: root.card-y / 1px + 60;
    property <bool> near-right: root.near-x1 < root.near-x2;
    property <bool> far-right: root.far-x1 < root.far-x2;

    property <string> near-line: "M \{root.near-x1} \{root.y-near} L \{root.near-x2} \{root.y-near}";
    // Head on THIS computer's end of the short arrow.
    property <string> near-our-head: root.near-right
        ? "M \{root.near-x1 + 5} \{root.y-near - 2.5} L \{root.near-x1} \{root.y-near} L \{root.near-x1 + 5} \{root.y-near + 2.5}"
        : "M \{root.near-x1 - 5} \{root.y-near - 2.5} L \{root.near-x1} \{root.y-near} L \{root.near-x1 - 5} \{root.y-near + 2.5}";
    // Head on the linked computer's end of the short arrow.
    property <string> near-peer-head: root.near-right
        ? "M \{root.near-x2 - 5} \{root.y-near - 2.5} L \{root.near-x2} \{root.y-near} L \{root.near-x2 - 5} \{root.y-near + 2.5}"
        : "M \{root.near-x2 + 5} \{root.y-near - 2.5} L \{root.near-x2} \{root.y-near} L \{root.near-x2 + 5} \{root.y-near + 2.5}";

    property <string> far-line: "M \{root.far-x1} \{root.y-far} L \{root.far-x2} \{root.y-far}";
    // Head on THIS computer's left-edge end of the long arrow.
    property <string> far-our-head: root.far-right
        ? "M \{root.far-x1 + 5} \{root.y-far - 2.5} L \{root.far-x1} \{root.y-far} L \{root.far-x1 + 5} \{root.y-far + 2.5}"
        : "M \{root.far-x1 - 5} \{root.y-far - 2.5} L \{root.far-x1} \{root.y-far} L \{root.far-x1 - 5} \{root.y-far + 2.5}";
    // Head on the linked computer's end of the long arrow.
    property <string> far-peer-head: root.far-right
        ? "M \{root.far-x2 - 5} \{root.y-far - 2.5} L \{root.far-x2} \{root.y-far} L \{root.far-x2 - 5} \{root.y-far + 2.5}"
        : "M \{root.far-x2 + 5} \{root.y-far - 2.5} L \{root.far-x2} \{root.y-far} L \{root.far-x2 + 5} \{root.y-far + 2.5}";

    // The short arrow: the facing-edge crossing. Hidden until a peer is
    // linked, exactly like the lit edges themselves.
    if root.enabled : Path {
        x: 0;
        y: 0;
        width: root.inner-w;
        height: 166px;
        viewbox-width: max(1, root.inner-w / 1px);
        viewbox-height: 166;
        stroke: root.crossing-pulse ? #a7f3d0 : #22c55e;
        stroke-width: root.crossing-pulse ? 3px : 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.near-line
            + (root.head-at-peer ? root.near-peer-head : "")
            + (root.head-at-our ? root.near-our-head : "");
    }
    // The long arrow: the second crossing. Only a double discipline has
    // one, and it is visibly the longer route of the two.
    if root.enabled && root.edge-mode != 0 : Path {
        x: 0;
        y: 0;
        width: root.inner-w;
        height: 166px;
        viewbox-width: max(1, root.inner-w / 1px);
        viewbox-height: 166;
        stroke: root.crossing-pulse ? #99f6e4 : #5eead4;
        stroke-width: root.crossing-pulse ? 3px : 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.far-line
            + (root.head-at-peer ? root.far-peer-head : "")
            + (root.head-at-our ? root.far-our-head : "");
    }
    // The linked monitor is draggable: it follows the pointer and lands on
    // the side it is released on.
    drag-area := TouchArea {
        x: root.peer-x + (root.dragging || root.flip-pending ? root.drag-dx : 0px);
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? (root.dragging ? grabbing : grab) : default;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.flip-pending = false;
                root.dragging = true;
                root.drag-start-abs = self.absolute-position.x + self.mouse-x;
                root.drag-dx = 0px;
            } else if (event.kind == PointerEventKind.move && root.dragging) {
                root.drag-dx = max(-root.drag-limit, min(root.drag-limit, (self.absolute-position.x + self.mouse-x) - root.drag-start-abs));
            } else if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && root.dragging) {
                root.dragging = false;
                let want-right = root.will-land-right;
                if (want-right != root.peer-on-right) {
                    root.flip-pending = true;
                    root.flip-right = want-right;
                    if (want-right) {
                        root.to-right();
                    } else {
                        root.to-left();
                    }
                } else {
                    root.drag-dx = 0px;
                }
            }
        }
        double-clicked => {
            if (root.peer-on-right) { root.to-left(); } else { root.to_right(); }
        }
        animate x { duration: root.dragging ? 0ms : 200ms; easing: ease-in-out; }
    }
    // The local monitor is draggable too: pushing THIS PC across the middle
    // is the same swap as pulling the linked PC the other way, so the
    // gesture feels symmetric on both halves of the pair.
    local-drag-area := TouchArea {
        x: root.local-x;
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? (root.dragging ? grabbing : grab) : default;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.flip-pending = false;
                root.dragging = true;
                root.drag-start-abs = self.absolute-position.x + self.mouse_x;
                root.drag-dx = 0px;
                root.dragging-local = true;
            } else if (event.kind == PointerEventKind.move && root.dragging && root.dragging-local) {
                root.drag-dx = max(-root.drag-limit, min(root.drag-limit, (self.absolute-position.x + self.mouse_x) - root.drag-start-abs));
            } else if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && root.dragging && root.dragging-local) {
                root.dragging = false;
                root.dragging-local = false;
                // Dragging the local card to the right puts the peer on the
                // left, and vice versa.
                let want-right = root.local-x + root.drag-dx + root.card-w / 2 > root.inner-w / 2;
                if (want-right != root.peer-on-right) {
                    root.flip-pending = true;
                    root.flip-right = want-right;
                    if (want-right) {
                        root.to_right();
                    } else {
                        root.to_left();
                    }
                } else {
                    root.drag-dx = 0px;
                }
            }
        }
        double-clicked => {
            if (root.peer-on-right) { root.to-left(); } else { root.to-right(); }
        }
        animate x { duration: root.dragging ? 0ms : 200ms; easing: ease-in-out; }
    }    // Magnetic landing slot while dragging.
    if root.dragging : Rectangle {
        x: root.will-land-right ? root.inner-w - root.margin - root.card-w : root.margin;
        y: root.card-y;
        width: root.card-w;
        height: root.card-h;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: root.will-land-right == root.peer-on-right ? #22c55e33 : #22c55e;
        background: #22c55e10;
    }
}

// Schematic crossing diagram for one discipline: green bars are exit
// edges on this computer, teal bars are entry edges on the linked one.
component EdgeModeDiagram inherits Rectangle {
    in property <int> mode: 0;
    in property <int> our-mode: 0;
    in property <int> peer-mode: 0;
    width: 142px;
    height: 66px;
    background: transparent;

    // ---- What each COMPUTER allows ------------------------------
    property <bool> we-may-drive: root.our-mode == 0 || root.our-mode == 1;
    property <bool> we-may-be-driven: root.our-mode == 0 || root.our-mode == 2;
    property <bool> peer-may-drive: root.peer-mode == 0 || root.peer-mode == 1;
    property <bool> peer-may-be-driven: root.peer-mode == 0 || root.peer-mode == 2;
    property <bool> forward-ok: root.we-may-drive && root.peer-may-be-driven;
    property <bool> backward-ok: root.peer-may-drive && root.we-may-be-driven;
    // The sharp head sits on the machine being DRIVEN (the client); the
    // blunt side is the machine doing the driving (the server). "Both ways"
    // puts a head on both ends of every arrow.
    property <bool> head-at-peer: root.forward-ok;
    property <bool> head-at-our: root.backward-ok;

    // ---- Geometry ------------------------------------------------
    // The tiles draw the CURRENT arrangement (the linked computer on the
    // side the user arranged), not a baked-in mirrored scene: what must
    // match reality is where the pinned entry edge is, so each discipline
    // always visibly agrees with the arrangement shown above it.
    in property <bool> peer-on-right: true;
    property <length> mon-w: 36px;
    property <length> our-x: root.peer-on-right ? 6px : 96px;
    property <length> peer-x: root.peer-on-right ? 96px : 6px;
    property <length> our-l: root.our-x;
    property <length> our-r: root.our-x + root.mon-w;
    property <length> peer-l: root.peer-x;
    property <length> peer-r: root.peer-x + root.mon-w;

    // ---- The two monitors ----------------------------------------
    Rectangle { x: root.our-x; y: 6px; width: root.mon-w; height: 28px; background: #17171a; border-radius: 4px; border-width: 1px; border-color: #22c55e; }
    Rectangle { x: root.our-x + 3px; y: 9px; width: root.mon-w - 6px; height: 22px; background: #0b1f14; border-radius: 2px; }
    Rectangle { x: root.peer-x; y: 6px; width: root.mon-w; height: 28px; background: #17171a; border-radius: 4px; border-width: 1px; border-color: #57534e; }
    Rectangle { x: root.peer-x + 3px; y: 9px; width: root.mon-w - 6px; height: 22px; background: #101010; border-radius: 2px; }

    // ---- The connected edges, lit --------------------------------
    // Exits on THIS computer: the facing edge always, the far edge too in
    // every double discipline.
    Rectangle { x: root.peer-on-right ? root.our-r - 1.5px : root.our-l - 1.5px; y: 12px; width: 3px; height: 16px; border-radius: 1.5px; background: #22c55e; }
    if root.mode != 0 : Rectangle { x: root.peer-on-right ? root.our-l - 1.5px : root.our-r - 1.5px; y: 12px; width: 3px; height: 16px; border-radius: 1.5px; background: #22c55e; }
    // Entries on the linked computer: the facing edge always, the far edge
    // only in Mirror, whose entry is the inverse of the exit.
    Rectangle { x: root.peer-on-right ? root.peer-l - 1.5px : root.peer-r - 1.5px; y: 12px; width: 3px; height: 16px; border-radius: 1.5px; background: #5eead4; }
    if root.mode == 1 : Rectangle { x: root.peer-on-right ? root.peer-r - 1.5px : root.peer-l - 1.5px; y: 12px; width: 3px; height: 16px; border-radius: 1.5px; background: #5eead4; }

    // ---- The crossing arrows -------------------------------------
    // Both arrows are dead straight and parallel.
    //
    // The SHORT one runs along the baseline of the screens and joins the two
    // edges that face each other: this computer's right edge to the linked
    // computer's left edge.
    //
    // The LONG one runs underneath both screens and joins this computer's
    // LEFT edge to the linked computer's RIGHT edge - the full span of the
    // pair, which is what makes it the longer of the two. Mirror's entry is
    // the inverse of the exit, so that is the edge it lands on; the fixed
    // disciplines land on their pinned entry edge instead.
    property <length> our-facing-x: root.peer-on-right ? root.our-r : root.our-l;
    property <length> our-far-x: root.peer-on-right ? root.our-l : root.our-r;
    property <length> peer-facing-x: root.peer-on-right ? root.peer-l : root.peer-r;
    property <length> entry-x:
        root.mode == 2 ? root.peer-l
        : root.mode == 3 ? root.peer-r
        : (root.peer-on-right ? root.peer-r : root.peer-l);
    property <float> near-x1: root.our-facing-x / 1px;
    property <float> near-x2: root.peer-facing-x / 1px;
    property <float> far-x1: root.our-far-x / 1px;
    property <float> far-x2: root.entry-x / 1px;
    property <int> y-near: root.mode == 0 ? 20 : 14;
    property <int> y-far: 26;
    property <bool> near-right: root.near-x1 < root.near-x2;
    property <bool> far-right: root.far-x1 < root.far-x2;

    property <string> near-line: "M \{root.near-x1} \{root.y-near} L \{root.near-x2} \{root.y-near}";
    // Head on THIS computer's end of the short arrow.
    property <string> near-our-head: root.near-right
        ? "M \{root.near-x1 + 5} \{root.y-near - 2.5} L \{root.near-x1} \{root.y-near} L \{root.near-x1 + 5} \{root.y-near + 2.5}"
        : "M \{root.near-x1 - 5} \{root.y-near - 2.5} L \{root.near-x1} \{root.y-near} L \{root.near-x1 - 5} \{root.y-near + 2.5}";
    // Head on the linked computer's end of the short arrow.
    property <string> near-peer-head: root.near-right
        ? "M \{root.near-x2 - 5} \{root.y-near - 2.5} L \{root.near-x2} \{root.y-near} L \{root.near-x2 - 5} \{root.y-near + 2.5}"
        : "M \{root.near-x2 + 5} \{root.y-near - 2.5} L \{root.near-x2} \{root.y-near} L \{root.near-x2 + 5} \{root.y-near + 2.5}";

    property <string> far-line: "M \{root.far-x1} \{root.y-far} L \{root.far-x2} \{root.y-far}";
    // Head on THIS computer's left-edge end of the long arrow.
    property <string> far-our-head: root.far-right
        ? "M \{root.far-x1 + 5} \{root.y-far - 2.5} L \{root.far-x1} \{root.y-far} L \{root.far-x1 + 5} \{root.y-far + 2.5}"
        : "M \{root.far-x1 - 5} \{root.y-far - 2.5} L \{root.far-x1} \{root.y-far} L \{root.far-x1 - 5} \{root.y-far + 2.5}";
    // Head on the linked computer's end of the long arrow.
    property <string> far-peer-head: root.far-right
        ? "M \{root.far-x2 - 5} \{root.y-far - 2.5} L \{root.far-x2} \{root.y-far} L \{root.far-x2 - 5} \{root.y-far + 2.5}"
        : "M \{root.far-x2 + 5} \{root.y-far - 2.5} L \{root.far-x2} \{root.y-far} L \{root.far-x2 + 5} \{root.y-far + 2.5}";

    // The short arrow: the facing-edge crossing. Every discipline has one.
    Path {
        x: 0;
        y: 0;
        width: 142px;
        height: 66px;
        viewbox-width: 142;
        viewbox-height: 66;
        stroke: #22c55e;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.near-line
            + (root.head-at-peer ? root.near-peer-head : "")
            + (root.head-at-our ? root.near-our-head : "");
    }
    // The long arrow: the second crossing. Only a double discipline has
    // one, and it is visibly the longer route of the two.
    if root.mode != 0 : Path {
        x: 0;
        y: 0;
        width: 142px;
        height: 66px;
        viewbox-width: 142;
        viewbox-height: 66;
        stroke: #5eead4;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.far-line
            + (root.head-at-peer ? root.far-peer-head : "")
            + (root.head-at-our ? root.far-our-head : "");
    }
}
component EdgeModeTile inherits Rectangle {
    in property <int> mode: 0;
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> applying: false;
    in property <bool> enabled: true;
    in property <int> tick: 0;
    // Roles of this computer and the linked computer, plus the live
    // arrangement: together they decide how many crossing arrows the
    // illustration draws and where their heads sit.
    in property <int> our-mode: 0;
    in property <int> peer-mode: 0;
    in property <bool> arranged-peer-on-right: true;
    callback clicked();
    // Slightly larger: the monitors inside are bigger, so the tile has to
    // be too or the diagram would be squeezed.
    width: 162px;
    height: 110px;
    border-radius: 10px;
    // The tile in force wears a green highlight box - the same accent the
    // live edges use - so the discipline actually applied to the link is
    // unmistakable at a glance.
    background: root.selected ? #14231a : #111827;
    border-width: root.selected ? 2px : 1.5px;
    border-color: root.selected ? #22c55e : (hit.has-hover && root.enabled ? #4b5563 : #1f2937);
    drop-shadow-color: root.selected ? #22c55e33 : #00000000;
    drop-shadow-blur: root.selected ? 12px : 0px;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 140ms; }
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled && !root.applying) { root.clicked(); } }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled && !root.applying) { root.clicked(); } }
    VerticalLayout {
        padding: 7px;
        spacing: 6px;
        alignment: center;
        EdgeModeDiagram {
            mode: root.mode;
            our-mode: root.our-mode;
            peer-mode: root.peer-mode;
            peer-on-right: root.arranged-peer-on-right;
        }
        Text {
            text: root.label;
            color: root.selected ? #e5e7eb : #9ca3af;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }

    // Applying this discipline: the same donut as everywhere else.
    if root.applying : Rectangle {
        width: 100%;
        height: 100%;
        background: #0a0a0ad0;
        border-radius: 10px;
        SpinnerArc {
            x: (root.width - 26px) / 2;
            y: (root.height - 26px) / 2;
            diameter: 26px;
            tick: root.tick;
        }
    }
}

component EdgeModePicker inherits Rectangle {
    in property <int> selected: 1;
    in property <bool> applying: false;
    in property <int> pending-index: -1;
    in property <bool> enabled: false;
    in property <int> tick: 0;
    // Roles of this computer and the linked computer and the live
    // arrangement, passed down to the illustrations so each crossing
    // arrow set matches the pair.
    in property <int> our-mode: 0;
    in property <int> peer-mode: 0;
    in property <bool> arranged-peer-on-right: true;
    callback picked(int);
    height: 104px;
    background: transparent;
    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        EdgeModeTile {
            mode: 0;
            label: "Single";
            selected: root.selected == 0;
            applying: root.applying && root.pending-index == 0;
            enabled: root.enabled;
            tick: root.tick;
            our-mode: root.our-mode;
            peer-mode: root.peer-mode;
            arranged-peer-on-right: root.arranged-peer-on-right;
            clicked => { root.picked(0); }
        }
        EdgeModeTile {
            mode: 1;
            label: "Mirror";
            selected: root.selected == 1;
            applying: root.applying && root.pending-index == 1;
            enabled: root.enabled;
            tick: root.tick;
            our-mode: root.our-mode;
            peer-mode: root.peer-mode;
            arranged-peer-on-right: root.arranged-peer-on-right;
            clicked => { root.picked(1); }
        }
        EdgeModeTile {
            mode: 2;
            label: "Fixed left";
            selected: root.selected == 2;
            applying: root.applying && root.pending-index == 2;
            enabled: root.enabled;
            tick: root.tick;
            our-mode: root.our-mode;
            peer-mode: root.peer-mode;
            arranged-peer-on-right: root.arranged-peer-on-right;
            clicked => { root.picked(2); }
        }
        EdgeModeTile {
            mode: 3;
            label: "Fixed right";
            selected: root.selected == 3;
            applying: root.applying && root.pending-index == 3;
            enabled: root.enabled;
            tick: root.tick;
            our-mode: root.our-mode;
            peer-mode: root.peer-mode;
            arranged-peer-on-right: root.arranged-peer-on-right;
            clicked => { root.picked(3); }
        }
    }
}

// One role option inside the dropdown popup.
component RoleRow inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback picked();
    height: 40px;
    background: hit.has-hover ? #2a2a2a : transparent;
    border-radius: 7px;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.label;
            color: root.selected ? #86efac : #e5e7eb;
            font-size: 14px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.selected : Path {
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            stroke: #22c55e;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
            commands: "M 2 6 L 5 9 L 10 3";
        }
    }
}

// Role selection as a proper dropdown with a drawn chevron. The popup is
// a PopupWindow, so it floats above the tab content and closes on an
// outside click; the chevron flips while it is open.
component RoleDropdown inherits Rectangle {
    in property <string> current: "Both ways";
    in property <int> mode-index: 0;
    in property <bool> enabled: true;
    // The daemon is applying the pending role — show a donut in the arrow
    // slot so the press visibly took effect. Cleared when the daemon
    // confirms (or refuses).
    in property <bool> applying: false;
    // The role just landed: brief green frame on the dropdown.
    in-out property <bool> applied: false;
    in property <int> tick: 0;
    callback picked(int);
    // Compact: the widest role label plus the chevron, so the box hugs its
    // contents instead of leaving a long empty stretch between the label
    // and the arrow.
    width: 176px;
    height: 34px;
    border-radius: 8px;
    background: hit.has-hover || popup.is-open ? #2a2a2a : #1c1c1c;
    border-width: 1px;
    border-color: root.applying || root.applied ? #22c55e : (popup.is-open ? #22c55e : (hit.has-hover ? #4b5563 : #2a2a2a));
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (popup.is-open) {
                popup.close();
            } else {
                popup.show();
            }
        }
    }
    accessible-role: combobox;
    accessible-label: "This computer's role";
    accessible-expanded: popup.is-open;
    accessible-action-expand => { popup.show(); }
    // Absolute placement inside the box: the label takes the width minus
    // the chevron, and the chevron is a fixed 14px square centred on the
    // control's own height - no layout to stretch it to the top.
    Text {
        x: 11px;
        y: (parent.height - self.height) / 2;
        // The label owns everything left of the chevron and is centred in
        // it: left-aligning leaves a long dead gap between the label and
        // the arrow whenever the label is short ("Both ways").
        width: parent.width - 11px - 9px - 14px - 8px;
        text: root.current;
        color: white;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }
    // While applying, the chevron slot becomes a donut. When it lands,
    // the frame goes green briefly (self-clearing).
    if !root.applying : Rectangle {
        x: parent.width - 24px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        ChevronGlyph {
            width: 100%;
            height: 100%;
            open: popup.is-open;
            glyph-color: popup.is-open ? #22c55e : #9ca3af;
        }
    }
    if root.applying : SpinnerArc {
        x: parent.width - 24px;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        diameter: 14px;
        tick: root.tick;
    }
    Timer {
        interval: 700ms;
        running: root.applied;
        triggered => { root.applied = false; }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        height: 136px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            background: #1c1c1c;
            border-radius: 10px;
            border-width: 1px;
            border-color: #2a2a2a;
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                alignment: start;
                RoleRow {
                    label: "Both ways";
                    selected: root.mode-index == 0;
                    picked => { popup.close(); root.picked(0); }
                }
                RoleRow {
                    label: "Control other only";
                    selected: root.mode-index == 1;
                    picked => { popup.close(); root.picked(1); }
                }
                RoleRow {
                    label: "Be controlled only";
                    selected: root.mode-index == 2;
                    picked => { popup.close(); root.picked(2); }
                }
            }
        }
    }
}

// Collapsible section header for things that should stay out of sight.
component Disclosure inherits Rectangle {
    in property <string> label: "";
    in property <bool> open: false;
    callback clicked();
    horizontal-stretch: 1;
    height: 36px;
    background: transparent;
    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        horizontal-stretch: 1;
        min-width: 300px;
        spacing: 8px;
        Text {
            text: root.label;
            color: #d1d5db;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        ChevronGlyph { open: root.open; glyph-color: #9ca3af; }
    }
}

// TheKVM: Deskflow-simple. The Connect tab is the whole product for most
// users: pick what this computer does, type the other computer's address,
// press Connect. Everything advanced lives under Devices and Settings.
export component AppWindow inherits Window {
    title: "TheKVM" + title-alert;

    min-width: 720px;
    min-height: 560px;
    background: #0a0a0a;
    // Crisp native-feeling text: resolve the desktop's own UI family
    // (Ubuntu on Mint, Segoe UI on Windows) instead of Slint's embedded
    // fallback. Small unhinted fallback glyphs read blurry next to
    // native apps; the system family is drawn for exactly these sizes.
    // Missing families fall back gracefully per platform, never blank.
    // TEST: temporarily without default-font-family
    // default-font-family: "Ubuntu, Segoe UI, Noto Sans, DejaVu Sans, Sans-Serif";

    // This UI is designed dark. Slint's fluent widgets follow the OS color
    // scheme, so on a light desktop (e.g. stock Linux Mint) every Switch,
    // LineEdit and Button rendered light-on-dark and the contrast fell
    // apart, while dark-mode Windows looked perfect. Pin the scheme to
    // dark: set once at startup and re-assert on a slow guard timer, since
    // the backend re-applies the OS theme on ThemeChanged/xdg-portal
    // events and would otherwise flip light desktops back.
    init => {
        Palette.color-scheme = ColorScheme.dark;
        scheme-guard.start();
    }
    scheme-guard := Timer {
        interval: 3s;
        triggered => {
            if (Palette.color-scheme != ColorScheme.dark) {
                Palette.color-scheme = ColorScheme.dark;
            }
        }
    }
    changed status-text => {
        if (root.status-text != "" && root.status-text != root.status-notice) {
            root.status-notice = root.status-text;
            notice-timer.restart();
        }
    }
    notice-timer := Timer {
        interval: 7s;
        triggered => { root.status-notice = ""; }
    }
    // The crossing pulse is a flash, not a state: it clears itself.
    Timer {
        interval: 650ms;
        running: root.crossing-pulse;
        triggered => { root.crossing-pulse = false; }
    }

    in property <string> status-text: "";
    // Transient feedback line: mirrors the latest status briefly (errors,
    // refusals, saved settings) and then disappears, so no permanent bar.
    in-out property <string> status-notice: "";
    in property <bool> connected: false;
    in property <string> session-text: "Not connected";
    in property <bool> session-active: false;
    // True only after the child reported a verified session. session-active
    // alone means "a link process exists" (Connecting OR Connected).
    in property <bool> session-verified: false;
    in-out property <string> fingerprint: "…";
    in-out property <string> peer-list: "No trusted computers";
    in-out property <string> linked-peer-name: "";
    in-out property <string> arrangement-text: "No linked screens yet — pair a computer first.";
    in-out property <bool> peer-on-right: true;
    // Roles for the crossing illustration: this computer's role and the
    // linked computer's role (0 both ways, 1 control other only, 2 be
    // controlled) decide how many crossing arrows the mirror shows.
    in-out property <int> our-mode: 0;
    in-out property <int> peer-mode: 0;
    in-out property <bool> edge-active: false;
    in-out property <string> driving-text: "";
    // True while a live inbound session from the peer has demonstrably taken
    // the cursor AND sent input recently (peer is actively driving).
    in-out property <bool> inbound-driving: false;
    // True while OUR outbound drive is active (child stderr said "driving").
    in-out property <bool> outbound-driving: false;
    // Link is live right now: our dial-back child verified, or an inbound
    // session is verifiably carrying input. The mesh, LED and borders use
    // this instead of "some peer exists in the book".
    in-out property <bool> link-live: false;
    // Brief handoff pulse: the lit edge bars and crossing arrows flash
    // bright for a moment on every crossing.
    in-out property <bool> crossing-pulse: false;
    in-out property <string> revoke-fingerprint: "";
    in-out property <string> pending-peer-fingerprint: "";
    in-out property <string> pending-peer-name: "";
    in-out property <string> pending-verification-code: "";
    in-out property <string> incoming-pairing: "";
    in-out property <string> incoming-pairing-fingerprint: "";
    in-out property <string> incoming-verification-code: "";
    // Inbound link approval (see PendingLink): a paired peer dialing a
    // fresh epoch waits for Allow/Deny here. Set from the poll loop;
    // cleared when the queue empties.
    in-out property <string> incoming-link: "";
    in-out property <string> incoming-link-fingerprint: "";
    in-out property <bool> lock-screen-control: false;
    in-out property <bool> clipboard-enabled: true;
    in-out property <string> clipboard-max-mb: "2";
    in-out property <bool> reverse-scroll: false;
    // Login auto-start (kvm-platform::autostart): the switch reflects
    // what the OS will actually do at the next logon, not a config
    // value, so it can never claim a state the machine does not have.
    in-out property <bool> autostart-enabled: false;
    in property <bool> autostart-supported: true;
    in-out property <bool> autostart-busy: false;
    in-out property <string> autostart-note: "";
    // Auto-reconnect: true only for the last link this machine was
    // actually linked to at shutdown. A Disconnect clears the remembered
    // address, so a link the user ended is never resurrected; the
    // epoch-ban system still refuses the re-dial if the peer also ended
    // it on their side.
    in-out property <bool> auto-connect-on-start: false;
    in property <bool> auto-connect-known: false;
    in-out property <bool> auto-connect-busy: false;
    in-out property <string> auto-connect-note: "";
    // 0 Both ways, 1 Control other only, 2 Be controlled only.
    in-out property <int> mode-index: 0;
    // Set while a role change is in flight (arc shows in the dropdown), and
    // briefly after it lands (green frame).
    in-out property <bool> role-applying: false;
    in-out property <bool> role-applied: false;
    // 0 Single, 1 Mirror, 2 Fixed left, 3 Fixed right.
    in-out property <int> edge-mode-index: 1;
    // True while an edge-mode change is being applied to a live child; the
    // pressed tile shows the donut until the child acknowledges.
    in property <bool> edge-applying: false;
    // Which tile was pressed last, so its donut shows (the daemon may not
    // have applied the new selection yet when the spinner starts).
    in-out property <int> pending-edge-index: -1;
    in property <string> role-text: "Both ways";
    in property <string> app-version: "";
    // Taskbar/dock alert: set while an incoming pairing waits, so a
    // minimized window still announces the request.
    in property <string> title-alert: "";
    in-out property <bool> advanced-open: false;
    // Trusted peers with their fingerprints, shown only inside Advanced.
    in-out property <string> trusted-peers-advanced: "";
    in-out property <string> layout-path: "";
    in-out property <string> peer-address: "";
    in-out property <string> pair-code: "";
    in property <string> pairing-code: "";
    in-out property <string> discovery-text: "No LAN scan yet";
    // Nearby-devices card (top of the Connect tab): shown on startup so
    // the LAN set is visible without hunting for the Devices tab. The
    // drawn cross hides it; the drawn refresh button rescans (and shows
    // the donut while the scan runs), and the UI re-reveals the card when
    // a background scan detects a NEW device, so a hidden card can never
    // keep a nearby computer invisible. Listing only — never dials.
    in-out property <bool> discovery-card-visible: true;
    // True while a scan is in flight.
    in-out property <bool> discovery-scanning: false;
    // Scanned devices (label + dial address behind each row): refreshed by
    // the Scan button and, when auto-discovery is on, the background poll.
    // Picking a row and pressing Connect dials it through the normal
    // pairing/mode-checked flow — a tap never bypasses approval.
    in-out property <[string]> discovered-labels: [];
    in-out property <int> discovered-index: 0;
    // Automatic LAN discovery listing (Settings, default on): listing
    // only, never dials by itself.
    in-out property <bool> auto-discover: true;
    in-out property <string> device-name: "";
    in-out property <string> auto-connect-address: "";
    in-out property <string> local-address: "";
    in-out property <string> invite-text: "";
    in-out property <image> invite-qr;
    in-out property <bool> invite-ready: false;
    in-out property <string> invite-input: "";

    // First-connect link warm-up: set when the user presses Connect (or
    // the station dials back), cleared the moment the session display
    // settles (see set_session). While set and no session is live, the
    // Connect tab shows the donut beside the session line — and crossings
    // stay gated daemon-side until edge-ready, so the first push after
    // the spinner is already warm and instant.
    in property <bool> link-connecting: false;
    in-out property <int> spinner-tick: 0;

    callback connect-to(string /* address */, string /* typed station code, may be empty */);
    callback disconnect();
    callback set-role(int /* 0 both, 1 controller, 2 receiver */);
    callback set-edge-mode(int /* 0 single facing edge, 1 double horizontal edges */);
    callback set-reverse-scroll(bool /* true reverses outbound wheel */);
    callback pair-from-invite(string /* invite */);
    callback discover-lan();
    callback hide-discovery();
    callback connect-discovered(int /* ComboBox row */);
    callback apply-auto-discover(bool /* wanted */);
    callback start-daemon();
    callback confirm-pairing();
    callback cancel-pairing();
    callback approve-incoming-pairing(string);
    callback reject-incoming-pairing(string);
    callback approve-incoming-link(string);
    callback reject-incoming-link(string);
    callback revoke-peer(string);
    callback place-peer-left();
    callback place-peer-right();
    callback open-log-folder();
    callback apply-config(bool, int, string, string, bool, string);
    // Login auto-start and auto-reconnect toggles (Problem 3). Both carry the
    // requested state; the UI code re-reads the OS / the daemon afterwards so
    // the switches always show what the machine will really do.
    callback apply-autostart(bool /* wanted */);
    callback apply-auto-connect(bool /* wanted */);
    callback import-layout(string);


    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Persistent offline banner: daemon unreachable is shown at all
        // times, on every tab (not the 7-second transient footer). Visible
        // only while offline — a conditional element takes no layout space.
        if !connected : Rectangle {
            vertical-stretch: 0;
            height: 34px;
            background: #3b2f07;
            border-width: 1px;
            border-color: #f59e0b;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: "⚠ Background service is offline";
                    color: #fbbf24;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: "the link cannot work until it is running";
                    color: #fcd34d;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Start service";
                    clicked => { root.start-daemon(); }
                }
            }
        }

        // NOTE: no header of any kind lives here anymore — not even the
        // old slim status row. Every in-flow strip above the tabs read
        // as a permanent black bar (Slint reserves layout space for
        // hidden elements), so the tabs start at the window padding and
        // live status already shows inside the Connect tab.
        GridLayout {
            padding: 12px;
            spacing: 0px;

        TabWidget {
            row: 0;
            col: 0;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            Tab {
                title: "Connect";
                // Scrollable: tab content is taller than the window, and a
                // plain VerticalLayout silently CLIPS everything past the
                // bottom — which once hid the whole address/code/connect
                // row with no way to reach it. Never clip again.
                Flickable {
                Rectangle {
                // Exactly the Flickable's width: the content must never ask the
                // viewport to be wider than the window, or the panels get
                // sliced off at the right edge and a horizontal scrollbar
                // appears for no reason.
                width: parent.width;
                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;

                    // ---- Nearby devices ----------------------------------
                    if discovery-card-visible : Rectangle {
                        vertical-stretch: 0;
                        background: #121212;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #2a2a2a;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 5px;
                            // Inner panel one step lighter for contrast.
                            Rectangle {
                                background: #1c1c1c;
                                border-radius: 7px;
                                border-width: 1px;
                                border-color: #262626;
                                VerticalLayout {
                                    padding: 7px;
                                    spacing: 5px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "Nearby devices";
                                            color: white;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        RescanButton {
                                            scanning: root.discovery-scanning;
                                            tick: root.spinner-tick;
                                            clicked => { discover-lan(); }
                                        }
                                        CloseButton {
                                            clicked => { hide-discovery(); }
                                        }
                                    }
                                    Text {
                                        text: root.discovery-scanning ? "Scanning…" : root.discovery-text;
                                        color: root.discovery-scanning ? #6ee7b7 : #9ca3af;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                    if discovered-labels.length > 0 : HorizontalLayout {
                                        spacing: 8px;
                                        found2 := ComboBox {
                                            model: root.discovered-labels;
                                            current-index <=> root.discovered-index;
                                            height: 32px;
                                            width: 320px;
                                        }
                                        Button {
                                            text: "Connect";
                                            primary: true;
                                            height: 32px;
                                            enabled: discovered-labels.length > 0 && !session-active;
                                            clicked => { connect-discovered(root.discovered-index); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if discovered-labels.length == 0 && !discovery-scanning : Text {
                                        text: "No devices found.";
                                        color: #6b7280;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }
                    }
                    // The card's rescan control lives inside the card, so
                    // hiding it must leave a way back: this compact chip
                    // rescans and reopens the listing.
                    if !discovery-card-visible : Rectangle {
                        vertical-stretch: 0;
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: #111827;
                        border-width: 1px;
                        border-color: #1f2937;
                        RescanButton {
                            x: 4px;
                            y: 4px;
                            scanning: root.discovery-scanning;
                            tick: root.spinner-tick;
                            clicked => {
                                root.discovery-card-visible = true;
                                discover-lan();
                            }
                        }
                    }

                    // ---- Role --------------------------------------------
                    // Hugs its content: a stretched row leaves a wide empty
                    // strip to the right of the dropdown. (Fixed items first,
                    // no stretch spacer: a stretched sibling starves the
                    // dropdown to zero width.)
                    HorizontalLayout {
                        vertical-stretch: 0;
                        horizontal-stretch: 0;
                        spacing: 10px;
                        Text {
                            // This computer's name AND live LAN address: the
                            // other machine needs the IP, so it belongs right
                            // here, aligned with the label.
                            // A bounded width matters: an unbounded Text
                            // absorbs every leftover pixel of the row, which
                            // pushed the dropdown off the right edge of the
                            // window. Fixed at the widest the label gets.
                            width: 260px;
                            text: root.local-address == ""
                                ? "This computer"
                                : "This computer · " + root.local-address;
                            color: #9ca3af;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // Role selection is local configuration, not a
                        // daemon-dependent action: the dropdown is always
                        // pressable. Gating it once made it look permanently
                        // dead whenever the status poll failed.
                        RoleDropdown {
                            width: 176px;
                            height: 34px;
                            current: root.role-text;
                            mode-index: root.mode-index;
                            applying: root.role-applying;
                            applied: root.role-applied;
                            tick: root.spinner-tick;
                            picked(index) => { set-role(index); }
                        }
                    }

                    // ---- Connect -----------------------------------------
                    Rectangle {
                        vertical-stretch: 0; height: 1px; background: #1f2937; }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        addr := LineEdit {
                            text <=> root.peer-address;
                            placeholder-text: "Other computer's address";
                            enabled: !session-active;
                            // Fixed width, no stretch: a stretched sibling
                            // starves the Connect button to zero width.
                            width: 320px;
                        }
                        if !session-active : Button {
                            text: "Connect";
                            primary: true;
                            enabled: addr.text != "";
                            clicked => { connect-to(addr.text, code-field.text); }
                        }
                        if session-active : Button {
                            text: "Disconnect";
                            clicked => { disconnect(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    code-field := LineEdit {
                        vertical-stretch: 0;
                        text <=> root.pair-code;
                        placeholder-text: "Pairing code (optional)";
                        enabled: !session-active;
                    }
                    // Live session state: donut while the link warms up, a
                    // green dot only once the session is verified.
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 9px;
                        if link-connecting && !session-verified : SpinnerArc {
                            diameter: 16px;
                            tick: root.spinner-tick;
                        }
                        if session-verified : Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: #22c55e;
                            y: (parent.height - 8px) / 2;
                        }
                        Text {
                            text: session-text;
                            color: session-active ? (session-verified ? #22c55e : #f59e0b) : #9ca3af;
                            font-size: 13px;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    if driving-text != "" : Text {
                        vertical-stretch: 0;
                        text: driving-text;
                        color: #22c55e;
                        font-size: 12px;
                        font-weight: 700;
                    }

                    // ---- Pairing code ------------------------------------
                    Rectangle {
                        vertical-stretch: 0; height: 1px; background: #1f2937; }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        Text {
                            text: "Pairing code";
                            color: #9ca3af;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.pairing-code == "" ? "…" : root.pairing-code;
                            color: #22c55e;
                            font-size: 24px;
                            font-weight: 800;
                            letter-spacing: 5px;
                            vertical-alignment: center;
                        }
                    }

                    // ---- Pairing ceremonies ------------------------------
                    if pending-verification-code != "" : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        Text {
                            text: "Does " + (pending-peer-name == "" ? "the other computer" : pending-peer-name) + " show this code?";
                            color: #f59e0b;
                            font-size: 13px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            text: pending-verification-code;
                            color: #22c55e;
                            font-size: 28px;
                            font-weight: 800;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            Button {
                                text: "Codes match";
                                primary: true;
                                height: 34px;
                                min-width: 110px;
                                clicked => { confirm-pairing(); }
                            }
                            Button {
                                text: "Cancel";
                                height: 34px;
                                min-width: 96px;
                                clicked => { cancel-pairing(); }
                            }
                        }
                    }
                    if incoming-pairing != "" : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        // Both directions must be visible SIMULTANEOUSLY. This
                        // used to hide while our own outgoing code check was
                        // open — so when both computers pressed Connect, each
                        // side showed only its outgoing screen and neither
                        // could ever approve the other: a mutual-blindness
                        // deadlock with both users staring at unanswerable
                        // code screens until everything timed out.
                        Text {
                            text: "Incoming pairing · " + incoming-pairing;
                            color: #f59e0b;
                            font-size: 13px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        if incoming-verification-code != "" : Text {
                            text: incoming-verification-code;
                            color: #22c55e;
                            font-size: 28px;
                            font-weight: 800;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            Button {
                                text: "Allow";
                                primary: true;
                                height: 34px;
                                min-width: 96px;
                                clicked => { approve-incoming-pairing(incoming-pairing-fingerprint); }
                            }
                            Button {
                                text: "Deny";
                                height: 34px;
                                min-width: 96px;
                                clicked => { reject-incoming-pairing(incoming-pairing-fingerprint); }
                            }
                        }
                    }
                    if incoming-link != "" : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 6px;
                        // Paired computers still ask before driving: a
                        // fresh link epoch from a trusted peer waits here
                        // (Allow once per link — retries and the dial-back
                        // on the same link never ask again).
                        Text {
                            text: "Link request · " + incoming-link;
                            color: #6ee7b7;
                            font-size: 13px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Allow";
                                primary: true;
                                height: 34px;
                                min-width: 96px;
                                clicked => { approve-incoming-link(incoming-link-fingerprint); }
                            }
                            Button {
                                text: "Deny";
                                height: 34px;
                                min-width: 96px;
                                clicked => { reject-incoming-link(incoming-link-fingerprint); }
                            }
                        }
                    }

                    if !connected : Button {
                        vertical-stretch: 0;
                        text: "Start background service";
                        clicked => { start-daemon(); }
                    }
                
                    // Absorbs all spare vertical space so every row above
                    // keeps its natural height instead of stretching.
                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                    }
                }
                }
                }
            }

            Tab {
                title: "Devices";
                Flickable {
                Rectangle {
                // Exactly the Flickable's width: the content must never ask the
                // viewport to be wider than the window, or the panels get
                // sliced off at the right edge and a horizontal scrollbar
                // appears for no reason.
                width: parent.width;
                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;

                    // ---- Computers ---------------------------------------
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        Text {
                            text: "Computers";
                            color: white;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if discovery-scanning : SpinnerArc {
                            diameter: 14px;
                            tick: root.spinner-tick;
                        }
                        Button {
                            text: "Scan";
                            enabled: !discovery-scanning;
                            clicked => { discover-lan(); }
                        }
                    }
                    if discovered-labels.length > 0 : HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        found := ComboBox {
                            model: root.discovered-labels;
                            current-index <=> root.discovered-index;
                            // Explicit height: a native ComboBox with no
                            // height inside a conditional row balloons to
                            // whatever vertical space the tab has spare.
                            height: 32px;
                            width: 320px;
                        }
                        Button {
                            text: "Connect";
                            primary: true;
                            height: 32px;
                            enabled: discovered-labels.length > 0 && !session-active;
                            clicked => { connect-discovered(root.discovered-index); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    // (Past/present computer names deliberately not listed
                    // here: the Devices tab shows what is arranged and what
                    // is nearby. Remembered names/addresses come later.)

                    Rectangle {
                        vertical-stretch: 0; height: 1px; background: #1f2937; }

                    // ---- Arrangement -------------------------------------
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        Text {
                            text: "Screen arrangement";
                            color: white;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.edge-mode-index == 0 ? "Single" : root.edge-mode-index == 1 ? "Mirror" : root.edge-mode-index == 2 ? "Fixed left" : "Fixed right";
                            color: #22c55e;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    ArrangementMesh {
                        vertical-stretch: 0;
                        local-name: root.device-name;
                        peer-name: root.linked-peer-name;
                        peer-on-right: root.peer-on-right;
                        enabled: root.link-live;
                        link-live: root.link-live;
                        crossing-pulse: root.crossing-pulse;
                        edge-mode: root.edge-mode-index;
                        our-mode: root.mode-index;
                        peer-mode: root.peer-mode;
                        to-left => { place-peer-left(); }
                        to-right => { place-peer-right(); }
                    }
                    // Live cue for who has the cursor right now. Honest about
                    // which computer currently makes this screen respond.
                    if root.outbound-driving : Text {
                        vertical-stretch: 0;
                        text: "You are driving " + root.linked-peer-name;
                        color: #22c55e; font-size: 12px; font-weight: 700;
                    }
                    if !root.outbound-driving && root.inbound-driving : Text {
                        vertical-stretch: 0;
                        text: root.linked-peer-name + " is driving this computer";
                        color: #5eead4; font-size: 12px; font-weight: 700;
                    }

                    Rectangle {
                        vertical-stretch: 0; height: 1px; background: #1f2937; }

                    // ---- Crossing edges ----------------------------------
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        Text {
                            text: "Crossing edges";
                            color: white;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.edge-mode-index == 0 ? "Single" : root.edge-mode-index == 1 ? "Mirror" : root.edge-mode-index == 2 ? "Fixed left" : "Fixed right";
                            color: #22c55e;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    EdgeModePicker {
                        vertical-stretch: 0;
                        selected: root.edge-mode-index;
                        applying: root.edge-applying;
                        pending-index: root.pending-edge-index;
                        // Crossing discipline is global config: selectable
                        // before the first pair too, not only while linked.
                        enabled: true;
                        tick: root.spinner-tick;
                        our-mode: root.mode-index;
                        peer-mode: root.peer-mode;
                        arranged-peer-on-right: root.peer-on-right;
                        picked(index) => {
                            root.pending-edge-index = index;
                            set-edge-mode(index);
                        }
                    }
                    if driving-text != "" : Text {
                        vertical-stretch: 0;
                        text: driving-text;
                        color: #22c55e;
                        font-size: 12px;
                        font-weight: 700;
                    }
                
                    // Absorbs all spare vertical space so every row above
                    // keeps its natural height instead of stretching.
                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                    }
                }
                }
                }
            }

            Tab {
                title: "Settings";
                Flickable {
                Rectangle {
                // Exactly the Flickable's width: the content must never ask the
                // viewport to be wider than the window, or the panels get
                // sliced off at the right edge and a horizontal scrollbar
                // appears for no reason.
                width: parent.width;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        Text {
                            text: "Computer name";
                            color: #d1d5db;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        name := LineEdit {
                            height: 32px;
                            text <=> root.device-name;
                            placeholder-text: "friendly name";
                            width: 230px;
                        }
                        Button {
                            text: "Save";
                            enabled: name.text != "";
                            clicked => { apply-config(lock-screen-control, mode-index, name.text, auto-connect-address, clipboard-enabled, root.clipboard-max-mb); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Control login and lock screens";
                            color: #d1d5db;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Switch {
                            checked <=> root.lock-screen-control;
                            toggled => { apply-config(root.lock-screen-control, root.mode-index, root.device-name, root.auto-connect-address, root.clipboard-enabled, root.clipboard-max-mb); }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Sync text clipboard";
                            color: #d1d5db;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Switch {
                            checked <=> root.clipboard-enabled;
                            toggled => { apply-config(root.lock-screen-control, root.mode-index, root.device-name, root.auto-connect-address, root.clipboard-enabled, root.clipboard-max-mb); }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Reverse scroll on the other computer";
                            color: #d1d5db;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Switch {
                            checked <=> root.reverse-scroll;
                            toggled => { root.set-reverse-scroll(root.reverse-scroll); }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Find nearby computers";
                            color: #d1d5db;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Switch {
                            checked <=> root.auto-discover;
                            toggled => { root.apply-auto-discover(root.auto-discover); }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Start when I log in";
                            color: root.autostart-supported && !root.autostart-busy ? #d1d5db : #6b7280;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Switch {
                            checked <=> root.autostart-enabled;
            enabled: root.autostart-supported && !root.autostart-busy;
                            toggled => { root.apply-autostart(root.autostart-enabled); }
                        }
                    }
                    if autostart-note != "" : Text {
                        vertical-stretch: 0;
                        text: autostart-note;
                        color: #fbbf24;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Reconnect at startup";
                            color: root.auto-connect-known && !root.auto-connect-busy ? #d1d5db : #6b7280;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Switch {
                            checked <=> root.auto-connect-on-start;
                            enabled: root.auto-connect-known && !root.auto-connect-busy;
                            toggled => { root.apply-auto-connect(root.auto-connect-on-start); }
                        }
                    }
                    if auto-connect-note != "" : Text {
                        vertical-stretch: 0;
                        text: auto-connect-note;
                        color: #fbbf24;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        height: 36px;
                        Text {
                            text: "Clipboard limit (MB)";
                            color: #d1d5db;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        clipboard-max := LineEdit {
                            height: 32px;
                            text <=> root.clipboard-max-mb;
                            placeholder-text: "2";
                            width: 64px;
                        }
                        Button {
                            text: "Save";
                            clicked => { apply-config(root.lock-screen-control, root.mode_index, root.device-name, root.auto-connect-address, root.clipboard-enabled, clipboard-max.text); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    Rectangle {
                        vertical-stretch: 0; height: 1px; background: #1f2937; }
                    Disclosure {
                        vertical-stretch: 0;
                        label: "Advanced";
                        open: root.advanced-open;
                        clicked => { root.advanced-open = !root.advanced-open; }
                    }
                    if advanced-open : VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "Fingerprint";
                            color: #6b7280;
                            font-size: 11px;
                        }
                        Text {
                            text: fingerprint;
                            color: #f87171;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if trusted-peers-advanced != "" : Text {
                            text: "Trusted computers";
                            color: #6b7280;
                            font-size: 11px;
                        }
                        if trusted-peers-advanced != "" : Text {
                            text: trusted-peers-advanced;
                            color: #9ca3af;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            revoke := LineEdit {
                                height: 32px;
                                text <=> root.revoke-fingerprint;
                                placeholder-text: "Fingerprint to remove";
                                width: 320px;
                            }
                            Button {
                                text: "Remove";
                                enabled: revoke.text != "";
                                clicked => { revoke-peer(revoke.text); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            startup := LineEdit {
                                height: 32px;
                                text <=> root.auto-connect-address;
                                placeholder-text: "Startup address";
                                width: 320px;
                            }
                            Button {
                                text: "Save";
                                clicked => { apply-config(lock-screen-control, mode-index, device-name, startup.text, clipboard-enabled, root.clipboard-max-mb); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            path := LineEdit {
                                height: 32px;
                                text <=> root.layout-path;
                                placeholder-text: "Layout file";
                                width: 320px;
                            }
                            Button {
                                text: "Import";
                                enabled: path.text != "";
                                clicked => { import-layout(path.text); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Button {
                            text: "Open log folder";
                            clicked => { open-log-folder(); }
                        }
                    }
                    Text {
                        vertical-stretch: 0;
                        text: "TheKVM " + app-version;
                        color: #4b5563;
                        font-size: 11px;
                    }
                
                    // Absorbs all spare vertical space so every row above
                    // keeps its natural height instead of stretching.
                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;
                    }
                }
                }
                }
            }
        }

            // Approval popups: conditional (not merely hidden) so they
            // occupy ZERO space when nothing pends, and overlapped onto
            // the tabs' cell so they float above the content instead of
            // shoving it down. Approval rendezvous still works on every
            // tab — missed requests used to be indistinguishable from a
            // broken network. The `if` (not `visible`) matters: Slint
            // reserves layout space for hidden elements, which is what
            // used to read as a permanent empty bar.
            if incoming-pairing != "" || incoming-link != "" : Rectangle {
                row: 0;
                col: 0;
                // Transparent shell: the cell is sized by the tabs, so
                // this floats over them at zero layout cost; the inner
                // column stacks the pending cards from the top.
                VerticalLayout {
                    spacing: 8px;
                    if incoming-pairing != "" : Rectangle {
                        background: #453008;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #f59e0b;
                        drop-shadow-color: #000000aa;
                        drop-shadow-blur: 18px;
                        drop-shadow-offset-y: 6px;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 10px;
                            Text {
                                text: "Pairing request · " + incoming-pairing + (incoming-verification-code == "" ? "" : " · code " + incoming-verification-code);
                                color: #fde68a;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Allow";
                                primary: true;
                                height: 34px;
                                min-width: 96px;
                                clicked => { approve-incoming-pairing(incoming-pairing-fingerprint); }
                            }
                            Button {
                                text: "Deny";
                                height: 34px;
                                min-width: 96px;
                                clicked => { reject-incoming-pairing(incoming-pairing-fingerprint); }
                            }
                        }
                    }
                    if incoming-link != "" : Rectangle {
                        background: #123a2a;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #22c55e;
                        drop-shadow-color: #000000aa;
                        drop-shadow-blur: 18px;
                        drop-shadow-offset-y: 6px;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 10px;
                            Text {
                                text: "Link request · " + incoming-link;
                                color: #a7f3d0;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Allow";
                                primary: true;
                                height: 34px;
                                min-width: 96px;
                                clicked => { approve-incoming-link(incoming-link-fingerprint); }
                            }
                            Button {
                                text: "Deny";
                                height: 34px;
                                min-width: 96px;
                                clicked => { reject-incoming-link(incoming-link-fingerprint); }
                            }
                        }
                    }
                }
            }
        }
            if status-notice != "" : Rectangle {
                height: 28px;
                background: #111827;
                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: root.status-notice;
                    color: #9ca3af;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
    }
}
