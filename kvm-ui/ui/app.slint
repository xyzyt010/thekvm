import { Button, ComboBox, LineEdit, Palette, Switch, TabWidget } from "std-widgets.slint";

// TheKVM: Deskflow-simple. The Connect tab is the whole product for most
// users: pick what this computer does, type the other computer's address,
// press Connect. Everything advanced lives under Devices and Settings.
export component AppWindow inherits Window {
    title: "TheKVM " + app-version + title-alert;
    min-width: 720px;
    min-height: 560px;
    background: #0a0a0a;
    // Crisp native-feeling text: resolve the desktop's own UI family
    // (Ubuntu on Mint, Segoe UI on Windows) instead of Slint's embedded
    // fallback. Small unhinted fallback glyphs read blurry next to
    // native apps; the system family is drawn for exactly these sizes.
    // Missing families fall back gracefully per platform, never blank.
    default-font-family: "Ubuntu, Segoe UI, Noto Sans, DejaVu Sans, Sans-Serif";

    // This UI is designed dark. Slint's fluent widgets follow the OS color
    // scheme, so on a light desktop (e.g. stock Linux Mint) every Switch,
    // LineEdit and Button rendered light-on-dark and the contrast fell
    // apart, while dark-mode Windows looked perfect. Pin the scheme to
    // dark: set once at startup and re-assert on a slow guard timer, since
    // the backend re-applies the OS theme on ThemeChanged/xdg-portal
    // events and would otherwise flip light desktops back.
    init => {
        Palette.color-scheme = ColorScheme.dark;
        scheme-guard.start();
    }
    scheme-guard := Timer {
        interval: 3s;
        triggered => {
            if (Palette.color-scheme != ColorScheme.dark) {
                Palette.color-scheme = ColorScheme.dark;
            }
        }
    }

    in property <string> status-text: "Not connected";
    in property <bool> connected: false;
    in property <string> session-text: "Not connected";
    in property <bool> session-active: false;
    in-out property <string> fingerprint: "…";
    in-out property <string> peer-list: "No trusted computers";
    in-out property <string> linked-peer-name: "";
    in-out property <string> arrangement-text: "No linked screens yet — pair a computer first.";
    in-out property <bool> peer-on-right: true;
    in-out property <bool> edge-active: false;
    in-out property <string> driving-text: "";
    in-out property <string> revoke-fingerprint: "";
    in-out property <string> pending-peer-fingerprint: "";
    in-out property <string> pending-peer-name: "";
    in-out property <string> pending-verification-code: "";
    in-out property <string> incoming-pairing: "";
    in-out property <string> incoming-pairing-fingerprint: "";
    in-out property <string> incoming-verification-code: "";
    // Inbound link approval (see PendingLink): a paired peer dialing a
    // fresh epoch waits for Allow/Deny here. Set from the poll loop;
    // cleared when the queue empties.
    in-out property <string> incoming-link: "";
    in-out property <string> incoming-link-fingerprint: "";
    in-out property <bool> lock-screen-control: false;
    in-out property <bool> clipboard-enabled: true;
    in-out property <string> clipboard-max-mb: "2";
    in-out property <bool> reverse-scroll: false;
    // Login auto-start (kvm-platform::autostart): the switch reflects
    // what the OS will actually do at the next logon, not a config
    // value, so it can never claim a state the machine does not have.
    in-out property <bool> autostart-enabled: false;
    in property <bool> autostart-supported: true;
    in-out property <bool> autostart-busy: false;
    in-out property <string> autostart-note: "";
    // Auto-reconnect: true only for the last link this machine was
    // actually linked to at shutdown. A Disconnect clears the remembered
    // address, so a link the user ended is never resurrected; the
    // epoch-ban system still refuses the re-dial if the peer also ended
    // it on their side.
    in-out property <bool> auto-connect-on-start: false;
    in property <bool> auto-connect-known: false;
    in-out property <bool> auto-connect-busy: false;
    in-out property <string> auto-connect-note: "";
    in-out property <int> mode-index: 0;
    in-out property <int> edge-mode-index: 0;
    in property <string> role-text: "Both ways";
    in property <string> app-version: "";
    // Taskbar/dock alert: set while an incoming pairing waits, so a
    // minimized window still announces the request.
    in property <string> title-alert: "";
    in-out property <string> layout-path: "";
    in-out property <string> peer-address: "";
    in-out property <string> pair-code: "";
    in property <string> pairing-code: "";
    in-out property <string> discovery-text: "No LAN scan yet";
    // Scanned devices (label + dial address behind each row): refreshed by
    // the Scan button and, when auto-discovery is on, the background poll.
    // Picking a row and pressing Connect dials it through the normal
    // pairing/mode-checked flow — a tap never bypasses approval.
    in-out property <[string]> discovered-labels: [];
    in-out property <int> discovered-index: 0;
    // Automatic LAN discovery listing (Settings, default on): listing
    // only, never dials by itself.
    in-out property <bool> auto-discover: true;
    in-out property <string> device-name: "";
    in-out property <string> auto-connect-address: "";
    in-out property <string> local-address: "";
    in-out property <string> invite-text: "";
    in-out property <image> invite-qr;
    in-out property <bool> invite-ready: false;
    in-out property <string> invite-input: "";

    // First-connect link warm-up: set when the user presses Connect (or
    // the station dials back), cleared the moment the session display
    // settles (see set_session). While set and no session is live, the
    // Connect tab shows a small round loading spinner instead of a dead
    // row — and crossings stay gated daemon-side until edge-ready, so
    // the first push after the spinner is already warm and instant.
    in property <bool> link-connecting: false;
    in-out property <int> spinner-tick: 0;

    callback connect-to(string /* address */, string /* typed station code, may be empty */);
    callback disconnect();
    callback set-role(int /* 0 both, 1 controller, 2 receiver */);
    callback set-edge-mode(int /* 0 single facing edge, 1 double horizontal edges */);
    callback set-reverse-scroll(bool /* true reverses outbound wheel */);
    callback pair-from-invite(string /* invite */);
    callback discover-lan();
    callback connect-discovered(int /* ComboBox row */);
    callback apply-auto-discover(bool /* wanted */);
    callback start-daemon();
    callback confirm-pairing();
    callback cancel-pairing();
    callback approve-incoming-pairing(string);
    callback reject-incoming-pairing(string);
    callback approve-incoming-link(string);
    callback reject-incoming-link(string);
    callback revoke-peer(string);
    callback place-peer-left();
    callback place-peer-right();
    callback open-log-folder();
    callback apply-config(bool, int, string, string, bool, string);
    // Login auto-start and auto-reconnect toggles (Problem 3). Both carry the
    // requested state; the UI code re-reads the OS / the daemon afterwards so
    // the switches always show what the machine will really do.
    callback apply-autostart(bool /* wanted */);
    callback apply-auto-connect(bool /* wanted */);
    callback import-layout(string);


    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "TheKVM " + app-version;
                font-size: 28px;
                font-weight: 800;
                color: white;
                vertical-alignment: center;
            }
            Rectangle {
                width: 4px;
                height: 28px;
                background: connected ? #22c55e : #ef4444;
            }
            VerticalLayout {
                spacing: 0px;
                Text {
                    text: status-text;
                    color: connected ? #22c55e : #9ca3af;
                    vertical-alignment: center;
                    font-size: 13px;
                }
                Text {
                    text: local-address == "" ? "This computer: detecting…" : "This computer: " + local-address;
                    color: #6b7280;
                    font-size: 11px;
                }
            }
        }

        Rectangle {
            // Approval rendezvous must not depend on which tab is open. A
            // missed incoming request (wrong tab, minimized window) used to
            // be indistinguishable from a broken network — same silence on
            // both ends. This strip is visible on EVERY tab while a request
            // is pending, with the full details under the Connect tab.
            visible: incoming-pairing != "";
            background: #453008;
            border-radius: 8px;
            HorizontalLayout {
                padding: 8px;
                spacing: 12px;
                Text {
                    text: "INCOMING pairing — code " + incoming-verification-code + " (details under Connect tab)";
                    color: #fcd34d;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Button {
                    text: "Allow";
                    primary: true;
                    clicked => { approve-incoming-pairing(incoming-pairing-fingerprint); }
                }
                Button {
                    text: "Deny";
                    clicked => { reject-incoming-pairing(incoming-pairing-fingerprint); }
                }
            }
        }

        Rectangle {
            // Same rendezvous rule for LINK approvals: a paired computer
            // dialing a fresh link waits here until the local human allows
            // it — no input flows before that click, on any tab.
            visible: incoming-link != "";
            background: #123a2a;
            border-radius: 8px;
            HorizontalLayout {
                padding: 8px;
                spacing: 12px;
                Text {
                    text: "INCOMING link — " + incoming-link + " wants to connect (details under Connect tab)";
                    color: #6ee7b7;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Button {
                    text: "Allow";
                    primary: true;
                    clicked => { approve-incoming-link(incoming-link-fingerprint); }
                }
                Button {
                    text: "Deny";
                    clicked => { reject-incoming-link(incoming-link-fingerprint); }
                }
            }
        }

        TabWidget {
            Tab {
                title: "Connect";
                // Scrollable: tab content is taller than the window, and a
                // plain VerticalLayout silently CLIPS everything past the
                // bottom — which once hid the whole address/code/connect
                // row with no way to reach it. Never clip again.
                Flickable {
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text { text: "This computer will:"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: "Current role: " + role-text;
                        color: #22c55e;
                        font-size: 14px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        // Role selection is local configuration, not a
                        // daemon-dependent action: these buttons are always
                        // pressable. Gating them on daemon reachability once
                        // made them look permanently dead (no hover, no
                        // click, no feedback) whenever the status poll
                        // failed, with no way to tell why.
                        Button {
                            text: "Control other only";
                            clicked => { set-role(1); }
                        }
                        Button {
                            text: "Be controlled only";
                            clicked => { set-role(2); }
                        }
                        Button {
                            text: "Both ways";
                            clicked => { set-role(0); }
                        }
                    }
                    Text {
                        text: mode-index == 1 ? "Control other only: this computer drives the peer. The peer cannot drive back." : mode-index == 2 ? "Be controlled only: the peer drives this computer. This computer cannot drive back." : "Both ways: either computer can drive the other.";
                        color: #9ca3af;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "Connect to the other computer:"; color: white; font-size: 16px; font-weight: 700; }
                    Text { text: "Other computer's address:"; color: white; font-size: 16px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 12px;
                        addr := LineEdit {
                            text <=> root.peer-address;
                            placeholder-text: "e.g. 192.168.1.7";
                            enabled: !session-active;
                        }
                        Button {
                            text: "Connect";
                            primary: true;
                            visible: !session-active;
                            enabled: addr.text != "";
                            clicked => { connect-to(addr.text, code-field.text); }
                        }
                        Button {
                            text: "Disconnect";
                            visible: session-active;
                            clicked => { disconnect(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        code-field := LineEdit {
                            text <=> root.pair-code;
                            placeholder-text: "6-digit code from the other computer (optional)";
                            enabled: !session-active;
                        }
                    }
                    Text {
                        text: session-text;
                        color: session-active ? #22c55e : #9ca3af;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    // First-connect loading animation: a small round
                    // orbiting dot while the link warms up (pre-warm dial
                    // + caps + UDP arming, daemon-side). Crossings stay
                    // gated until edge-ready, so motion the moment this
                    // disappears rides the warmed stream — super smooth
                    // both directions from the very first push.
                    HorizontalLayout {
                        visible: link-connecting && !session-active;
                        spacing: 10px;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            // Static gradient ring: the round shape reads
                            // even between ticks.
                            Rectangle { x: 21px; y: 11px; width: 4px; height: 4px; border-radius: 2px; background: #14532d; }
                            Rectangle { x: 18px; y: 18px; width: 4px; height: 4px; border-radius: 2px; background: #14532d; }
                            Rectangle { x: 11px; y: 21px; width: 4px; height: 4px; border-radius: 2px; background: #14532d; }
                            Rectangle { x: 4px; y: 18px; width: 4px; height: 4px; border-radius: 2px; background: #14532d; }
                            Rectangle { x: 1px; y: 11px; width: 4px; height: 4px; border-radius: 2px; background: #14532d; }
                            Rectangle { x: 4px; y: 4px; width: 4px; height: 4px; border-radius: 2px; background: #14532d; }
                            Rectangle { x: 11px; y: 1px; width: 4px; height: 4px; border-radius: 2px; background: #14532d; }
                            Rectangle { x: 18px; y: 4px; width: 4px; height: 4px; border-radius: 2px; background: #14532d; }
                            // The orbiting bright dot: 8 positions stepping
                            // with the timer (~0.7s per orbit).
                            Rectangle {
                                width: 4px;
                                height: 4px;
                                border-radius: 2px;
                                background: #22c55e;
                                x: spinner-tick == 0 ? 21px : spinner-tick == 1 ? 18px : spinner-tick == 2 ? 11px : spinner-tick == 3 ? 4px : spinner-tick == 4 ? 1px : spinner-tick == 5 ? 4px : spinner-tick == 6 ? 11px : 18px;
                                y: spinner-tick == 0 ? 11px : spinner-tick == 1 ? 18px : spinner-tick == 2 ? 21px : spinner-tick == 3 ? 18px : spinner-tick == 4 ? 11px : spinner-tick == 5 ? 4px : spinner-tick == 6 ? 1px : 4px;
                            }
                        }
                        Text {
                            text: "Warming up the link — crossings unlock when ready…";
                            color: #22c55e;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text {
                        text: "Your pairing code — the other computer types this to pair:";
                        color: white;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: pairing-code == "" ? "starting…" : pairing-code;
                        color: #22c55e;
                        font-size: 32px;
                        font-weight: 800;
                        letter-spacing: 6px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Rotates every 30 minutes.";
                        color: #9ca3af;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text {
                        visible: driving-text != "";
                        text: driving-text;
                        color: #22c55e;
                        font-size: 13px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Button {
                        visible: !connected;
                        text: "Start background service";
                        clicked => { start-daemon(); }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    VerticalLayout {
                        spacing: 6px;
                        visible: pending-verification-code != "";
                        Text {
                            text: "OUTGOING — you are calling the other computer:";
                            color: #f59e0b;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Does " + (pending-peer-name == "" ? "the other computer" : pending-peer-name) + " show this same code?";
                            color: white;
                            font-size: 15px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            text: pending-verification-code;
                            color: #22c55e;
                            font-size: 32px;
                            font-weight: 800;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Compare with the code on the other computer, then confirm.";
                            color: #9ca3af;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            Button {
                                text: "Codes match — connect";
                                primary: true;
                                clicked => { confirm-pairing(); }
                            }
                            Button {
                                text: "Cancel";
                                clicked => { cancel-pairing(); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        // Both directions must be visible SIMULTANEOUSLY. This
                        // used to hide while our own outgoing code check was
                        // open — so when both computers pressed Connect, each
                        // side showed only its outgoing screen and neither
                        // could ever approve the other: a mutual-blindness
                        // deadlock with both users staring at unanswerable
                        // code screens until everything timed out.
                        visible: incoming-pairing != "";
                        Text {
                            text: "INCOMING — the other computer is calling you:";
                            color: #f59e0b;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: "A computer wants to connect: " + incoming-pairing;
                            color: white;
                            font-size: 15px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            visible: incoming-verification-code != "";
                            text: incoming-verification-code;
                            color: #22c55e;
                            font-size: 32px;
                            font-weight: 800;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            Button {
                                text: "Allow";
                                primary: true;
                                clicked => { approve-incoming-pairing(incoming-pairing-fingerprint); }
                            }
                            Button {
                                text: "Deny";
                                clicked => { reject-incoming-pairing(incoming-pairing-fingerprint); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        // Paired computers still ask before driving: a
                        // fresh link epoch from a trusted peer waits here
                        // (Allow once per link — retries and the dial-back
                        // on the same link never ask again).
                        visible: incoming-link != "";
                        Text {
                            text: "INCOMING link — a paired computer wants to drive:";
                            color: #6ee7b7;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: incoming-link + " is calling. Allow it to connect and drive this computer.";
                            color: white;
                            font-size: 15px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;
                            Button {
                                text: "Allow link";
                                primary: true;
                                clicked => { approve-incoming-link(incoming-link-fingerprint); }
                            }
                            Button {
                                text: "Deny";
                                clicked => { reject-incoming-link(incoming-link-fingerprint); }
                            }
                        }
                    }
                }
                }
            }

            Tab {
                title: "Devices";
                Flickable {
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text { text: "Find on my network"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: auto-discover ? "Nearby TheKVM computers appear below on their own. Tap one, then Connect — the other side still approves." : "Automatic listing is off (see Settings). Scan once, tap a device, then Connect — the other side still approves.";
                        color: #9ca3af;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Button { text: "Scan network"; clicked => { discover-lan(); } }
                        Text {
                            text: discovery-text;
                            color: #9ca3af;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        visible: discovered-labels.length > 0;
                        found := ComboBox {
                            model: root.discovered-labels;
                            current-index <=> root.discovered-index;
                        }
                        Button {
                            text: "Connect";
                            primary: true;
                            enabled: discovered-labels.length > 0 && !session-active;
                            clicked => { connect-discovered(root.discovered-index); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "Share this computer"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: "The other computer scans this code or pastes the invite text.";
                        color: #9ca3af;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        Rectangle {
                            width: 200px;
                            height: 200px;
                            background: white;
                            border-radius: 8px;
                            Image {
                                x: 8px; y: 8px;
                                width: 184px; height: 184px;
                                visible: invite-ready;
                                source: root.invite-qr;
                                image-fit: contain;
                            }
                            Text {
                                visible: !invite-ready;
                                text: "Start the app to generate the invite";
                                color: #6b7280;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            Text { text: "Invite text (copy from here):"; color: #9ca3af; font-size: 12px; }
                            shown := LineEdit {
                                text: root.invite-text;
                                read-only: true;
                                placeholder-text: "invite appears when the app is ready";
                            }
                        }
                    }
                    Text { text: "Connect from an invite"; color: white; font-size: 16px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 12px;
                        pasted := LineEdit {
                            text <=> root.invite-input;
                            placeholder-text: "paste thekvm:// invite";
                        }
                        Button {
                            text: "Connect";
                            primary: true;
                            enabled: pasted.text != "";
                            clicked => { pair-from-invite(pasted.text); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "Trusted computers"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: peer-list;
                        color: #9ca3af;
                        font-size: 11px;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        revoke := LineEdit {
                            text <=> root.revoke-fingerprint;
                            placeholder-text: "fingerprint to remove";
                        }
                        Button {
                            text: "Remove";
                            enabled: revoke.text != "";
                            clicked => { revoke-peer(revoke.text); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "Linked screens (edge control)"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: arrangement-text;
                        color: #9ca3af;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    // Screen icons with names: this computer and the linked
                    // peer, placed left/right as arranged. The exit edge is
                    // the facing edge — the outer edges do nothing.
                    HorizontalLayout {
                        spacing: 12px;
                        visible: peer-on-right;
                        Rectangle {
                            width: 130px;
                            height: 92px;
                            background: #14532d;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: #22c55e;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                Text { text: "THIS PC"; color: #bbf7d0; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: device-name == "" ? "…" : device-name; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                            }
                        }
                        Text { text: "▶"; color: #22c55e; font-size: 20px; font-weight: 800; vertical-alignment: center; }
                        Rectangle {
                            width: 130px;
                            height: 92px;
                            background: #1c1917;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: #57534e;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                Text { text: "LINKED"; color: #d6d3d1; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: linked-peer-name == "" ? "…" : linked-peer-name; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        visible: !peer-on-right;
                        Rectangle {
                            width: 130px;
                            height: 92px;
                            background: #1c1917;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: #57534e;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                Text { text: "LINKED"; color: #d6d3d1; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: linked-peer-name == "" ? "…" : linked-peer-name; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                            }
                        }
                        Text { text: "◀"; color: #22c55e; font-size: 20px; font-weight: 800; vertical-alignment: center; }
                        Rectangle {
                            width: 130px;
                            height: 92px;
                            background: #14532d;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: #22c55e;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                Text { text: "THIS PC"; color: #bbf7d0; font-size: 11px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: device-name == "" ? "…" : device-name; color: white; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Button {
                            text: "Put on left";
                            enabled: linked-peer-name != "";
                            clicked => { place-peer-left(); }
                        }
                        Button {
                            text: "Put on right";
                            enabled: linked-peer-name != "";
                            clicked => { place-peer-right(); }
                        }
                    }
                    Text {
                        text: "Place the linked screen where it physically sits. The crossing edge is the facing edge between the icons.";
                        color: #9ca3af;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Text { text: "Crossing edges (two-computer link)"; color: white; font-size: 14px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 12px;
                        Button {
                            text: "Single edge";
                            enabled: linked-peer-name != "";
                            clicked => { set-edge-mode(0); }
                        }
                        Button {
                            text: "Double inverse";
                            enabled: linked-peer-name != "";
                            clicked => { set-edge-mode(1); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Button {
                            text: "Double fixed left";
                            enabled: linked-peer-name != "";
                            clicked => { set-edge-mode(2); }
                        }
                        Button {
                            text: "Double fixed right";
                            enabled: linked-peer-name != "";
                            clicked => { set-edge-mode(3); }
                        }
                    }
                    Text {
                        text: edge-mode-index == 0 ? "Single edge: only the facing edge crosses." : edge-mode-index == 1 ? "Double inverse: exit left to enter at the right edge and back — either edge returns once settled." : edge-mode-index == 2 ? "Double fixed left: every arrival (and return) uses the left edge, no matter the exit edge." : "Double fixed right: every arrival (and return) uses the right edge, no matter the exit edge.";
                        color: #9ca3af;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Text {
                        visible: driving-text != "";
                        text: driving-text;
                        color: #22c55e;
                        font-size: 13px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                }
                }
            }

            Tab {
                title: "Settings";
                Flickable {
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text { text: "Computer name"; color: white; font-size: 16px; font-weight: 700; }
                    Text {
                        text: "The name nearby computers see.";
                        color: #9ca3af;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        name := LineEdit {
                            text <=> root.device-name;
                            placeholder-text: "friendly name";
                        }
                        Button {
                            text: "Save";
                            enabled: name.text != "";
                            clicked => { apply-config(lock-screen-control, mode-index, name.text, auto-connect-address, clipboard-enabled, root.clipboard-max-mb); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Control login and lock screens";
                            color: #d1d5db;
                            vertical-alignment: center;
                        }
                        Switch {
                            checked <=> root.lock-screen-control;
                            toggled => { apply-config(root.lock-screen-control, root.mode-index, root.device-name, root.auto-connect-address, root.clipboard-enabled, root.clipboard-max-mb); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Sync text clipboard";
                            color: #d1d5db;
                            vertical-alignment: center;
                        }
                        Switch {
                            checked <=> root.clipboard-enabled;
                            toggled => { apply-config(root.lock-screen-control, root.mode-index, root.device-name, root.auto-connect-address, root.clipboard-enabled, clipboard-max.text); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Reverse scroll direction on the other computer";
                            color: #d1d5db;
                            vertical-alignment: center;
                        }
                        Switch {
                            checked <=> root.reverse-scroll;
                            toggled => { root.set-reverse-scroll(root.reverse-scroll); }
                        }
                    }
                    Text {
                        text: "When on, scrolling while driving the peer goes the opposite way. Local scrolling is unchanged.";
                        color: #9ca3af;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Find nearby computers automatically";
                            color: #d1d5db;
                            vertical-alignment: center;
                        }
                        Switch {
                            checked <=> root.auto-discover;
                            toggled => { root.apply-auto-discover(root.auto-discover); }
                        }
                    }
                    Text {
                        text: "When on, other TheKVM computers on this network list themselves under Devices. Listing only — nothing connects without a tap and the other side's approval.";
                        color: #9ca3af;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Start TheKVM when I log in";
                            color: #d1d5db;
                            vertical-alignment: center;
                        }
                        Switch {
                            enabled: root.autostart-supported && !root.autostart-busy;
                            checked <=> root.autostart-enabled;
                            toggled => { root.apply-autostart(root.autostart-enabled); }
                        }
                    }
                    Text {
                        text: root.autostart-note;
                        color: #9ca3af;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Reconnect to the last computer at startup";
                            color: #d1d5db;
                            vertical-alignment: center;
                        }
                        Switch {
                            enabled: root.auto-connect-known && !root.auto-connect-busy;
                            checked <=> root.auto-connect-on-start;
                            toggled => { root.apply-auto-connect(root.auto-connect-on-start); }
                        }
                    }
                    Text {
                        text: root.auto-connect-note;
                        color: #9ca3af;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Largest paste to sync (MB, 1-16)";
                            color: #d1d5db;
                            vertical-alignment: center;
                        }
                        clipboard-max := LineEdit {
                            text <=> root.clipboard-max-mb;
                            placeholder-text: "2";
                        }
                        Button {
                            text: "Save";
                            clicked => { apply-config(root.lock-screen-control, root.mode-index, root.device-name, root.auto-connect-address, root.clipboard-enabled, clipboard-max.text); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text {
                        text: "Reconnect at startup (optional)";
                        color: white;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        startup := LineEdit {
                            text <=> root.auto-connect-address;
                            placeholder-text: "computer IP or hostname:42110";
                        }
                        Button {
                            text: "Save";
                            clicked => { apply-config(lock-screen-control, mode-index, device-name, startup.text, clipboard-enabled, root.clipboard-max-mb); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "Screen layout file"; color: white; font-size: 16px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 12px;
                        path := LineEdit {
                            text <=> root.layout-path;
                            placeholder-text: "path to layout.json";
                        }
                        Button {
                            text: "Import";
                            enabled: path.text != "";
                            clicked => { import-layout(path.text); }
                        }
                    }
                    Rectangle { height: 1px; background: #262626; }
                    Text { text: "This computer's fingerprint:"; color: #9ca3af; font-size: 12px; }
                    Text { text: fingerprint; color: #ef4444; font-size: 12px; }
                    Rectangle { height: 1px; background: #262626; }
                    Button {
                        text: "Open log folder";
                        clicked => { open-log-folder(); }
                    }
                }
                }
            }
        }
    }
}
