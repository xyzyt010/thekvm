import { Button, LineEdit, Switch, ProgressIndicator } from "std-widgets.slint";

// TheKVM Windows installer wizard: no console windows, step-by-step pages,
// live progress, and the project logo throughout.
export component SetupWindow inherits Window {
    title: "TheKVM Setup";
    min-width: 600px;
    min-height: 520px;
    background: #0a0a0a;

    in property <string> version;
    in property <bool> elevated;
    in-out property <int> page: 0; // 0 = options, 1 = progress, 2 = finished
    in-out property <string> device-name;
    in-out property <bool> lock-screen: false;
    in-out property <bool> uninstall-mode: false;
    in-out property <string> log-text: "";
    in-out property <float> progress: 0.0;
    in-out property <bool> running: false;
    in-out property <bool> finished-ok: false;
    in-out property <string> finished-text: "";

    callback install(string /* device-name */, bool /* lock-screen */);
    callback uninstall();
    callback show-uninstall();
    callback show-install();
    callback launch-app();
    callback close-window();

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 16px;
            Image {
                source: @image-url("../assets/logo.png");
                width: 96px;
                height: 96px;
                image-fit: contain;
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: uninstall-mode ? "Uninstall TheKVM" : "Install TheKVM";
                    font-size: 26px;
                    font-weight: 800;
                    color: white;
                    vertical-alignment: center;
                }
                Text {
                    text: "Version " + version + " · cross-OS software KVM over QUIC";
                    font-size: 12px;
                    color: #9ca3af;
                }
                Text {
                    text: page == 0 ? "Step 1 of 2 — Options" : page == 1 ? "Step 2 of 2 — Installing" : "Finished";
                    font-size: 12px;
                    color: #22c55e;
                }
            }
        }

        Rectangle { height: 1px; background: #262626; }

        // ---- page 0: options ----
        VerticalLayout {
            spacing: 10px;
            visible: page == 0 && !uninstall-mode;
            Text { text: "This machine"; color: white; font-size: 16px; font-weight: 700; }
            Text {
                text: "The name shown to nearby machines during discovery and pairing.";
                color: #9ca3af;
                font-size: 12px;
                wrap: word-wrap;
            }
            name-edit := LineEdit {
                text <=> root.device-name;
                placeholder-text: "friendly device name (optional)";
                enabled: !running;
            }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: "Allow lock-screen control (privileged service)";
                    color: #d1d5db;
                    vertical-alignment: center;
                }
                Switch {
                    checked <=> root.lock-screen;
                    enabled: !running;
                }
            }
            Text {
                visible: !elevated;
                text: "Windows will ask for administrator approval once when installation starts.";
                color: #facc15;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                Button {
                    text: "Uninstall…";
                    enabled: !running;
                    clicked => { show-uninstall(); }
                }
                Button {
                    text: "Install";
                    primary: true;
                    enabled: !running;
                    clicked => { install(name-edit.text, root.lock-screen); }
                }
            }
        }

        // ---- page 0: uninstall confirmation ----
        VerticalLayout {
            spacing: 10px;
            visible: page == 0 && uninstall-mode;
            Text {
                text: "Removes the service, firewall rule, shortcuts, and binaries. Paired-device state in ProgramData\\TheKVM is kept.";
                color: #9ca3af;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                Button {
                    text: "Back";
                    enabled: !running;
                    clicked => { show-install(); }
                }
                Button {
                    text: "Uninstall";
                    primary: true;
                    enabled: !running;
                    clicked => { uninstall(); }
                }
            }
        }

        // ---- page 1: progress ----
        VerticalLayout {
            spacing: 10px;
            visible: page == 1;
            ProgressIndicator { progress: root.progress; }
            Rectangle {
                background: #111111;
                border-radius: 6px;
                VerticalLayout {
                    padding: 8px;
                    Text {
                        text: log-text == "" ? "Starting…" : log-text;
                        color: #d1d5db;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ---- page 2: finished ----
        VerticalLayout {
            spacing: 10px;
            visible: page == 2;
            Text {
                text: finished-text;
                color: finished-ok ? #22c55e : #ef4444;
                font-size: 14px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: end;
                Button {
                    text: "Launch TheKVM";
                    visible: finished-ok && !uninstall-mode;
                    primary: true;
                    clicked => { launch-app(); }
                }
                Button {
                    text: "Close";
                    clicked => { close-window(); }
                }
            }
        }
    }
}
